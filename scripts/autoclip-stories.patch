+def test_single_story_and_cancel_resume(client, monkeypatch, spec, script):
+    first, second = project(client, spec), project(client, spec)
+    entered = threading.Event()
+
+    async def blocked(_spec, cancelled, attempt, *_args):
+        attempt(1)
+        entered.set()
+        while not cancelled():
+            await asyncio.sleep(0.01)
+        raise Cancelled
+
+    monkeypatch.setattr(writer, "write_story", blocked)
+    post(client, first + "/tasks", {"kind": "roteiro"}, expected=202)
+    assert entered.wait(3)
+    post(client, second + "/tasks", {"kind": "roteiro"}, expected=409)
+    post(client, first + "/cancel", expected=204)
+    wait_for(client, first, "cancelado")
+
+    async def success(*_args):
+        return script
+
+    monkeypatch.setattr(writer, "write_story", success)
+    post(client, first + "/resume", expected=202)
+    assert wait_for(client, first, "rascunho")["script"]["title"] == script.title
+
+
+def test_interrupted_state_survives_restart(monkeypatch, spec, script):
+    monkeypatch.setenv("AUTOCLIP_NO_WORKER", "1")
