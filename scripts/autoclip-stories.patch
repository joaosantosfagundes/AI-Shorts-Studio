@@ -0,0 +1,148 @@
+from __future__ import annotations
+
+import asyncio
+import logging
+import threading
+
+from ..pipeline import Cancelled, ffmpeg
+from . import narration, render, writer
+from .schema import Script, StoryError, StorySpec, StoryTask
+from .store import Busy, StoryStore
+
+log = logging.getLogger(__name__)
+
+
+class StoryRunner:
+    def __init__(self, store: StoryStore, workstation: asyncio.Lock) -> None:
+        self.store = store
+        self.workstation = workstation
+        self.job: asyncio.Task | None = None
+        self.project: str | None = None
+        self.cancelled = threading.Event()
+        self.stopping = False
+
+    async def start(self, project: str, operation: StoryTask) -> dict:
+        if self.job is not None or self.stopping:
+            raise Busy("Aguarde ou cancele a história que está sendo produzida.")
+        row = await asyncio.to_thread(self.store.begin, project, operation)
+        self.project = project
+        self.cancelled.clear()
+        self.job = asyncio.create_task(
+            self._produce(row, operation), name=f"studio-story-{project}"
+        )
+        return row
+
+    def cancel(self, project: str) -> None:
+        if self.job is None or self.project != project:
+            raise Busy("Esta história está sem uma tarefa em andamento.")
+        self.cancelled.set()
+
+    async def stop(self) -> None:
+        self.stopping = True
+        self.cancelled.set()
+        if self.job is not None:
+            await self.job
+
+    async def _acquire(self) -> None:
+        while True:
+            render.check_cancelled(self.cancelled.is_set)
+            try:
+                await asyncio.wait_for(self.workstation.acquire(), timeout=0.25)
+                return
+            except TimeoutError:
+                continue
+
+    async def _produce(self, row: dict, operation: StoryTask) -> None:
+        project, run = row["id"], row["run_id"]
+        cancelled = self.cancelled.is_set
+
+        def progress(stage: str, done: int, total: int, detail: str) -> None:
+            self.store.progress(project, run, stage, done, total, detail)
+
+        try:
+            await self._acquire()
+            try:
+                render.check_cancelled(cancelled)
+                spec = StorySpec.model_validate(row["spec"])
+                script = Script.model_validate(row["script"]) if row["script"] else None
+                if operation.kind in {"roteiro", "cena"}:
+                    generated = await writer.write_story(
+                        spec,
+                        cancelled,
+                        lambda attempt: progress(
+                            "roteiro", 0, 0, f"Ollama · tentativa {attempt} de 2"
+                        ),
+                        script,
+                        operation.scene,
+                    )
+                    render.check_cancelled(cancelled)
+                    self.store.end(project, run, "rascunho", script=generated)
+                elif script is not None:
+                    await asyncio.to_thread(
+                        self._produce_media, row, spec, script, operation, progress
+                    )
+            finally:
+                self.workstation.release()
+        except Cancelled:
+            status = "interrompido" if self.stopping else "cancelado"
+            self.store.end(project, run, status)
+        except (StoryError, ffmpeg.FFmpegError, OSError) as error:
+            self.store.end(project, run, "falhou", error=str(error)[:1500])
+        except Exception:
+            log.exception("Falha interna na produção de história %s.", project)
+            self.store.end(
+                project, run, "falhou", error="Erro interno. Consulte o terminal do Studio."
+            )
+        finally:
+            self.project = None
+            self.job = None
+
+    def _produce_media(
+        self,
+        row: dict,
+        spec: StorySpec,
+        script: Script,
+        operation: StoryTask,
+        progress: render.Report,
+    ) -> None:
+        project, run = row["id"], row["run_id"]
+        cancelled = self.cancelled.is_set
+        voice = narration.available_voices().get(spec.voice)
+        if voice is None:
+            progress("narracao", 0, 0, "Aguardando uma voz local")
+            raise StoryError(
+                "Selecione uma voz pt-BR instalada. Use scripts/preparar-voz-historias.ps1."
+            )
+        output = self.store.output(project, run)
+        output.mkdir(parents=True)
+        cache = self.store.home / "cache"
+        if operation.kind == "audio":
+            narration.make_narration(
+                script,
+                spec,
+                voice,
+                cache / "audio",
+                output,
+                cancelled,
+                lambda done, total, message: progress("narracao", done, total, message),
+                refresh=operation.refresh,
+            )
+            render.check_cancelled(cancelled)
+            self.store.end(project, run, "rascunho", audio=True)
+            return
+
+        result = render.render_story(script, spec, voice, cache, output, cancelled, progress)
+        render.check_cancelled(cancelled)
+        self.store.end(
+            project,
+            run,
+            "finalizado",
+            audio=True,
+            exported=(
+                script.title,
+                result.width or 0,
+                result.height or 0,
+                result.duration_s,
+                (output / "historia.mp4").stat().st_size,
+            ),
+        )
