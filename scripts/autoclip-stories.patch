+async def test_validates_ollama_json_and_retries_once(monkeypatch, spec, script):
+    prompts, attempts = [], []
+    bad = script.model_dump()
+    bad["scenes"][0]["characters"] = ["desconhecido"]
+
+    async def generate(_url, payload, _cancelled):
+        prompts.append(payload)
+        return json.dumps(bad) if len(prompts) == 1 else script.model_dump_json()
+
+    monkeypatch.setattr(writer, "_generation", generate)
+    result = await writer.write_story(spec, lambda: False, attempts.append)
+    assert result == script
+    assert attempts == [1, 2]
+    assert prompts[0]["format"]["title"] == "Script"
+    assert prompts[0]["keep_alive"] == 0 and prompts[0]["think"] is False
+    assert "Campo inválido" in prompts[1]["prompt"]
+    with pytest.raises(ValidationError, match="personagem"):
+        Script.model_validate(bad)
+
