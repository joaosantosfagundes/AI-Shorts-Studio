+def test_asset_consistency_blinks_and_pose(tmp_path, script):
+    first, second = script.characters
+    calm = art.actor(tmp_path, first, "calmo")
+    curious = art.actor(tmp_path, first, "curioso")
+    assert calm.body.tobytes() == curious.body.tobytes()
+    assert calm.head.tobytes() != curious.head.tobytes()
+    assert calm.sprite().tobytes() != calm.sprite(eyes_closed=True).tobytes()
+    assert calm.sprite().tobytes() != calm.sprite(wave=-28, nod=10).tobytes()
+    previous_reference = art.reference(tmp_path, second)
+    assert art.reference(tmp_path, first) != art.reference(
+        tmp_path, first.model_copy(update={"color": "#e8bf78"})
+    )
+    assert art.reference(tmp_path, second) == previous_reference
+
