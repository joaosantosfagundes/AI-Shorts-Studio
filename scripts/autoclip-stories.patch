+@pytest.fixture
+def client(monkeypatch):
+    monkeypatch.setenv("AUTOCLIP_NO_WORKER", "1")
+    monkeypatch.setenv("AI_SHORTS_INSTAGRAM_PUBLISH", "0")
+    with TestClient(create_app(), base_url=ORIGIN, client=("127.0.0.1", 50080)) as opened:
+        yield opened
+
