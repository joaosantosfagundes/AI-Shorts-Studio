+async def test_regenerating_scene_preserves_cast_and_other_scenes(monkeypatch, spec, script):
+    changed = script.scenes[1].model_copy(update={"id": "s9", "narration": "Nina ouviu o chamado."})
+
+    async def generate(_url, payload, _cancelled):
+        assert payload["format"]["title"] == "Scene"
+        return changed.model_dump_json()
+
+    monkeypatch.setattr(writer, "_generation", generate)
+    result = await writer.write_story(spec, lambda: False, lambda _: None, script, "s2")
+    assert result.characters == script.characters
+    assert result.scenes[0] == script.scenes[0] and result.scenes[2] == script.scenes[2]
+    assert result.scenes[1].id == "s2" and result.scenes[1].narration == changed.narration
