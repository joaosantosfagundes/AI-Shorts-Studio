+from autoclip.stories.store import StoryStore
+from fastapi.testclient import TestClient
+from PIL import Image, ImageChops
+from pydantic import ValidationError
+
+ORIGIN = "http://127.0.0.1:8000"
+LOCAL = {"Origin": ORIGIN, "X-Studio-Local": "1"}
+PREFIX = "/api/stories"
+VOICE = "pt_BR-cadu-medium"
+
+
+@pytest.fixture
+def spec() -> StorySpec:
+    return StorySpec(idea="Uma coruja ajuda um robô a devolver uma estrela.", voice=VOICE)
