+@pytest.fixture
+def fake_piper(tmp_path, monkeypatch):
+    voice = tmp_path / f"{VOICE}.onnx"
+    voice.write_bytes(b"only used as a cache key")
+    voice.with_suffix(".onnx.json").write_text("{}", encoding="utf-8")
+    monkeypatch.setattr(narration, "available_voices", lambda: {VOICE: voice})
+    calls = []
+
+    def synth(model, speed, fragments, cancelled, progress):
+        assert model == voice
+        if not fragments:
+            return
+        calls.append((speed, list(fragments)))
+        for i, filename in enumerate(fragments.values(), start=1):
+            assert not cancelled()
+            filename.parent.mkdir(parents=True, exist_ok=True)
+            with wave.open(str(filename), "wb") as track:
+                track.setparams((1, 2, 16_000, 0, "NONE", "not compressed"))
+                track.writeframes(b"\x0a\x0b" * 8_000)
+            progress(i)
+
+    monkeypatch.setattr(narration, "synthesize", synth)
+    return voice, calls
+
+
+def post(client, url: str, data=None, expected=200):
+    response = client.post(url, json=data, headers=LOCAL)
+    assert response.status_code == expected, response.text
+    return response.json() if expected != 204 else None
+
+
+def project(client, spec, script=None):
+    record = post(client, PREFIX, spec.model_dump(), expected=201)
+    url = PREFIX + "/" + record["id"]
+    if script is not None:
+        response = client.put(
+            url, json={"script": script.model_dump(), "spec": spec.model_dump()}, headers=LOCAL
+        )
+        assert response.status_code == 200, response.text
+    return url
+
+
+def wait_for(client, url, status, timeout=40):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        row = client.get(url).json()
+        if row["status"] != "gerando":
+            assert row["status"] == status, row
+            return row
+        time.sleep(0.04)
+    pytest.fail("A tarefa de história não deixou a fila.")
+
