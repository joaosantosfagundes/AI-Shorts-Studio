+++ b/backend/autoclip/stories/store.py
@@ -0,0 +1,260 @@
+"""Durable local project, task and immutable export records."""
+
+from __future__ import annotations
+
+import json
+import re
+import sqlite3
+from collections.abc import Iterator
+from contextlib import closing, contextmanager
+from datetime import UTC, datetime
+from pathlib import Path
+
+from .. import db, paths
+from ..db.models import new_id
+from .schema import Script, StoryError, StorySpec, StoryTask
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS projects (
+    id TEXT PRIMARY KEY,
+    spec TEXT NOT NULL,
+    script TEXT,
+    approved INTEGER NOT NULL DEFAULT 0,
+    status TEXT NOT NULL DEFAULT 'rascunho',
+    stage TEXT,
+    completed INTEGER NOT NULL DEFAULT 0,
+    total INTEGER NOT NULL DEFAULT 0,
+    detail TEXT NOT NULL DEFAULT '',
+    error TEXT,
+    task TEXT,
+    run_id TEXT,
+    audio_id TEXT,
+    export_id TEXT,
+    updated_at TEXT NOT NULL
+);
+CREATE UNIQUE INDEX IF NOT EXISTS one_story_generation ON projects(status) WHERE status='gerando';
+CREATE TABLE IF NOT EXISTS exports (
+    id TEXT PRIMARY KEY,
+    project_id TEXT NOT NULL REFERENCES projects(id),
+    title TEXT NOT NULL,
+    width INTEGER NOT NULL,
+    height INTEGER NOT NULL,
+    duration REAL NOT NULL,
+    size_bytes INTEGER NOT NULL,
+    created_at TEXT NOT NULL
+);
+"""
+ID = re.compile(r"[0-9a-f]{16}")
+
+
+class Busy(StoryError):
+    """This project or another story is already being processed."""
+
+
+def _now() -> str:
+    return datetime.now(UTC).isoformat(timespec="milliseconds")
+
+
+class StoryStore:
+    def __init__(self, home: Path | None = None) -> None:
+        self.home = (home or paths.root()) / "stories"
+        self.database = self.home / "historias.sqlite3"
+
+    @contextmanager
+    def _connect(self, *, write: bool = False) -> Iterator[sqlite3.Connection]:
+        with closing(db.connect(self.database)) as connection, connection:
+            if write:
+                connection.execute("BEGIN IMMEDIATE")
+            yield connection
+
+    def initialize(self) -> None:
+        with self._connect() as connection:
+            connection.executescript(SCHEMA)
+
+    def recover(self) -> None:
+        self.initialize()
+        with self._connect(write=True) as connection:
+            connection.execute(
+                "UPDATE projects SET status='interrompido', error=? WHERE status='gerando'",
+                ("A produção foi interrompida. Retome para reaproveitar os arquivos preparados.",),
+            )
+
+    @staticmethod
+    def _row(connection: sqlite3.Connection, project: str) -> sqlite3.Row:
+        row = connection.execute("SELECT * FROM projects WHERE id=?", (project,)).fetchone()
+        if row is None:
+            raise KeyError(project)
+        return row
+
+    @staticmethod
+    def _read(connection: sqlite3.Connection, row: sqlite3.Row) -> dict:
+        exported = connection.execute(
+            "SELECT * FROM exports WHERE id=?", (row["export_id"],)
+        ).fetchone()
+        info = dict(row)
+        for field in ("spec", "script", "task"):
+            info[field] = json.loads(info[field]) if info[field] else None
+        info["approved"] = bool(info["approved"])
+        info["export"] = dict(exported) if exported else None
+        return info
+
+    def get(self, project: str) -> dict:
+        with self._connect() as connection:
+            return self._read(connection, self._row(connection, project))
+
+    def projects(self) -> list[dict]:
+        with self._connect() as connection:
+            rows = connection.execute("SELECT * FROM projects ORDER BY updated_at DESC")
+            return [
+                {
+                    "id": row["id"],
+                    "status": row["status"],
+                    "updated_at": row["updated_at"],
+                    "title": json.loads(row["script"])["title"]
+                    if row["script"]
+                    else json.loads(row["spec"])["idea"],
+                }
+                for row in rows
+            ]
+
+    def create(self, spec: StorySpec) -> dict:
+        project = new_id()
+        with self._connect(write=True) as connection:
+            connection.execute(
+                "INSERT INTO projects (id,spec,updated_at) VALUES (?,?,?)",
+                (project, spec.model_dump_json(), _now()),
+            )
+        return self.get(project)
+
+    def save(self, project: str, spec: StorySpec, script: Script) -> dict:
+        if script.genre != spec.genre:
+            raise StoryError("O gênero do roteiro deve ser o mesmo do projeto.")
+        with self._connect(write=True) as connection:
+            before = self._row(connection, project)
+            if before["status"] == "gerando":
+                raise Busy("Aguarde ou cancele a produção para editar este projeto.")
+            new_spec, new_script = spec.model_dump_json(), script.model_dump_json()
+            if before["spec"] != new_spec or before["script"] != new_script:
+                connection.execute(
+                    """UPDATE projects SET spec=?, script=?, approved=0, status='rascunho',
+                       stage=NULL, completed=0, total=0, detail='', error=NULL, audio_id=NULL,
+                       task=NULL, run_id=NULL, updated_at=? WHERE id=?""",
+                    (new_spec, new_script, _now(), project),
+                )
+        return self.get(project)
+
+    def approve(self, project: str) -> dict:
+        with self._connect(write=True) as connection:
+            row = self._row(connection, project)
+            if row["status"] == "gerando":
+                raise Busy("Aguarde a produção atual antes de aprovar.")
+            if not row["script"]:
+                raise StoryError("Gere e revise um roteiro antes de aprová-lo.")
+            connection.execute(
+                "UPDATE projects SET approved=1,updated_at=? WHERE id=?", (_now(), project)
+            )
+        return self.get(project)
+
+    def begin(self, project: str, task: StoryTask) -> dict:
+        try:
+            with self._connect(write=True) as connection:
+                row = self._row(connection, project)
+                if row["status"] == "gerando":
+                    raise Busy("Já existe uma produção para esta história.")
+                if task.kind != "roteiro" and not row["script"]:
+                    raise StoryError("Gere um roteiro para continuar.")
+                if task.kind == "cena" and task.scene not in {
+                    s["id"] for s in json.loads(row["script"])["scenes"]
+                }:
+                    raise StoryError("A cena não está mais neste roteiro.")
+                if task.kind == "render" and not row["approved"]:
+                    raise StoryError("Aprove o roteiro antes de gerar o vídeo.")
+                connection.execute(
+                    """UPDATE projects SET status='gerando', stage='aguardando', completed=0,
+                       total=0, detail='', error=NULL, task=?, run_id=?, updated_at=? WHERE id=?""",
+                    (task.model_dump_json(), new_id(), _now(), project),
+                )
+                return self._read(connection, self._row(connection, project))
+        except sqlite3.IntegrityError:
+            raise Busy(
+                "Já existe uma história sendo produzida. Aguarde ou cancele a tarefa atual."
+            ) from None
+
+    def progress(
+        self, project: str, run: str, stage: str, done: int, total: int, detail: str
+    ) -> None:
+        with self._connect(write=True) as connection:
+            connection.execute(
+                """UPDATE projects SET stage=?,completed=?,total=?,detail=?
+                   WHERE id=? AND run_id=? AND status='gerando'""",
+                (stage, done, total, detail, project, run),
+            )
+
+    def end(
+        self,
+        project: str,
+        run: str,
+        status: str,
+        *,
+        script: Script | None = None,
+        audio: bool = False,
+        exported: tuple[str, int, int, float, int] | None = None,
+        error: str | None = None,
+    ) -> None:
+        with self._connect(write=True) as connection:
+            row = self._row(connection, project)
+            if row["run_id"] != run or row["status"] != "gerando":
+                return
+            if exported:
+                connection.execute(
+                    "INSERT INTO exports VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+                    (run, project, *exported, _now()),
+                )
+            connection.execute(
+                """UPDATE projects SET status=?, updated_at=?, error=?, stage=?, detail='',
+                   script=?, approved=?, audio_id=?, export_id=? WHERE id=?""",
+                (
+                    status,
+                    _now(),
+                    error,
+                    "finalizado" if exported else row["stage"],
+                    script.model_dump_json() if script is not None else row["script"],
+                    0 if script is not None else row["approved"],
+                    None if script is not None else run if audio else row["audio_id"],
+                    run if exported else row["export_id"],
+                    project,
+                ),
+            )
+
+    def output(self, project: str, version: str) -> Path:
+        if not ID.fullmatch(project) or not ID.fullmatch(version):
+            raise KeyError(project)
+        return self.home / "projects" / project / version
+
+    def export_path(self, row: sqlite3.Row | dict) -> Path | None:
+        candidate = (self.output(row["project_id"], row["id"]) / "historia.mp4").resolve()
+        return (
+            candidate
+            if candidate.is_relative_to(self.home.resolve()) and candidate.is_file()
+            else None
+        )
+
+    def exports(self, preferred: str | None = None) -> list[dict]:
+        if not self.database.is_file():
+            return []
+        with self._connect() as connection:
+            return [
+                dict(row)
+                for row in connection.execute(
+                    "SELECT * FROM exports ORDER BY id=? DESC,created_at DESC LIMIT 100",
+                    (preferred,),
+                )
+                if self.export_path(row) is not None
+            ]
+
+    def get_export(self, version: str) -> dict | None:
+        if not self.database.is_file():
+            return None
+        with self._connect() as connection:
+            row = connection.execute("SELECT * FROM exports WHERE id=?", (version,)).fetchone()
+            return dict(row) if row else None
