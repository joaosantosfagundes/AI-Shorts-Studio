@@ -0,0 +1,110 @@
+from __future__ import annotations
+
+from typing import Annotated, Literal
+
+from pydantic import BaseModel, ConfigDict, Field, StringConstraints, model_validator
+
+MODELS = ("qwen3:4b-instruct", "qwen2.5:7b")
+WIDTH, HEIGHT = 720, 1280
+FPS = 12  # Draw on twos. Exports use 24 fps for browser and Reel compatibility.
+
+Genre = Literal["misterio", "terror", "suspense", "humor", "reviravolta", "aventura"]
+Species = Literal["cachorro", "gato", "coelho", "coruja", "robo"]
+Setting = Literal["quarto", "bosque", "jardim", "oficina", "rua"]
+Mood = Literal["calmo", "feliz", "surpreso", "assustado", "curioso", "triste"]
+Motion = Literal["respirar", "acenar", "balancar_cabeca", "entrar", "sair", "pular"]
+Prop = Literal["nenhum", "estrela", "chave", "bilhete", "lanterna", "livro", "semente", "bola"]
+Reference = Annotated[str, StringConstraints(pattern=r"^[a-z][a-z0-9_]{0,15}$")]
+Title = Annotated[str, StringConstraints(strip_whitespace=True, min_length=1, max_length=100)]
+Text = Annotated[str, StringConstraints(strip_whitespace=True, min_length=1, max_length=400)]
+
+
+class StoryData(BaseModel):
+    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)
+
+
+class StorySpec(StoryData):
+    idea: Annotated[str, StringConstraints(min_length=4, max_length=1200)]
+    genre: Genre = "misterio"
+    seconds: Literal[15, 30, 45, 60] = 15
+    model: Literal["qwen3:4b-instruct", "qwen2.5:7b"] = MODELS[0]
+    style: Literal["cartoon-2d"] = "cartoon-2d"
+    language: Literal["pt-BR"] = "pt-BR"
+    voice: str = Field(default="", pattern=r"^(pt_BR-[A-Za-z0-9_-]{1,75})?$")
+    speed: float = Field(default=1, ge=0.8, le=1.25)
+
+
+class Character(StoryData):
+    id: Reference
+    name: Title
+    species: Species
+    visual: Title
+    color: str = Field(pattern=r"^#[0-9a-fA-F]{6}$")
+    accessory: Literal["nenhum", "lenco", "gravata", "oculos", "broche"] = "nenhum"
+
+
+class Dialogue(StoryData):
+    speaker: Reference
+    text: Text
+
+
+class Scene(StoryData):
+    id: Reference
+    title: Title
+    setting: Setting
+    light: Literal["dia", "entardecer", "noite"]
+    characters: list[Reference] = Field(min_length=1, max_length=2)
+    narration: Text
+    dialogues: list[Dialogue] = Field(default_factory=list, max_length=2)
+    action: Text
+    mood: Mood
+    motion: Motion
+    prop: Prop = "nenhum"
+    shot: Literal["medio", "proximo"] = "medio"
+    seconds: float = Field(ge=1, le=30)
+
+    def validate_cast(self, cast: set[str]) -> None:
+        visible = set(self.characters)
+        if len(visible) != len(self.characters) or not visible.issubset(cast):
+            raise ValueError("Cada personagem da cena deve aparecer uma vez na ficha da história.")
+        if any(line.speaker not in visible for line in self.dialogues):
+            raise ValueError("A fala precisa pertencer a um personagem presente na cena.")
+
+
+class Script(StoryData):
+    title: Title
+    synopsis: Text
+    genre: Genre
+    setting: Title
+    characters: list[Character] = Field(min_length=1, max_length=4)
+    scenes: list[Scene] = Field(min_length=3, max_length=8)
+    ending: Text
+
+    @model_validator(mode="after")
+    def validate_references(self) -> Script:
+        cast = {character.id for character in self.characters}
+        if len(cast) != len(self.characters):
+            raise ValueError("Os identificadores dos personagens precisam ser únicos.")
+        if len({scene.id for scene in self.scenes}) != len(self.scenes):
+            raise ValueError("Os identificadores das cenas precisam ser únicos.")
+        for scene in self.scenes:
+            scene.validate_cast(cast)
+        return self
+
+
+class StoryTask(StoryData):
+    kind: Literal["roteiro", "cena", "audio", "render"]
+    scene: Reference | None = None
+    refresh: bool = False
+
+    @model_validator(mode="after")
+    def validate_operation(self) -> StoryTask:
+        if (self.scene is not None) != (self.kind == "cena"):
+            raise ValueError("Informe o identificador apenas ao regenerar uma cena.")
+        if self.refresh and self.kind != "audio":
+            raise ValueError("A regeneração do áudio exige uma tarefa de narração.")
+        return self
+
+
+class StoryError(RuntimeError):
+    """A production failure with a message suitable for the local editor."""
