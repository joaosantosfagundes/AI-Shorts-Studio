+def test_missing_voice_is_actionable_and_local_only(client, monkeypatch, spec, script):
+    monkeypatch.setattr(narration, "available_voices", lambda: {})
+    url = project(client, spec, script)
+    assert client.post(url + "/approve").status_code == 403
+    post(client, url + "/approve")
+    post(client, url + "/tasks", {"kind": "render"}, expected=202)
+    failed = wait_for(client, url, "falhou")
+    assert failed["export"] is None and failed["stage"] == "narracao"
+    assert "preparar-voz-historias.ps1" in failed["error"]
