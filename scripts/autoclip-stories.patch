+def test_narration_uses_pcm_times_and_reuses_audio(tmp_path, script, spec, fake_piper):
+    voice, calls = fake_piper
+    track = tmp_path / "track"
+    track.mkdir()
+    args = (script, spec, voice, tmp_path / "cache", track, lambda: False, lambda *_: None)
+    first = narration.make_narration(*args)
+    second = narration.make_narration(*args)
+    assert first == second
+    assert len(calls) == 1
+    assert first.boundaries == [0, 5, 10, 15]
+    assert first.cues[0].start == 0.15
+    assert all(cue.end - cue.start == pytest.approx(0.5) for cue in first.cues)
+    with wave.open(str(track / "narracao.wav"), "rb") as audio:
+        assert audio.getnframes() == 15 * 16_000
+        audio.setpos(round(first.cues[0].start * audio.getframerate()))
+        assert audio.readframes(1) == b"\x0a\x0b"
+    narration.make_narration(*args, refresh=True)
+    assert len(calls) == 2
+
