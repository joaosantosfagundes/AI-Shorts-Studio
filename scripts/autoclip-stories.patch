+    record = store.begin(row["id"], StoryTask(kind="roteiro"))
+    store.progress(row["id"], record["run_id"], "roteiro", 0, 0, "Roteiro em andamento")
+
+    async def success(*_args):
+        return script
+
+    monkeypatch.setattr(writer, "write_story", success)
+    with TestClient(create_app(), base_url=ORIGIN, client=("127.0.0.1", 50080)) as client:
+        url = PREFIX + "/" + row["id"]
+        assert client.get(url).json()["status"] == "interrompido"
+        post(client, url + "/resume", expected=202)
+        assert wait_for(client, url, "rascunho")["script"]["title"] == script.title
+    assert StoryStore().get(row["id"])["spec"]["idea"] == spec.idea
