+                scenes = [generated if item.id == original.id else item for item in script.scenes]
+                data = script.model_dump()
+                data["scenes"] = scenes
+                return Script.model_validate(data)
+            if isinstance(generated, Script) and generated.genre == spec.genre:
+                if (
+                    len(generated.scenes) == count
+                    and sum(map(_words, generated.scenes)) <= limit + 2
