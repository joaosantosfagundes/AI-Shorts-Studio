+@pytest.fixture
+def script() -> Script:
+    return Script.model_validate(
+        {
+            "title": "A estrela amarela",
+            "synopsis": "Lume e Nina devolvem uma estrela ao céu.",
+            "genre": "misterio",
+            "setting": "Jardim noturno",
+            "ending": "A estrela encontra o seu lugar.",
+            "characters": [
+                {
+                    "id": "c1",
+                    "name": "Lume",
+                    "species": "robo",
+                    "visual": "Verde",
+                    "color": "#82baa9",
+                },
+                {
+                    "id": "c2",
+                    "name": "Nina",
+                    "species": "coruja",
+                    "visual": "Roxa",
+                    "color": "#b3a2d0",
+                },
+            ],
