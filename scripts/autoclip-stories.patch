@@ -0,0 +1,225 @@
+"""Produce a true vertical MP4 from the story's layers and timed narration."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from contextlib import suppress
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+import pysubs2
+from PIL import Image, ImageDraw, ImageFont
+
+from ..pipeline import Cancelled, ffmpeg
+from . import art, narration
+from .schema import FPS, HEIGHT, WIDTH, Script, StoryError, StorySpec
+
+Report = Callable[[str, int, int, str], None]
+
+
+def check_cancelled(cancelled: Callable[[], bool]) -> None:
+    if cancelled():
+        raise Cancelled("Geração de história cancelada.")
+
+
+def _font() -> ImageFont.FreeTypeFont:
+    backend = Path(__file__).resolve().parents[1]
+    fonts = sorted((backend / "static" / "assets").glob("Archivo-Variable*.ttf"))
+    source = backend.parents[1] / "frontend" / "src" / "fonts" / "Archivo-Variable.ttf"
+    if source.is_file():
+        fonts.append(source)
+    for font_path in [*fonts, "arialbd.ttf"]:
+        try:
+            font = ImageFont.truetype(font_path, 49)
+        except OSError:
+            continue
+        with suppress(OSError, ValueError):
+            font.set_variation_by_name("Bold")
+        return font
+    return ImageFont.load_default(size=49)
+
+
+def _caption(text: str, font: ImageFont.FreeTypeFont) -> Image.Image:
+    overlay = Image.new("RGBA", (WIDTH, 210))
+    draw = ImageDraw.Draw(overlay)
+    rows: list[str] = []
+    line = ""
+    for word in text.split():
+        proposal = f"{line} {word}".strip()
+        if line and draw.textlength(proposal, font=font) > WIDTH - 156:
+            rows.append(line)
+            line = word
+        else:
+            line = proposal
+    if line:
+        rows.append(line)
+    for i, row in enumerate(rows):
+        y = 12 + i * 58
+        draw.text(
+            (WIDTH // 2 - 10, y),
+            row,
+            anchor="mt",
+            font=font,
+            fill="#fffaf3",
+            stroke_width=5,
+            stroke_fill=art.INK,
+        )
+    return overlay
+
+
+def _captions(timeline: narration.Timeline, output: Path) -> dict[str, Image.Image]:
+    font = _font()
+    srt = pysubs2.SSAFile()
+    overlays = {}
+    for cue in timeline.cues:
+        srt.append(
+            pysubs2.SSAEvent(
+                start=round(cue.start * 1000), end=round(cue.end * 1000), text=cue.text
+            )
+        )
+        if cue.text not in overlays:
+            overlays[cue.text] = _caption(cue.text, font)
+    srt.save(str(output / "legendas.srt"), encoding="utf-8")
+    return overlays
+
+
+def render_story(
+    script: Script,
+    spec: StorySpec,
+    voice: Path,
+    cache: Path,
+    output: Path,
+    cancelled: Callable[[], bool],
+    report: Report,
+) -> ffmpeg.MediaInfo:
+    art_dir = cache / "art"
+    characters = {character.id: character for character in script.characters}
+    report("personagens", 0, len(characters), "Preparando fichas visuais")
+    for i, character in enumerate(characters.values(), start=1):
+        check_cancelled(cancelled)
+        art.reference(art_dir, character)
+        report("personagens", i, len(characters), character.name)
+
+    report("cenarios", 0, len(script.scenes), "Preparando fundos reutilizáveis")
+    backgrounds = []
+    for i, scene in enumerate(script.scenes, start=1):
+        check_cancelled(cancelled)
+        backgrounds.append(art.backdrop(art_dir, scene))
+        report("cenarios", i, len(script.scenes), scene.title)
+
+    timeline = narration.make_narration(
+        script,
+        spec,
+        voice,
+        cache / "audio",
+        output,
+        cancelled,
+        lambda done, total, message: report("narracao", done, total, message),
+    )
+    report("animacao", 0, len(script.scenes), "Preparando expressões, gestos e enquadramentos")
+    actors = []
+    for i, scene in enumerate(script.scenes, start=1):
+        check_cancelled(cancelled)
+        actors.append([art.actor(art_dir, characters[key], scene.mood) for key in scene.characters])
+        report("animacao", i, len(script.scenes), scene.title)
+
+    report("legendas", 0, len(timeline.cues), "Preparando legendas por frase")
+    overlays = _captions(timeline, output)
+    report("legendas", len(timeline.cues), len(timeline.cues), "Tempos obtidos do áudio")
+
+    final = output / "historia.mp4"
+    partial = output / "renderizando.mp4"
+    try:
+        with TemporaryDirectory(prefix="quadros-", dir=output) as working:
+            frames = Path(working)
+            count = spec.seconds * FPS
+            report("renderizacao", 0, count, "Desenhando quadros")
+            scene_index, cue_index = 0, 0
+            previous, fade_from = None, None
+            for i in range(count):
+                check_cancelled(cancelled)
+                at = i / FPS
+                if at >= timeline.boundaries[scene_index + 1]:
+                    scene_index += 1
+                    fade_from = previous
+                start, end = timeline.boundaries[scene_index : scene_index + 2]
+                elapsed = at - start
+                frame = art.frame(
+                    script.scenes[scene_index],
+                    backgrounds[scene_index],
+                    actors[scene_index],
+                    elapsed,
+                    end - start,
+                )
+                if fade_from is not None and elapsed < 0.23:
+                    frame = Image.blend(fade_from, frame, min(1.0, (elapsed + 0.04) / 0.23))
+                previous = frame.copy()
+                while cue_index < len(timeline.cues) and at >= timeline.cues[cue_index].end:
+                    cue_index += 1
+                if cue_index < len(timeline.cues) and at >= timeline.cues[cue_index].start:
+                    overlay = overlays[timeline.cues[cue_index].text]
+                    frame.paste(overlay, (0, 167), overlay)
+                frame.save(frames / f"{i:05d}.png", compress_level=1)
+                if (i + 1) % FPS == 0:
+                    report("renderizacao", i + 1, count, "Desenhando quadros")
+            units = spec.seconds * 1000
+            report("renderizacao", 0, units, "Codificando MP4")
+            ffmpeg.run(
+                [
+                    "-framerate",
+                    str(FPS),
+                    "-start_number",
+                    "0",
+                    "-i",
+                    str(frames / "%05d.png"),
+                    "-i",
+                    str(output / "narracao.wav"),
+                    "-map",
+                    "0:v:0",
+                    "-map",
+                    "1:a:0",
+                    "-vf",
+                    "fps=24,setsar=1",
+                    "-c:v",
+                    "libx264",
+                    "-pix_fmt",
+                    "yuv420p",
+                    "-crf",
+                    "19",
+                    "-preset",
+                    "veryfast",
+                    "-threads",
+                    "2",
+                    "-c:a",
+                    "aac",
+                    "-b:a",
+                    "128k",
+                    "-ar",
+                    "48000",
+                    "-ac",
+                    "2",
+                    "-t",
+                    str(spec.seconds),
+                    "-movflags",
+                    "+faststart",
+                    str(partial),
+                ],
+                total_duration_s=spec.seconds,
+                on_progress=lambda fraction: report(
+                    "renderizacao", round(fraction * units), units, "Codificando MP4"
+                ),
+                cancelled=cancelled,
+            )
+        info = ffmpeg.probe(partial)
+        if (
+            (info.width, info.height) != (WIDTH, HEIGHT)
+            or info.video_codec != "h264"
+            or info.audio_codec != "aac"
+            or abs(info.duration_s - spec.seconds) > 0.15
+        ):
+            raise StoryError("O MP4 saiu com formato ou duração incompatível. Confira o FFmpeg.")
+        check_cancelled(cancelled)
+        partial.replace(final)
+        return info
+    finally:
+        partial.unlink(missing_ok=True)
