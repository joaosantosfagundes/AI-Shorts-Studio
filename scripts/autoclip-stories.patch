@@ -0,0 +1,181 @@
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, HTTPException, Request, Response
+from fastapi.responses import FileResponse
+
+from ..instagram.api import only_local
+from . import art, narration, writer
+from .runner import StoryRunner
+from .schema import HEIGHT, WIDTH, Character, Script, StoryData, StoryError, StorySpec, StoryTask
+from .store import Busy, StoryStore
+
+router = APIRouter(prefix="/api/stories", dependencies=[Depends(only_local)])
+
+
+def _runner(request: Request) -> StoryRunner:
+    return request.app.state.stories
+
+
+def _store(runner: Annotated[StoryRunner, Depends(_runner)]) -> StoryStore:
+    return runner.store
+
+
+def _error(error: Exception) -> HTTPException:
+    if isinstance(error, KeyError):
+        return HTTPException(404, "Projeto, cena ou arquivo indisponível.")
+    return HTTPException(409 if isinstance(error, Busy) else 422, str(error))
+
+
+def _file(
+    store: StoryStore, path: Path, media_type: str, filename: str | None = None
+) -> FileResponse:
+    resolved = path.resolve()
+    if not resolved.is_relative_to(store.home.resolve()) or not resolved.is_file():
+        raise HTTPException(404, "Arquivo da história indisponível.")
+    return FileResponse(
+        resolved,
+        media_type=media_type,
+        filename=filename,
+        headers={
+            "Cache-Control": "no-store",
+            "Cross-Origin-Resource-Policy": "same-origin",
+        },
+    )
+
+
+Store = Annotated[StoryStore, Depends(_store)]
+Runner = Annotated[StoryRunner, Depends(_runner)]
+
+
+class Edit(StoryData):
+    script: Script
+    spec: StorySpec
+
+
+@router.get("/options")
+async def options() -> dict:
+    problem = None
+    try:
+        models = await writer.installed_models()
+        if not models:
+            problem = "Inicie o Ollama do Studio com um dos modelos configurados para histórias."
+    except StoryError as error:
+        models, problem = [], str(error)
+    return {
+        "models": models,
+        "ollama_problem": problem,
+        "voices": list(narration.available_voices()),
+        "piper_installed": importlib.util.find_spec("piper") is not None,
+        "width": WIDTH,
+        "height": HEIGHT,
+        "word_captions": False,
+    }
+
+
+@router.get("")
+def projects(store: Store) -> list[dict]:
+    return store.projects()
+
+
+@router.post("", status_code=201)
+def create(spec: StorySpec, store: Store) -> dict:
+    return store.create(spec)
+
+
+@router.get("/style-preview")
+def style_preview(store: Store) -> FileResponse:
+    png = art.style_preview(store.home / "cache" / "art")
+    return _file(store, png, "image/png")
+
+
+@router.get("/exports/{version}/video")
+def download(version: str, store: Store, download: bool = False) -> FileResponse:
+    export = store.get_export(version)
+    path = store.export_path(export) if export else None
+    if path is None:
+        raise HTTPException(404, "MP4 da história indisponível.")
+    return _file(store, path, "video/mp4", f"historia-{version}.mp4" if download else None)
+
+
+@router.get("/exports/{version}/captions")
+def captions(version: str, store: Store) -> FileResponse:
+    export = store.get_export(version)
+    if export is None:
+        raise HTTPException(404, "Legendas da história indisponíveis.")
+    path = store.output(export["project_id"], version) / "legendas.srt"
+    return _file(store, path, "application/x-subrip", f"historia-{version}.srt")
+
+
+@router.get("/{project}")
+def get(project: str, store: Store) -> dict:
+    try:
+        return store.get(project)
+    except KeyError as error:
+        raise _error(error) from None
+
+
+@router.put("/{project}")
+def save(project: str, edit: Edit, store: Store) -> dict:
+    try:
+        return store.save(project, edit.spec, edit.script)
+    except (StoryError, KeyError) as error:
+        raise _error(error) from None
+
+
+@router.post("/{project}/approve")
+def approve(project: str, store: Store) -> dict:
+    try:
+        return store.approve(project)
+    except (StoryError, KeyError) as error:
+        raise _error(error) from None
+
+
+@router.post("/{project}/tasks", status_code=202)
+async def start(project: str, operation: StoryTask, runner: Runner) -> dict:
+    try:
+        return await runner.start(project, operation)
+    except (StoryError, KeyError) as error:
+        raise _error(error) from None
+
+
+@router.post("/{project}/resume", status_code=202)
+async def resume(project: str, runner: Runner) -> dict:
+    try:
+        row = runner.store.get(project)
+        if row["status"] not in {"cancelado", "falhou", "interrompido"} or not row["task"]:
+            raise Busy("Este projeto está sem uma tarefa interrompida.")
+        return await runner.start(project, StoryTask.model_validate(row["task"]))
+    except (StoryError, KeyError) as error:
+        raise _error(error) from None
+
+
+@router.post("/{project}/cancel", status_code=204)
+async def cancel(project: str, runner: Runner) -> Response:
+    try:
+        runner.cancel(project)
+        return Response(status_code=204)
+    except Busy as error:
+        raise _error(error) from None
+
+
+@router.get("/{project}/audio/{version}")
+def audio(project: str, version: str, store: Store) -> FileResponse:
+    row = get(project, store)
+    if row["audio_id"] != version:
+        raise HTTPException(404, "Narração indisponível para esta versão.")
+    return _file(store, store.output(project, version) / "narracao.wav", "audio/wav")
+
+
+@router.get("/{project}/characters/{key}")
+def reference(project: str, key: str, store: Store) -> FileResponse:
+    row = get(project, store)
+    characters = (row["script"] or {}).get("characters", [])
+    character = next((item for item in characters if item["id"] == key), None)
+    if character is None:
+        raise HTTPException(404, "Ficha visual indisponível.")
+    png = art.reference(store.home / "cache" / "art", Character.model_validate(character))
+    return _file(store, png, "image/png")
