+        _ellipse(draw, (500, 331, 565, 396), GOLD, 4)
+        draw.line((0, 961, WIDTH, 961), fill=line, width=4)
+    else:
+        _ellipse(draw, (518, 326, 602, 410), GOLD, 5)
+        draw.ellipse((-240, 597, 573, 1050), fill=horizon)
+        draw.ellipse((339, 583, 954, 1006), fill=horizon)
+        draw.rectangle((0, 816, WIDTH, HEIGHT), fill=floor)
+        draw.ellipse((105, 853, 616, 977), fill=_tone(floor, sky, 0.34))
+        if setting == "bosque":
+            for x, y in ((70, 515), (628, 550)):
+                _rounded(draw, (x - 15, y, x + 16, 822), 12, line, 5)
