+"""Original flat artwork. Each expression uses the same reusable body and head geometry."""
+
+from __future__ import annotations
+
+import hashlib
+import math
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+from tempfile import NamedTemporaryFile
+
+from PIL import Image, ImageColor, ImageDraw
+
+from .schema import HEIGHT, WIDTH, Character, Scene
+
+INK = "#251f2b"
+CREAM = "#fff1d8"
+PINK = "#ee9b9c"
+GOLD = "#fed078"
+TEAL = "#93d0bd"
+ASSET_VERSION = "cartoon-v1"
+SIZE = 400
+CANVAS = (WIDTH, HEIGHT)
+PALETTES = {
+    "dia": ("#d7ebed", "#b9d4cb", "#87b5a1", "#57a290", "#486b6a"),
+    "entardecer": ("#f6d4c6", "#e3b4c8", "#c692a7", "#a46d91", "#6e526e"),
+    "noite": ("#434261", "#555077", "#626186", "#7473a3", "#a6a0c2"),
+}
+
+
+def _tone(color: str, other: str, amount: float) -> tuple[int, int, int]:
+    first = ImageColor.getrgb(color)
+    second = ImageColor.getrgb(other)
+    return tuple(round(a + (b - a) * amount) for a, b in zip(first, second, strict=True))
+
+
+def _ellipse(draw: ImageDraw.ImageDraw, box, fill, width: int = 8) -> None:
+    draw.ellipse(box, fill=fill, outline=INK, width=width)
+
+
+def _rounded(draw: ImageDraw.ImageDraw, box, radius, fill, width: int = 8) -> None:
+    draw.rounded_rectangle(box, radius=radius, fill=fill, outline=INK, width=width)
+
+
+def _star(draw: ImageDraw.ImageDraw, x: float, y: float, size: float, fill: str) -> None:
+    points = []
+    for i in range(10):
+        angle = i * math.pi / 5 - math.pi / 2
+        radius = size if i % 2 == 0 else size * 0.46
+        points.append((x + math.cos(angle) * radius, y + math.sin(angle) * radius))
+    draw.polygon(points, fill=fill, outline=INK, width=max(2, round(size / 11)))
+
+
+def _body(character: Character) -> Image.Image:
+    image = Image.new("RGBA", (SIZE, SIZE))
+    draw = ImageDraw.Draw(image)
+    base = character.color
+    lighter = _tone(base, CREAM, 0.7)
+    if character.species == "robo":
+        _rounded(draw, (108, 204, 292, 345), 40, base)
+        _rounded(draw, (133, 310, 186, 365), 19, lighter)
+        _rounded(draw, (214, 310, 267, 365), 19, lighter)
+        _rounded(draw, (157, 250, 243, 306), 14, lighter, 5)
+        for x in (178, 200, 222):
+            draw.ellipse((x - 5, 271, x + 5, 281), fill=INK)
+    else:
+        if character.species in {"cachorro", "gato"}:
+            draw.line([(258, 308), (305, 282), (321, 239)], fill=INK, width=29, joint="curve")
+            draw.line([(258, 308), (305, 282), (321, 239)], fill=base, width=13, joint="curve")
+            draw.ellipse((314, 233, 328, 247), fill=base)
+        _ellipse(draw, (101, 193, 299, 354), base)
+        draw.ellipse((145, 220, 255, 331), fill=lighter)
+        _ellipse(draw, (109, 311, 190, 366), base, 7)
+        _ellipse(draw, (210, 311, 291, 366), base, 7)
+        for x in (140, 155, 245, 260):
+            draw.line((x, 353, x, 360), fill=INK, width=3)
+    if character.accessory == "lenco":
+        _rounded(draw, (117, 205, 283, 244), 17, TEAL, 6)
+        _rounded(draw, (229, 226, 265, 288), 10, TEAL, 6)
+    elif character.accessory == "gravata":
+        draw.polygon([(168, 212), (196, 228), (168, 244)], fill=PINK, outline=INK, width=5)
+        draw.polygon([(232, 212), (204, 228), (232, 244)], fill=PINK, outline=INK, width=5)
+        _ellipse(draw, (190, 219, 210, 238), PINK, 4)
+    elif character.accessory == "broche":
+        _star(draw, 242, 267, 18, GOLD)
+    return image
+
+
+def _head(character: Character, mood: str, blink: bool) -> Image.Image:
+    image = Image.new("RGBA", (SIZE, SIZE))
+    draw = ImageDraw.Draw(image)
+    base = character.color
+    dark = _tone(base, INK, 0.28)
+    light = _tone(base, CREAM, 0.76)
+    if character.species == "coelho":
+        for x in (136, 214):
+            _rounded(draw, (x, 9, x + 50, 132), 23, base)
+            draw.rounded_rectangle((x + 12, 25, x + 37, 108), 13, fill=PINK)
+    if character.species in {"gato", "coruja"}:
+        left_ear = [(102, 125), (111, 54), (165, 103)]
+        right_ear = [(SIZE - x, y) for x, y in left_ear]
+        for ear in (left_ear, right_ear):
+            draw.polygon(ear, fill=base, outline=INK, width=8)
+    if character.species == "robo":
+        draw.line((200, 49, 200, 91), fill=INK, width=8)
+        _ellipse(draw, (184, 27, 216, 58), PINK, 6)
+        _rounded(draw, (83, 85, 317, 224), 44, base)
+        _rounded(draw, (107, 106, 293, 202), 36, light, 5)
+    else:
+        _ellipse(draw, (81, 76, 319, 226), base)
+    if character.species == "cachorro":
+        _ellipse(draw, (67, 89, 120, 186), dark)
+        _ellipse(draw, (280, 89, 333, 186), dark)
+        draw.ellipse((127, 114, 188, 174), fill=dark)
+    if character.species == "coruja":
+        for x in (110, 198):
+            draw.ellipse((x, 99, x + 91, 187), fill=light)
+
+    for x in (157, 243):
+        if blink:
+            draw.arc((x - 14, 130, x + 14, 151), 15, 165, fill=INK, width=5)
+        else:
+            tall = 31 if mood in {"surpreso", "assustado"} else 25
+            draw.ellipse((x - 11, 140 - tall // 2, x + 11, 140 + tall // 2), fill=INK)
+            draw.ellipse((x - 5, 132, x + 1, 139), fill=CREAM)
+        if mood in {"surpreso", "assustado", "curioso", "triste"}:
+            slope = 3 if x == 157 else -3
+            draw.line((x - 12, 113 + slope, x + 12, 113 - slope), fill=INK, width=4)
+        draw.ellipse((x - 28, 164, x - 8, 176), fill=PINK)
+    if character.species in {"cachorro", "gato", "coelho"}:
+        draw.ellipse((160, 153, 240, 211), fill=light)
+        _ellipse(draw, (188, 162, 212, 177), INK, 3)
+    elif character.species == "coruja":
+        draw.polygon([(186, 153), (214, 153), (200, 174)], fill=GOLD, outline=INK, width=4)
+
+    if mood in {"surpreso", "assustado"}:
+        _ellipse(draw, (191, 181, 209, 200), INK, 4)
+    elif mood == "triste":
+        draw.arc((182, 183, 218, 204), 205, 335, fill=INK, width=5)
+    else:
+        draw.arc((179, 172, 221, 199), 15, 165, fill=INK, width=5)
+    if character.accessory == "oculos":
+        for x in (157, 243):
+            draw.ellipse((x - 27, 114, x + 27, 166), outline=INK, width=5)
+        draw.line((184, 139, 216, 139), fill=INK, width=5)
+    return image
+
+
+def _paw(character: Character) -> Image.Image:
+    image = Image.new("RGBA", (SIZE, SIZE))
+    draw = ImageDraw.Draw(image)
+    _rounded(draw, (250, 221, 292, 301), 19, character.color, 6)
+    draw.line((267, 287, 267, 296), fill=INK, width=3)
+    return image
+
+
+def _cached_png(folder: Path, key: str, make: Callable[[], Image.Image]) -> Path:
+    identity = hashlib.sha256(f"{ASSET_VERSION}/{key}".encode()).hexdigest()[:24]
+    name = folder / f"{identity}.png"
+    if name.is_file():
+        return name
+    folder.mkdir(parents=True, exist_ok=True)
+    with NamedTemporaryFile(dir=folder, suffix=".png", delete=False) as handle:
+        temp = Path(handle.name)
+    try:
+        make().save(temp, compress_level=3)
+        temp.replace(name)
+    finally:
+        temp.unlink(missing_ok=True)
+    return name
+
+
+def _layer(folder: Path, key: str, make: Callable[[], Image.Image]) -> Image.Image:
+    with Image.open(_cached_png(folder, key, make)) as image:
+        return image.copy()
+
+
+@dataclass
+class Actor:
+    body: Image.Image
+    head: Image.Image
+    blink: Image.Image
+    paw: Image.Image
+
+    def sprite(self, *, eyes_closed=False, nod=0.0, wave=0.0) -> Image.Image:
+        image = self.body.copy()
+        hand = (
+            self.paw.rotate(wave, Image.Resampling.BICUBIC, center=(263, 235)) if wave else self.paw
+        )
+        image.alpha_composite(hand)
+        face = self.blink if eyes_closed else self.head
+        if nod:
+            face = face.rotate(nod, Image.Resampling.BICUBIC, center=(200, 191))
+        image.alpha_composite(face)
+        return image
+
+
+def actor(cache: Path, character: Character, mood: str) -> Actor:
+    key = f"{character.species}/{character.color}/{character.accessory}"
+    return Actor(
+        _layer(cache, f"{key}/body", lambda: _body(character)),
+        _layer(cache, f"{key}/{mood}/face", lambda: _head(character, mood, False)),
+        _layer(cache, f"{key}/{mood}/blink", lambda: _head(character, mood, True)),
+        _layer(cache, f"{key}/paw", lambda: _paw(character)),
+    )
+
+
+def reference(cache: Path, character: Character) -> Path:
+    key = f"{character.species}/{character.color}/{character.accessory}/reference"
+    return _cached_png(cache, key, lambda: actor(cache, character, "calmo").sprite())
+
+
+def _background(setting: str, light: str) -> Image.Image:
+    sky, horizon, floor, accent, line = PALETTES[light]
+    image = Image.new("RGB", CANVAS, sky)
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((0, 742, WIDTH, HEIGHT), fill=floor)
+    draw.line((-10, 743, WIDTH + 10, 743), fill=line, width=6)
+    draw.ellipse((120, 844, 601, 948), fill=_tone(floor, sky, 0.38))
+
+    if setting in {"quarto", "oficina"}:
+        _rounded(draw, (393, 310, 649, 629), 27, horizon, 7)
+        _rounded(draw, (414, 331, 628, 604), 18, sky, 4)
+        draw.line((521, 332, 521, 603), fill=line, width=8)
+        draw.line((415, 469, 628, 469), fill=line, width=8)
+        _ellipse(draw, (548, 355, 603, 410), GOLD, 4)
+        draw.arc((430, 465, 598, 640), 192, 328, fill=accent, width=10)
+        _rounded(draw, (70, 454, 197, 501), 9, horizon, 5)
+        _star(draw, 130, 426, 24, GOLD)
+        _rounded(draw, (49, 666, 194, 779), 14, accent, 6)
+        draw.line((52, 715, 191, 715), fill=line, width=7)
