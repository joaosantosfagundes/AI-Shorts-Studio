+    for x, y in ((104, 357), (271, 399), (463, 478), (658, 380)):
+        if light == "noite":
+            draw.line((x - 5, y, x + 5, y), fill=CREAM, width=2)
+            draw.line((x, y - 5, x, y + 5), fill=CREAM, width=2)
+    return image
+
+
+def backdrop(cache: Path, scene: Scene) -> Image.Image:
+    return _layer(
+        cache,
+        f"background/{scene.setting}/{scene.light}",
+        lambda: _background(scene.setting, scene.light),
+    )
+
+
+def _prop(draw: ImageDraw.ImageDraw, kind: str, x: int, y: int, motion: float) -> None:
+    if kind == "estrela":
+        _star(draw, x, y, 43, GOLD)
+        _star(draw, x + 53, y - 34, 8 + motion * 3, CREAM)
+    elif kind == "chave":
+        _ellipse(draw, (x - 20, y - 42, x + 20, y - 3), GOLD, 6)
+        _rounded(draw, (x - 9, y - 10, x + 9, y + 38), 6, GOLD, 4)
+        draw.line((x + 5, y + 25, x + 22, y + 25), width=7, fill=INK)
+    elif kind == "lanterna":
+        _rounded(draw, (x - 33, y - 23, x + 35, y + 32), 15, TEAL, 6)
+        _rounded(draw, (x + 14, y - 31, x + 36, y + 37), 8, GOLD, 5)
+        draw.line((x + 47, y, x + 75, y), width=5, fill=GOLD)
+    elif kind in {"bilhete", "livro"}:
+        _rounded(draw, (x - 34, y - 26, x + 34, y + 27), 8, CREAM if kind == "bilhete" else TEAL, 6)
+        for offset in (-10, 3):
+            draw.line((x - 18, y + offset, x + 17, y + offset), fill=INK, width=3)
+    elif kind == "semente":
+        _ellipse(draw, (x - 18, y - 17, x + 19, y + 27), GOLD, 5)
+        _ellipse(draw, (x, y - 31, x + 24, y - 13), TEAL, 4)
+    elif kind == "bola":
+        _ellipse(draw, (x - 34, y - 34, x + 34, y + 34), PINK, 6)
+        draw.arc((x - 24, y - 24, x + 24, y + 24), 205, 295, fill=CREAM, width=6)
+
+
+def frame(
+    scene: Scene, background: Image.Image, cast: list[Actor], t: float, length: float
+) -> Image.Image:
+    image = background.copy()
+    size = (435 if len(cast) == 1 else 348) + (43 if scene.shot == "proximo" else 0)
+    centers = (360,) if len(cast) == 1 else (202, 515)
+    for i, (figure, x) in enumerate(zip(cast, centers, strict=True)):
+        breath = math.sin(t * 2.6 + i)
+        base_y = 891 - round(size * 0.88) + round(breath * 4)
+        if scene.motion == "pular" and i == 0:
+            base_y -= round(max(0, math.sin(t * 3.4)) ** 2 * 35)
+        if scene.motion == "entrar" and i == 0:
+            x -= round(max(0, 1 - t / 0.85) ** 2 * 263)
+        if scene.motion == "sair" and i == 0:
+            x += round(max(0, 1 - (length - t) / 0.85) ** 2 * 263)
+        sprite = figure.sprite(
+            eyes_closed=(t + i * 0.83 + 0.5) % 3.1 > 2.94,
+            nod=round(math.sin(t * 3.5) * 9) if scene.motion == "balancar_cabeca" and i == 0 else 0,
+            wave=round(-32 + math.sin(t * 6) * 15) if scene.motion == "acenar" and i == 0 else 0,
+        )
+        sprite = sprite.resize((size, size), Image.Resampling.BILINEAR)
+        image.paste(sprite, (x - size // 2, base_y), sprite)
+    prop_x = 358 if len(cast) == 2 else 514
+    _prop(
+        ImageDraw.Draw(image), scene.prop, prop_x, 858 + round(math.sin(t * 3) * 6), math.sin(t * 5)
+    )
+    return image
+
+
+def style_preview(cache: Path) -> Path:
+    def compose() -> Image.Image:
+        rabbit = Character(
+            id="pingo",
+            name="Pingo",
+            species="coelho",
+            visual="Pêssego",
+            color="#e5a277",
+            accessory="lenco",
+        )
+        owl = Character(
+            id="nina",
+            name="Nina",
+            species="coruja",
+            visual="Lavanda",
+            color="#b1a1d2",
+            accessory="broche",
+        )
+        scene = Scene(
+            id="exemplo",
+            title="Exemplo de arte",
+            setting="jardim",
+            light="noite",
+            seconds=5,
+            characters=[rabbit.id, owl.id],
+            narration="Uma estrela chegou ao jardim.",
+            action="Os dois observam a estrela.",
+            mood="curioso",
+            motion="respirar",
+            prop="estrela",
+        )
+        figures = [actor(cache, character, scene.mood) for character in (rabbit, owl)]
+        return frame(scene, backdrop(cache, scene), figures, 0.6, scene.seconds)
+
+    return _cached_png(cache, "style-preview", compose)
