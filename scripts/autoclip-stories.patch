+async def test_invalid_ollama_response_stops_at_two_attempts(monkeypatch, spec):
+    attempts = []
+
+    async def generate(*_args):
+        return "not json"
+
+    monkeypatch.setattr(writer, "_generation", generate)
+    with pytest.raises(StoryError, match="duas vezes"):
+        await writer.write_story(spec, lambda: False, attempts.append)
+    assert attempts == [1, 2]
