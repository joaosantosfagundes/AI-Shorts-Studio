@@ -0,0 +1,261 @@
+"""Measure every spoken phrase from Piper's PCM output and build the scene timeline."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import os
+import re
+import sys
+import textwrap
+import wave
+from collections.abc import Callable
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from .. import paths
+from ..pipeline import Cancelled, process
+from .schema import Script, StoryError, StorySpec
+
+Progress = Callable[[int, int, str], None]
+
+
+@dataclass(frozen=True)
+class Cue:
+    start: float
+    end: float
+    text: str
+
+
+@dataclass
+class Timeline:
+    boundaries: list[float]
+    cues: list[Cue]
+
+
+def voices_dir() -> Path:
+    custom = os.environ.get("AI_SHORTS_STORY_VOICES")
+    return Path(custom).expanduser().resolve() if custom else paths.root() / "stories" / "voices"
+
+
+def available_voices() -> dict[str, Path]:
+    if importlib.util.find_spec("piper") is None:
+        return {}
+    folder = voices_dir()
+    found = {}
+    for model in sorted(folder.glob("pt_BR-*.onnx")):
+        config = model.with_suffix(".onnx.json")
+        if not re.fullmatch(r"pt_BR-[A-Za-z0-9_-]{1,75}", model.stem):
+            continue
+        try:
+            if not all(file.resolve().is_relative_to(folder) for file in (model, config)):
+                continue
+            if model.stat().st_size == 0 or config.stat().st_size > 100_000:
+                continue
+            definition = json.loads(config.read_text(encoding="utf-8"))
+            if definition["espeak"]["voice"].lower().replace("_", "-") == "pt-br":
+                found[model.stem] = model
+        except (AttributeError, KeyError, TypeError, ValueError, OSError):
+            continue
+    return found
+
+
+def phrase_groups(script: Script) -> list[list[str]]:
+    groups = []
+    for scene in script.scenes:
+        fragments = [scene.narration, *(dialogue.text for dialogue in scene.dialogues)]
+        phrases = []
+        for fragment in fragments:
+            normalized = " ".join(fragment.split())
+            for sentence in re.split(r"(?<=[.!?…])\s+", normalized):
+                phrases.extend(textwrap.wrap(sentence, width=63, break_on_hyphens=False))
+        groups.append(phrases)
+    return groups
+
+
+def _fragment_path(cache: Path, voice: Path, speed: float, phrase: str) -> Path:
+    files = (voice, voice.with_suffix(".onnx.json"))
+    identity = [(item.stat().st_size, item.stat().st_mtime_ns) for item in files]
+    key = json.dumps(["piper-pcm-v1", voice.stem, identity, speed, phrase], ensure_ascii=False)
+    digest = hashlib.sha256(key.encode()).hexdigest()
+    return cache / f"{digest}.wav"
+
+
+def synthesize(
+    voice: Path,
+    speed: float,
+    todo: dict[str, Path],
+    cancelled: Callable[[], bool],
+    progress: Callable[[int], None],
+) -> None:
+    if not todo:
+        return
+    cache = next(iter(todo.values())).parent
+    cache.mkdir(parents=True, exist_ok=True)
+    with TemporaryDirectory(prefix="piper-", dir=cache) as work:
+        request = Path(work) / "frases.json"
+        request.write_text(
+            json.dumps(
+                {"speed": speed, "phrases": [[text, str(path)] for text, path in todo.items()]},
+                ensure_ascii=False,
+            ),
+            encoding="utf-8",
+        )
+
+        def parse(line: str) -> process.Update | None:
+            _, separator, count = line.strip().partition("piper_frases=")
+            return process.Update(int(count)) if separator and count.isdigit() else None
+
+        result = process.run(
+            [sys.executable, "-m", "autoclip.stories.narration", str(voice), str(request)],
+            label="Piper",
+            parse=parse,
+            idle_timeout_s=90,
+            on_progress=lambda update: progress(int(update.position)),
+            cancelled=cancelled,
+            kill_tree=True,
+        )
+    if result.stalled:
+        raise StoryError(
+            "O Piper ficou 90 segundos sem gerar uma frase. Verifique a voz instalada."
+        )
+    if result.code:
+        detail = result.stderr.strip().splitlines()[-1:]
+        suffix = f" {detail[0][:220]}" if detail else ""
+        raise StoryError(f"Falha na narração Piper (código {result.code}).{suffix}")
+
+
+def _pcm(filename: Path) -> tuple[int, bytes]:
+    try:
+        with wave.open(str(filename), "rb") as source:
+            if source.getnchannels() != 1 or source.getsampwidth() != 2:
+                raise StoryError("A voz deve fornecer áudio PCM mono de 16 bits.")
+            rate = source.getframerate()
+            frames = source.getnframes()
+            if not (8_000 <= rate <= 48_000 and 0 < frames <= rate * 60):
+                raise StoryError("O Piper devolveu uma frase vazia ou com duração inválida.")
+            data = source.readframes(frames)
+            if len(data) != frames * 2 or not any(data):
+                raise StoryError("O Piper devolveu áudio vazio. Confira o texto e a voz instalada.")
+            return rate, data
+    except (OSError, EOFError, wave.Error):
+        raise StoryError(
+            "Não foi possível ler o áudio gerado pelo Piper. Regenere a narração."
+        ) from None
+
+
+def make_narration(
+    script: Script,
+    spec: StorySpec,
+    voice: Path,
+    cache: Path,
+    output: Path,
+    cancelled: Callable[[], bool],
+    progress: Progress,
+    *,
+    refresh: bool = False,
+) -> Timeline:
+    groups = phrase_groups(script)
+    if sum(len(phrase.split()) for group in groups for phrase in group) > spec.seconds * 4:
+        raise StoryError("Há texto demais para a duração escolhida. Encurte a narração e as falas.")
+    fragments = {
+        phrase: _fragment_path(cache, voice, spec.speed, phrase)
+        for group in groups
+        for phrase in group
+    }
+    todo = {phrase: path for phrase, path in fragments.items() if refresh or not path.is_file()}
+    reused = len(fragments) - len(todo)
+    progress(reused, len(fragments), f"{reused} frases reaproveitadas")
+    synthesize(
+        voice,
+        spec.speed,
+        todo,
+        cancelled,
+        lambda count: progress(reused + count, len(fragments), "Convertendo texto em fala"),
+    )
+    buffers = {phrase: _pcm(path) for phrase, path in fragments.items()}
+    rates = {rate for rate, _ in buffers.values()}
+    if len(rates) != 1:
+        raise StoryError("As frases não usam a mesma taxa de amostragem. Regenere a narração.")
+    rate = rates.pop()
+    intro, gap, outro = round(rate * 0.15), round(rate * 0.11), round(rate * 0.19)
+    minimum = [
+        intro
+        + outro
+        + (len(group) - 1) * gap
+        + sum(len(buffers[phrase][1]) // 2 for phrase in group)
+        for group in groups
+    ]
+    total = spec.seconds * rate
+    extra = total - sum(minimum)
+    if extra < 0:
+        raise StoryError(
+            f"A fala ocupa pelo menos {sum(minimum) / rate:.1f} s e o vídeo tem {spec.seconds} s. "
+            "Encurte as falas, aumente a velocidade ou escolha um vídeo mais longo."
+        )
+    weight = sum(scene.seconds for scene in script.scenes)
+    boundaries, cues = [0.0], []
+    cursor, allocated, elapsed = 0, 0, 0.0
+    with wave.open(str(output / "narracao.wav"), "wb") as target:
+        target.setparams((1, 2, rate, 0, "NONE", "not compressed"))
+        for i, group in enumerate(groups):
+            if cancelled():
+                raise Cancelled("Narração cancelada.")
+            target.writeframesraw(b"\x00\x00" * intro)
+            cursor += intro
+            for j, phrase in enumerate(group):
+                data = buffers[phrase][1]
+                start = cursor / rate
+                target.writeframesraw(data)
+                cursor += len(data) // 2
+                cues.append(Cue(start, cursor / rate, phrase))
+                if j < len(group) - 1:
+                    target.writeframesraw(b"\x00\x00" * gap)
+                    cursor += gap
+            elapsed += script.scenes[i].seconds
+            next_padding = extra if i == len(groups) - 1 else round(extra * elapsed / weight)
+            tail = outro + next_padding - allocated
+            target.writeframesraw(b"\x00\x00" * tail)
+            cursor += tail
+            allocated = next_padding
+            boundaries.append(cursor / rate)
+    (output / "timeline.json").write_text(
+        json.dumps(
+            {"boundaries": boundaries, "cues": [asdict(cue) for cue in cues]}, ensure_ascii=False
+        ),
+        encoding="utf-8",
+    )
+    progress(len(fragments), len(fragments), "Narração medida e sincronizada")
+    return Timeline(boundaries, cues)
+
+
+def _piper_batch(voice_path: Path, request: Path) -> None:
+    from piper import PiperVoice, SynthesisConfig
+    from piper.phonemize_espeak import ESPEAK_DATA_DIR
+
+    voice_path, request = voice_path.resolve(), request.resolve()
+    task = json.loads(request.read_text(encoding="utf-8"))
+    data = ESPEAK_DATA_DIR
+    if os.name == "nt":
+        # The eSpeak C library can reject accented absolute paths on Windows.
+        # Use a relative path only in this worker, without changing Studio's cwd.
+        os.chdir(data.parent)
+        os.environ["ESPEAK_DATA_PATH"] = "."
+        data = Path("espeak-ng-data")
+    voice = PiperVoice.load(voice_path, use_cuda=False, espeak_data_dir=data)
+    options = SynthesisConfig(length_scale=1 / task["speed"], volume=0.9)
+    for count, (text, target) in enumerate(task["phrases"], start=1):
+        partial = request.parent / "frase.wav"
+        with wave.open(str(partial), "wb") as audio:
+            voice.synthesize_wav(
+                text.replace("[[", "").replace("]]", ""), audio, syn_config=options
+            )
+        _pcm(partial)
+        partial.replace(target)
+        print(f"piper_frases={count}", flush=True)
+
+
+if __name__ == "__main__":
+    _piper_batch(Path(sys.argv[1]), Path(sys.argv[2]))
