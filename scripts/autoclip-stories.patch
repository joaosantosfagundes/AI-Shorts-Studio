+}
+
+export interface StoryProject extends Omit<StorySummary, 'title'> {
+  spec: StorySpec
+  script: Script | null
+  approved: boolean
+  stage: keyof typeof STAGES | 'aguardando' | null
+  completed: number
+  total: number
+  detail: string
+  error: string | null
+  task: Task | null
+  audio_id: string | null
+  export: StoryExport | null
+}
+
+export interface StoryOptions {
+  models: string[]
+  ollama_problem: string | null
+  voices: string[]
+  piper_installed: boolean
+  width: number
+  height: number
+  word_captions: boolean
+}
+
+const prefix = '/api/stories'
+const read = <T>(path: string) => request<T>(prefix + path)
+const write = <T>(path: string, method: string, body?: unknown) => request<T>(prefix + path, {
+  method, headers: { 'X-Studio-Local': '1' }, body: body === undefined ? undefined : JSON.stringify(body),
+})
+const projectPath = (id: string) => '/' + encodeURIComponent(id)
+const exportPath = (id: string) => '/exports/' + encodeURIComponent(id)
+
+export function voiceName(voice: string) {
+  const [name] = voice.replace(/^pt_BR-/, '').split('-')
+  return name ? name[0].toUpperCase() + name.slice(1) + ' · pt-BR' : 'Sem voz'
+}
+
+export const stories = {
+  options: () => read<StoryOptions>('/options'),
+  list: () => read<StorySummary[]>(''),
+  get: (id: string) => read<StoryProject>(projectPath(id)),
+  create: (spec: StorySpec) => write<StoryProject>('', 'POST', spec),
+  save: (id: string, spec: StorySpec, script: Script) => write<StoryProject>(projectPath(id), 'PUT', { spec, script }),
+  approve: (id: string) => write<StoryProject>(projectPath(id) + '/approve', 'POST'),
+  task: (id: string, task: Task) => write<StoryProject>(projectPath(id) + '/tasks', 'POST', task),
+  resume: (id: string) => write<StoryProject>(projectPath(id) + '/resume', 'POST'),
+  cancel: (id: string) => write<void>(projectPath(id) + '/cancel', 'POST'),
+  video: (id: string, download = false) => prefix + exportPath(id) + '/video' + (download ? '?download=true' : ''),
+  captions: (id: string) => prefix + exportPath(id) + '/captions',
+  audio: (id: string, version: string) => prefix + projectPath(id) + '/audio/' + encodeURIComponent(version),
+  reference: (id: string, key: string, version: string) => prefix + projectPath(id) + '/characters/'
+    + encodeURIComponent(key) + '?v=' + encodeURIComponent(version),
+  stylePreview: prefix + '/style-preview',
+}
