+            f"São exatamente {count} cenas e {spec.seconds} segundos. Cada 'narration' "
+            f"tem UMA frase curta de até {max_per_scene} palavras. Deixe 'dialogues' vazio. "
+            f"No máximo {limit} palavras faladas no vídeo todo. "
+            "O final precisa aparecer na última narração. "
+            "Use de um a três personagens. Os segundos estimados somam a duração escolhida."
+        )
+
+    feedback = ""
+    for number in (1, 2):
+        if cancelled():
+            raise Cancelled("Geração de roteiro cancelada.")
+        attempt(number)
+        payload = {
+            "model": local.model,
+            "system": SYSTEM,
+            "prompt": prompt + feedback,
+            "format": schema.model_json_schema(),
+            "stream": False,
+            "keep_alive": 0,
+            "options": {"temperature": 0.35 if number == 1 else 0.1, "num_predict": 2800},
+        }
+        if spec.model.startswith("qwen3:"):
+            payload["think"] = False
+        output = await _generation(local.url, payload, cancelled)
+        try:
+            generated = schema.model_validate_json(output)
+            if isinstance(generated, Scene) and script is not None:
+                if _words(generated) > budget + 3:
+                    feedback = f"\nEncurte a narração e falas para até {budget} palavras."
+                    continue
