@@ -0,0 +1,158 @@
+from __future__ import annotations
+
+import asyncio
+import contextlib
+from collections.abc import Callable
+from urllib.parse import urlsplit
+
+import httpx
+from pydantic import ValidationError
+
+from .. import config
+from ..pipeline import Cancelled
+from ..providers.ollama_provider import OllamaProvider
+from .schema import MODELS, Scene, Script, StoryError, StorySpec
+
+SYSTEM = """Escreva histórias fictícias originais em português do Brasil para cartoon 2D.
+Entregue o JSON do esquema, sem markdown. Faça começo, desenvolvimento e final narrados.
+Use palavras simples, frases naturais e elementos que a biblioteca consegue desenhar.
+IDs distintos como c1, c2 e s1, s2; reutilize o ID em todas as aparições do personagem.
+Narre visualmente o que importa. 'action' descreve o acontecimento e 'motion' escolhe
+o gesto que o desenho consegue realizar. 'prop' é um objeto visível ou 'nenhum'.
+Use cores hexadecimais suaves para a ficha visual. Não imite personagens conhecidos.
+Omita os diálogos ou use uma lista vazia se a narração já for suficiente."""
+
+
+def provider(model: str = "") -> OllamaProvider:
+    settings = config.load().providers.get("ollama")
+    local = OllamaProvider(model, base_url=settings.base_url if settings else None)
+    try:
+        url = urlsplit(local.url)
+        port = url.port
+    except ValueError:
+        raise StoryError("Confira o endereço do Ollama nas Configurações do Studio.") from None
+    if (
+        url.scheme not in {"http", "https"}
+        or url.hostname not in {"localhost", "127.0.0.1", "::1"}
+        or url.username
+        or url.path
+        or url.query
+        or url.fragment
+        or port == 0
+    ):
