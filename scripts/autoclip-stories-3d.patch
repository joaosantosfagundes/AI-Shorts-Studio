+    cancelled: Callable[[], bool],
+    report: Report,
+) -> Iterator[DrawFrame]:
+    cast = {character.id: character for character in script.characters}
+    report("animacao", 0, len(script.scenes), "Preparando gestos, olhares e câmeras")
+    if spec.style == "cartoon-3d":
