+        return self.question, self.plan_a, self.plan_b
+
+    @property
+    def end_seconds(self) -> int:
+        if not self.question:
+            return 0
+        words = sum(len(text.split()) for text in self.choices)
+        return max(4, min(8, ceil((words + 4) / 3)))
+
+    @model_validator(mode="after")
+    def validate_ballot(self) -> EpisodeNotes:
+        if any(self.choices) and not all(self.choices):
