@@ -0,0 +1,540 @@
+"""Reusable, original mesh characters and stages for the local OpenGL renderer."""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from pathlib import Path
+
+from PIL import Image, ImageColor
+
+from . import art
+from .geometry import Canvas, Matrix, Vector, transform, turn
+from .schema import Character, Scene
+
+INK = "#25263d"
+EYE = "#252538"
+CREAM = "#fff4dc"
+PINK = "#f5a8b7"
+GOLD = "#ffd576"
+MINT = "#61c8b9"
+SKIES = {
+    "dia": ("#cfeaf4", "#9bc6ad", "#a4cbd6"),
+    "entardecer": ("#f3cdbb", "#bc92af", "#d5a6aa"),
+    "noite": ("#282a4f", "#455470", "#545981"),
+}
+POSITIONS = {"esquerda": -0.59, "centro": 0.0, "direita": 0.59}
+PITCHES = {"medio": 39, "proximo": 33, "aberto": 45, "acompanhar": 39}
+SETTINGS_3D = ("quarto", "jardim", "bosque", "oficina", "rua")
+
+
+def _tone(first: str, second: str, fraction: float) -> str:
+    mix = [
+        round(a + (b - a) * fraction)
+        for a, b in zip(ImageColor.getrgb(first), ImageColor.getrgb(second), strict=True)
+    ]
+    return "#" + "".join(f"{value:02x}" for value in mix)
+
+
+@dataclass(frozen=True)
+class Pose:
+    position: float
+    yaw: float = 0
+    tilt: float = 0
+    nod: float = 0
+    arm: float = 0
+    step: float = 0
+    rise: float = 0
+    eyes: float = 1
+
+
+def _pose(scene: Scene, index: int, at: float, duration: float, x: float) -> Pose:
+    choice = next(
+        (entry for entry in scene.placements if entry.character == scene.characters[index]), None
+    )
+    gaze = choice.gaze if choice else "camera"
+    yaw = 0.0
+    tilt = 0.0
+    if gaze in {"outro", "objeto"}:
+        yaw = (0.67 if gaze == "outro" else 0.48) * (1 if x <= 0 else -1)
+        tilt = 0.10 if gaze == "objeto" else -0.06
+    if gaze == "janela":
+        yaw, tilt = math.atan2(0.51 - x, -3.2), -0.24
+    eyes = 0.11 if (at + index * 0.67 + 0.3) % 3.2 > 3.03 else 1
+    rise = math.sin(at * 2.3 + index) * 0.014
+    nod, arm, gait = 0.0, 0.0, 0.0
+    if scene.characters[index] == (scene.motion_character or scene.characters[0]):
+        if scene.motion == "balancar_cabeca":
+            nod = math.sin(at * 4.1) * 0.14
+        if scene.motion == "acenar":
+            arm = -0.72 + math.sin(at * 6.2) * 0.34
+        if scene.motion == "pular":
+            rise += 0.15 * max(0.0, math.sin(at * 4.6)) ** 2
+        if scene.motion in {"entrar", "sair", "caminhar"}:
+            gait = math.sin(at * 12) * 0.12
+            yaw += 0.23
+            if scene.motion == "entrar":
+                direction = 1 if x > 0 else -1
+                x += direction * 0.95 * max(0.0, 1 - at / 1.2) ** 2
+            elif scene.motion == "sair":
+                direction = -1 if x < 0 else 1
+                x += direction * 0.9 * max(0.0, 1 - (duration - at) / 1.2) ** 2
+            else:
+                x += 0.52 * (min(1.0, at / max(duration, 0.01)) - 0.5)
+    return Pose(x, yaw, tilt, nod, arm, gait, rise, eyes)
+
+
+class Stage:
+    def __init__(self, canvas: Canvas) -> None:
+        self.canvas = canvas
+
+    def _part(
+        self,
+        parent: Matrix,
+        kind: str,
+        at: Vector,
+        size: Vector,
+        shade: str,
+        *,
+        rotation: float = 0,
+        glow: float = 0,
+    ) -> None:
+        local = transform(at, size)
+        if rotation:
+            local = transform(at) @ turn(rotation, 2) @ transform(size=size)
+        self.canvas.draw(kind, parent @ local, shade, glow=glow)
+
+    def _eyes(
+        self,
+        face: Matrix,
+        depth: float,
+        width: float,
+        mood: str,
+        pose: Pose,
+        *,
+        height: float = 0.04,
+        glasses: bool = False,
+    ) -> None:
+        tall = 0.093 if mood in {"surpreso", "assustado"} else 0.075
+        for sign in (-1, 1):
+            x = width * sign
+            if glasses:
+                self._part(
+                    face, "sphere", (x, height, depth - 0.023), (0.124, 0.116, 0.04), "#554a6a"
+                )
+                self._part(
+                    face, "sphere", (x, height, depth + 0.001), (0.100, 0.093, 0.029), "#dddef6"
+                )
+            self._part(
+                face, "sphere", (x, height, depth + 0.017), (0.053, tall * pose.eyes, 0.037), EYE
+            )
+            if pose.eyes > 0.5:
+                self._part(
+                    face,
+                    "sphere",
+                    (x - 0.017, height + 0.024, depth + 0.047),
+                    (0.017, 0.017, 0.009),
+                    "#ffffff",
+                    glow=0.6,
+                )
+            self._part(
+                face,
+                "sphere",
+                (x * 1.22, height - 0.105, depth - 0.02),
+                (0.065, 0.036, 0.026),
+                PINK,
+            )
+            if mood in {"curioso", "triste", "assustado", "surpreso"}:
+                angle = sign * (0.22 if mood == "surpreso" else -0.28)
+                self._part(
+                    face,
+                    "sphere",
+                    (x, height + 0.145, depth),
+                    (0.062, 0.017, 0.021),
+                    EYE,
+                    rotation=angle,
+                )
+
+    def _mouth(self, at: Matrix, mood: str, depth: float, y: float) -> None:
+        if mood in {"surpreso", "assustado"}:
+            self._part(at, "sphere", (0, y, depth), (0.059, 0.075, 0.025), EYE)
+            return
+        curve = -1 if mood == "triste" else 1
+        for x in (-0.055, -0.036, -0.016, 0.006, 0.027, 0.047, 0.061):
+            self._part(
+                at,
+                "sphere",
+                (x, y + curve * (x / 0.07) ** 2 * 0.027, depth),
+                (0.019, 0.016, 0.011),
+                EYE,
+            )
+
+    def character(self, item: Character, mood: str, pose: Pose, at: float) -> None:
+        z = 0.16
+        tone = item.color
+        light = _tone(tone, CREAM, 0.69)
+        dark = _tone(tone, INK, 0.40)
+        self.canvas.draw(
+            "plane", transform((pose.position, 0.012, z), (0.64, 1, 0.50)), "#211e37", shadow=0.33
+        )
+        base = transform((pose.position, pose.rise, z))
+        if item.species == "estrela":
+            float_y = 0.86 + math.sin(at * 2.2) * 0.078
+            face = (
+                base
+                @ transform((0, float_y, 0.055))
+                @ turn(pose.yaw + math.sin(at * 1.35) * 0.18, 1)
+                @ turn(pose.nod, 2)
+            )
+            self._part(face, "star", (0, 0, 0), (0.51, 0.51, 0.58), tone, glow=0.31)
+            self._eyes(
+                face, 0.137, 0.111, mood, pose, height=0.022, glasses=item.accessory == "oculos"
+            )
+            self._mouth(face, mood, 0.168, -0.122)
+            self._accessory(base, item, 0.50 + pose.rise, size=0.78)
+            return
+
+        self._part(base, "sphere", (0, 0.52, -0.03), (0.36, 0.46, 0.31), tone)
+        self._part(base, "sphere", (0, 0.49, 0.206), (0.264, 0.29, 0.096), light)
+        if item.species in {"cachorro", "gato"}:
+            self._part(
+                base, "sphere", (0.36, 0.39, -0.16), (0.12, 0.31, 0.12), tone, rotation=-0.79
+            )
+        for side in (-1, 1):
+            kick = pose.step * side
+            self._part(
+                base,
+                "sphere",
+                (side * 0.211, 0.131 + max(0.0, kick * 0.5), 0.19 + kick),
+                (0.155, 0.13, 0.23),
+                tone,
+            )
+            self._part(
+                base, "sphere", (side * 0.209, 0.117, 0.34 + kick), (0.09, 0.064, 0.057), light
+            )
+            angle = pose.arm if side == 1 else 0.10
+            joint = base @ transform((side * 0.302, 0.64, 0.064)) @ turn(angle, 2)
+            self._part(
+                joint,
+                "sphere",
+                (side * 0.045, -0.132, 0.058),
+                (0.096, 0.194, 0.103),
+                dark if item.species == "coruja" else tone,
+            )
+        self._accessory(base, item, 0.76)
+
+        neck = base @ transform((0, 1.03, 0.067))
+        face = neck @ turn(pose.yaw, 1) @ turn(pose.tilt, 0) @ turn(pose.nod, 2)
+        if item.species == "coelho":
+            for side in (-1, 1):
+                self._part(
+                    face,
+                    "sphere",
+                    (side * 0.204, 0.43, -0.035),
+                    (0.106, 0.279, 0.108),
+                    tone,
+                    rotation=-side * 0.18,
+                )
+                self._part(
+                    face,
+                    "sphere",
+                    (side * 0.203, 0.448, 0.053),
+                    (0.058, 0.197, 0.034),
+                    PINK,
+                    rotation=-side * 0.18,
+                )
+        if item.species in {"gato", "coruja"}:
+            for side in (-1, 1):
+                self._part(
+                    face,
+                    "sphere",
+                    (side * 0.252, 0.305, 0.016),
+                    (0.116, 0.161, 0.124),
+                    dark,
+                    rotation=-side * 0.38,
+                )
+        if item.species == "robo":
+            self._part(face, "sphere", (0, 0.37, 0.015), (0.035, 0.15, 0.035), dark)
+            self._part(face, "sphere", (0, 0.505, 0.015), (0.084, 0.084, 0.084), PINK, glow=0.15)
+            self._part(face, "sphere", (0, 0, -0.025), (0.451, 0.346, 0.349), tone)
+            self._part(face, "sphere", (0, 0.015, 0.25), (0.355, 0.263, 0.139), light)
+        else:
+            self._part(face, "sphere", (0, 0, 0), (0.427, 0.346, 0.328), tone)
+        if item.species == "cachorro":
+            for side in (-1, 1):
+                self._part(
+                    face,
+                    "sphere",
+                    (side * 0.389, -0.025, -0.014),
+                    (0.134, 0.265, 0.146),
+                    dark,
+                    rotation=side * 0.09,
+                )
+            self._part(face, "sphere", (-0.176, 0.043, 0.26), (0.151, 0.150, 0.09), dark)
+        if item.species == "coruja":
+            for side in (-1, 1):
+                self._part(
+                    face, "sphere", (side * 0.151, 0.009, 0.238), (0.193, 0.202, 0.105), light
+                )
+            self._part(face, "sphere", (0, -0.088, 0.331), (0.075, 0.092, 0.083), GOLD)
+        self._eyes(
+            face,
+            0.31 if item.species != "robo" else 0.382,
+            0.155,
+            mood,
+            pose,
+            glasses=item.accessory == "oculos",
+        )
+        depth = 0.351 if item.species not in {"cachorro", "gato", "coelho", "robo"} else 0.41
+        if item.species in {"cachorro", "gato", "coelho"}:
+            self._part(face, "sphere", (0, -0.117, 0.273), (0.206, 0.123, 0.144), light)
+            self._part(face, "sphere", (0, -0.083, 0.406), (0.067, 0.05, 0.035), EYE)
+        self._mouth(face, mood, depth, -0.165)
+
+    def _accessory(self, root: Matrix, character: Character, y: float, size: float = 1) -> None:
+        if character.accessory == "lenco":
+            self._part(root, "sphere", (0, y, 0.036), (0.325 * size, 0.075, 0.286 * size), MINT)
+            self._part(
+                root,
+                "sphere",
+                (0.20 * size, y - 0.13, 0.261),
+                (0.097, 0.176, 0.067),
+                MINT,
+                rotation=0.29,
+            )
+        if character.accessory == "gravata":
+            for sign in (-1, 1):
+                self._part(
+                    root,
+                    "sphere",
+                    (sign * 0.105 * size, y, 0.295),
+                    (0.11, 0.068, 0.045),
+                    PINK,
+                    rotation=sign * 0.26,
+                )
+            self._part(root, "sphere", (0, y, 0.326), (0.056, 0.047, 0.043), "#df788f")
+        if character.accessory == "broche":
+            self._part(root, "star", (0.148 * size, y - 0.09, 0.319), (0.081, 0.081, 0.12), GOLD)
+
+    def _room(
+        self, root: Matrix, sky: str, floor: str, wall: str, *, workshop: bool, night: bool
+    ) -> None:
+        for x, y, sx, sy in (
+            (-2.70, 2, 2.52, 3),
+            (2.28, 2, 1.13, 3),
+            (0.505, 4.24, 0.697, 1.2),
+            (0.505, 0.54, 0.697, 0.88),
+        ):
+            self._part(root, "box", (x, y, -3.05), (sx, sy, 0.12), wall)
+        for x in (-0.21, 0.51, 1.23):
+            self._part(root, "box", (x, 2.25, -2.90), (0.043, 0.88, 0.078), "#c3b6df")
+        for y in (1.39, 2.24, 3.11):
+            self._part(root, "box", (0.51, y, -2.9), (0.77, 0.043, 0.08), "#c3b6df")
+        self._part(root, "box", (0.53, 1.34, -2.83), (0.87, 0.048, 0.19), "#aca0c6")
+        light = "#fff0c2" if night else GOLD
+        self._part(root, "sphere", (0.76, 2.68, -4.05), (0.225, 0.225, 0.192), light, glow=0.88)
+        if night:
+            for x, y in ((0.22, 2.64), (0.90, 1.91), (0.30, 2.03), (0.12, 2.82)):
+                self._part(root, "star", (x, y, -3.7), (0.05, 0.05, 0.06), CREAM, glow=0.6)
+        self._part(root, "sphere", (0, 0.005, -0.1), (1.91, 0.014, 1.26), _tone(floor, sky, 0.64))
+        if workshop:
+            self._part(root, "box", (-1.38, 0.5, -2.30), (0.42, 0.50, 0.27), "#aa7787")
+            self._part(root, "box", (-1.38, 0.99, -2.3), (0.54, 0.067, 0.32), "#ecc898")
+        else:
+            self._part(root, "box", (-1.53, 0.35, -2.08), (0.43, 0.34, 0.35), "#9f79b3")
+            self._part(root, "sphere", (-1.53, 0.712, -2.08), (0.35, 0.072, 0.30), "#d8b4d2")
+
+    def _outdoor(
+        self, root: Matrix, sky: str, floor: str, background: str, setting: str, night: bool
+    ) -> None:
+        self._part(root, "sphere", (-2.8, -0.10, -5), (4.0, 0.65, 2.1), background)
+        self._part(root, "sphere", (3.2, -0.08, -6), (4.4, 0.78, 2.4), _tone(background, sky, 0.39))
+        self._part(
+            root,
+            "sphere",
+            (1.64, 3.21, -5.7),
+            (0.37, 0.37, 0.29),
+            CREAM if night else GOLD,
+            glow=0.9,
+        )
+        if night:
+            for x, y, z in (
+                (-1.8, 3.1, -4.9),
+                (-0.6, 3.52, -5),
+                (-1.05, 2.63, -5.2),
+                (1.07, 3.59, -6),
+                (2.84, 2.72, -6),
+            ):
+                self._part(root, "star", (x, y, z), (0.051, 0.051, 0.075), "#e8dafa", glow=0.75)
+        if setting == "rua":
+            for x, y in ((-1.92, 1.35), (1.70, 1.08), (2.9, 1.42)):
+                self._part(
+                    root, "box", (x, y, -3.8), (0.65, y, 0.43), _tone(background, "#8f6c95", 0.48)
+                )
+                for side in (-1, 1):
+                    self._part(
+                        root,
+                        "box",
+                        (x + side * 0.24, y + 0.3, -3.36),
+                        (0.105, 0.15, 0.017),
+                        GOLD,
+                        glow=0.28 if night else 0.0,
+                    )
+            self._part(root, "box", (0, 0.018, -0.30), (5, 0.014, 1.25), _tone(floor, sky, 0.35))
+            return
+        for x, y in (
+            ((-1.54, 1.27), (1.55, 1.42), (2.33, 1.76))
+            if setting == "bosque"
+            else ((-1.48, 0.51), (1.62, 0.61))
+        ):
+            if setting == "bosque":
+                self._part(root, "sphere", (x, y * 0.62, -2.8), (0.12, y * 0.66, 0.12), "#625066")
+            self._part(
+                root, "sphere", (x, y, -2.75), (0.53, y * 0.58, 0.44), _tone(floor, "#69a899", 0.44)
+            )
+            self._part(
+                root,
+                "sphere",
+                (x + 0.31, y * 0.88, -2.59),
+                (0.31, y * 0.43, 0.34),
+                _tone(floor, "#7db799", 0.51),
+            )
+        for x, z in ((-1.52, -0.49), (1.28, -0.61), (1.57, -0.85)):
+            self._part(root, "sphere", (x, 0.088, z), (0.043, 0.095, 0.034), "#6aaf9e")
+            self._part(root, "sphere", (x, 0.174, z), (0.071, 0.054, 0.055), "#bca5da")
+
+    def _prop(self, kind: str, at: float) -> None:
+        if kind == "nenhum":
+            return
+        root = transform((0.03, 0.14, 0.59))
+        if kind == "estrela":
+            self._part(
+                root,
+                "star",
+                (0, 0.15 + 0.04 * math.sin(at * 3), 0),
+                (0.23, 0.23, 0.30),
+                GOLD,
+                rotation=0.14,
+                glow=0.36,
+            )
+        elif kind == "bola":
+            self._part(root, "sphere", (0, 0.019, 0), (0.157, 0.157, 0.157), PINK)
+        elif kind in {"bilhete", "livro"}:
+            self._part(
+                root,
+                "box",
+                (0, 0.01, 0),
+                (0.20, 0.042, 0.127),
+                CREAM if kind == "bilhete" else "#ab8fd0",
+            )
+            self._part(root, "box", (0, 0.034, 0.125), (0.175, 0.019, 0.006), "#f1e4ca")
+        elif kind == "chave":
+            self._part(root, "sphere", (-0.105, -0.011, 0.021), (0.089, 0.046, 0.083), GOLD)
+            self._part(root, "sphere", (0.042, -0.009, 0.021), (0.171, 0.037, 0.033), GOLD)
+            self._part(root, "box", (0.172, -0.013, 0.069), (0.021, 0.022, 0.062), GOLD)
+        elif kind == "lanterna":
+            self._part(root, "sphere", (0, 0.024, 0), (0.20, 0.112, 0.11), MINT)
+            self._part(root, "sphere", (0.127, 0.024, 0), (0.10, 0.13, 0.13), GOLD, glow=0.48)
+        elif kind == "semente":
+            self._part(
+                root, "sphere", (0, -0.015, 0.02), (0.102, 0.11, 0.079), "#e5b374", rotation=0.58
+            )
+            self._part(
+                root, "sphere", (0.052, 0.072, 0.012), (0.073, 0.038, 0.046), MINT, rotation=0.26
+            )
+
+    def frame(
+        self, scene: Scene, cast: dict[str, Character], at: float, duration: float
+    ) -> Image.Image:
+        sky, floor, background = SKIES[scene.light]
+        indoors = scene.setting in {"quarto", "oficina"}
+        closeness = PITCHES[scene.shot]
+        if len(scene.characters) > 1:
+            closeness = max(38, closeness)
+        camera_shift = (
+            (0.24 * (at / max(duration, 0.01) - 0.5)) if scene.shot == "acompanhar" else 0.0
+        )
+        self.canvas.start(
+            (camera_shift + 0.075 * math.sin(at * 0.87), 2.28, 6.8),
+            (camera_shift, 1.55, 0),
+            closeness,
+            sky,
+            float(scene.light == "noite"),
+        )
+        world = transform()
+        self._part(world, "box", (0, -0.17, -1), (9, 0.17, 10), floor)
+        if indoors:
+            self._room(
+                world,
+                sky,
+                floor,
+                background,
+                workshop=scene.setting == "oficina",
+                night=scene.light == "noite",
+            )
+        else:
+            self._outdoor(world, sky, floor, background, scene.setting, scene.light == "noite")
+        positions = {place.character: POSITIONS[place.position] for place in scene.placements}
+        defaults = (
+            (0.0,) if len(scene.characters) == 1 else (POSITIONS["esquerda"], POSITIONS["direita"])
+        )
+        spare = [x for x in (*defaults, *POSITIONS.values()) if x not in positions.values()]
+        for i, key in enumerate(scene.characters):
+            position = positions[key] if key in positions else spare.pop(0)
+            self.character(cast[key], scene.mood, _pose(scene, i, at, duration, position), at)
+        self._prop(scene.prop, at)
+        return self.canvas.image()
+
+    def portrait(self, character: Character) -> Image.Image:
+        self.canvas.start((0.20, 1.66, 4.1), (0, 0.81, 0), 31, "#d7d2e8", 0.05)
+        self._part(transform(), "box", (0, -0.17, 0), (6, 0.17, 6), "#bab6d2")
+        self.character(character, "feliz", Pose(0, yaw=-0.14), 0)
+        return self.canvas.image()
+
+
+def reference(cache: Path, character: Character) -> Path:
