+"""Brazilian Portuguese inference for the pinned Kokoro 82M ONNX export."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import unicodedata
+from pathlib import Path
+
+import numpy as np
+
+from .. import paths
+
+MODEL = "model_quantized.onnx"
+VOICES = {"pf_dora": "Dora", "pm_alex": "Alex", "pm_santa": "Santa"}
+RATE = 24_000
+PHONEME_PAIRS = {"tʃ": "ʧ", "dʒ": "ʤ", "t͡s": "ʦ", "d͡z": "ʣ"}
+
+
+def directory() -> Path:
+    configured = os.environ.get("AI_SHORTS_STORY_KOKORO")
+    return (
+        Path(configured).expanduser().resolve()
+        if configured
+        else paths.root() / "stories" / "kokoro"
+    )
+
+
+def espeak_data() -> Path:
+    from piper.phonemize_espeak import ESPEAK_DATA_DIR
+
+    if os.name == "nt":
+        # Native eSpeak can reject accented absolute paths. Only the speech worker
+        # changes directory, leaving the Studio and the user's terminal alone.
+        os.chdir(ESPEAK_DATA_DIR.parent)
+        os.environ["ESPEAK_DATA_PATH"] = "."
+        return Path("espeak-ng-data")
+    return ESPEAK_DATA_DIR
+
+
+class KokoroVoice:
+    def __init__(self, voice_file: Path) -> None:
+        import onnxruntime as ort
+        from piper.phonemize_espeak import EspeakPhonemizer
+
+        folder = voice_file.parent
+        self.vocab = json.loads((folder / "config.json").read_text(encoding="utf-8"))["vocab"]
+        self.styles = np.fromfile(voice_file, dtype="<f4").reshape(-1, 256)
+        config = ort.SessionOptions()
+        config.intra_op_num_threads = 3
+        config.inter_op_num_threads = 1
+        self.session = ort.InferenceSession(
+            str(folder / MODEL), sess_options=config, providers=["CPUExecutionProvider"]
+        )
+        self.phonemizer = EspeakPhonemizer(espeak_data())
+        self.ids_input = self.session.get_inputs()[0].name
+
+    def speak(self, sentence: str, speed: float) -> np.ndarray:
+        parts = self.phonemizer.phonemize("pt-br", sentence)
+        phonemes = " ".join("".join(part) for part in parts)
+        phonemes = unicodedata.normalize("NFD", phonemes.replace("g", "ɡ"))
+        for pair, token in PHONEME_PAIRS.items():
+            phonemes = phonemes.replace(pair, token)
+        # Preserve the nasal diphthong at the end of Brazilian words such as "tem".
+        phonemes = re.sub(r"eɪ[ŋm](?=$|[\s.,!?;:])", "ẽɪ̃", phonemes)
+        ids = [self.vocab[symbol] for symbol in phonemes.strip() if symbol in self.vocab]
+        if not 0 < len(ids) <= len(self.styles):
+            raise ValueError("Divida a fala em frases curtas com texto pronunciável.")
+        waveform = self.session.run(
+            None,
+            {
+                self.ids_input: np.asarray([[0, *ids, 0]], dtype=np.int64),
+                "style": self.styles[len(ids) - 1 : len(ids)],
+                "speed": np.asarray([speed], dtype=np.float32),
+            },
+        )[0]
+        return np.asarray(waveform, dtype=np.float32).reshape(-1)
