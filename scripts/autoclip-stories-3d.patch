+def _write_frames(
+    draw: DrawFrame,
+    timeline: narration.Timeline,
+    folder: Path,
+    count: int,
+    fps: int,
+    cancelled: Callable[[], bool],
+    report: Report,
+    ballot: Image.Image | None,
+) -> None:
+    report("quadros", 0, count, "Renderizando os quadros da história")
+    scene_index = 0
+    previous, fade_from = None, None
+    for index in range(count):
+        check_cancelled(cancelled)
+        at = index / fps
+        while at >= timeline.boundaries[scene_index + 1]:
+            scene_index += 1
+            fade_from = previous
+        start, end = timeline.boundaries[scene_index : scene_index + 2]
+        elapsed = at - start
+        frame = draw(scene_index, elapsed, end - start)
+        if fade_from is not None and elapsed < 0.23:
+            frame = Image.blend(fade_from, frame, min(1.0, (elapsed + 0.04) / 0.23))
+        previous = frame
+        if ballot is not None and timeline.ballot_start is not None and at >= timeline.ballot_start:
+            frame = frame.copy()
+            frame.paste(ballot, (54, 241), ballot)
+        frame.save(folder / f"{index:05d}.png", compress_level=1)
+        if (index + 1) % fps == 0:
+            report("quadros", index + 1, count, "Renderizando os quadros da história")
