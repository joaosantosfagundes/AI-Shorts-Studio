+    folder: Path,
+    output: Path,
+    count: int,
+    fps: int,
+    cancelled: Callable[[], bool],
+    report: Report,
+) -> None:
+    total = len(timeline.cues)
+    report("legendas", 0, total, "Sincronizando as frases com a voz usada")
+    overlays = _captions(timeline, output)
+    for index, cue in enumerate(timeline.cues, start=1):
+        start = math.ceil(cue.start * fps)
+        end = min(count, math.ceil(cue.end * fps))
+        for number in range(start, end):
+            check_cancelled(cancelled)
+            filename = folder / f"{number:05d}.png"
+            with Image.open(filename) as source:
+                frame = source.copy()
+            overlay = overlays[cue.text]
+            frame.paste(overlay, (0, 167), overlay)
+            frame.save(filename, compress_level=1)
+        report("legendas", index, total, "Tempos medidos do áudio")
+
