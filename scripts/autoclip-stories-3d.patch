+import { useEffect, useState } from 'react'
+
+import { SETTINGS, type EpisodeNotes, type StoryProject } from '../../stories'
+import { Select } from './Editor'
+
+const choiceFields = ['question', 'plan_a', 'plan_b'] as const
+const recapFields = { summary: 'Resumo do episódio', events: 'Acontecimentos importantes', mysteries: 'Mistérios em aberto' } as const
+const ballotLabels = { question: 'Pergunta ao público', plan_a: 'Plano A', plan_b: 'Plano B' }
+
+export function Episode({ project, busy, dirty, onSave, onStart, onContinue }: {
+  project: StoryProject
+  busy: boolean
+  dirty: boolean
+  onSave: (notes: EpisodeNotes) => void
+  onStart: (title: string) => void
+  onContinue: (idea: string) => void
+}) {
+  const [notes, setNotes] = useState(project.notes)
+  const [title, setTitle] = useState('')
+  const [idea, setIdea] = useState('')
+  const series = project.series
+  const previous = series?.previous
+  const stored = JSON.stringify(project.notes)
+  const changed = JSON.stringify(notes) !== stored
+  const changedChoices = choiceFields.some((key) => project.notes[key] !== notes[key])
+  const hasVote = !!project.notes.vote || !project.notes.question
+  const choices = choiceFields.filter((key) => notes[key].trim()).length
+  const approved = project.approved && !dirty
+  const locked = !!series && !series.latest
+  useEffect(() => { setNotes(JSON.parse(stored) as EpisodeNotes) }, [stored])
+
+  return (
+    <section className="panel p-4 sm:p-5" aria-labelledby="episode-title">
+      <h2 className="panel-title" id="episode-title">{series?.title ?? 'Série e final interativo'}</h2>
+      {series && <p className="mt-1 text-sm font-semibold text-ink-500">Episódio {series.number}</p>}
+      {previous && <details className="mt-3 rounded-lg border border-ink-800 p-3 text-sm">
+        <summary className="cursor-pointer font-semibold">De onde o episódio continua</summary>
+        <p className="mt-2 break-words font-semibold">{previous.title}</p>
+        <p className="mt-1 whitespace-pre-wrap break-words">{previous.summary}</p>
+        {previous.events && <p className="mt-2 break-words"><strong>Acontecimentos · </strong>{previous.events}</p>}
+        {previous.mysteries && <p className="mt-2 break-words"><strong>Mistérios · </strong>{previous.mysteries}</p>}
+        <p className="mt-2 break-words"><strong>Cenários · </strong>{previous.settings.map((setting) => SETTINGS[setting]).join(', ')}</p>
+        <p className="mt-2 break-words"><strong>Final · </strong>{previous.ending}</p>
+        {previous.chosen_plan && <p className="mt-2 break-words"><strong>Escolha registrada · </strong>{previous.chosen_plan}</p>}
+      </details>}
+      <fieldset disabled={busy} className="mt-3 grid min-w-0 gap-3">
+        <details className="rounded-lg border border-ink-800 p-3 text-sm">
+          <summary className="cursor-pointer font-semibold">Notas e final interativo</summary>
+          <div className="mt-3 grid gap-3">
+            {(Object.entries(recapFields) as [keyof typeof recapFields, string][]).map(([key, label]) => (
+              <label key={key} className="grid gap-1.5 font-semibold">
+                {label}
+                <textarea className="field min-h-14 resize-y font-normal" maxLength={400} value={notes[key]}
+                  placeholder={key === 'summary' ? project.script?.synopsis : undefined}
+                  onChange={(e) => setNotes({ ...notes, [key]: e.target.value })} />
+              </label>
+            ))}
+            {choiceFields.map((key) => <label key={key} className="grid gap-1.5 font-semibold">
+              {ballotLabels[key]}
+              <input className="field font-normal" maxLength={key === 'question' ? 72 : 80}
+                value={notes[key]} disabled={locked}
+                onChange={(e) => setNotes({ ...notes, [key]: e.target.value, vote: null })} />
+            </label>)}
+            <Select label="Resultado informado manualmente" value={notes.vote ?? 'pendente'}
+              values={{ pendente: 'Aguardando resultado', a: 'Plano A venceu', b: 'Plano B venceu' }}
+              disabled={locked || !project.notes.question || changedChoices}
+              onChange={(vote) => setNotes({ ...notes, vote: vote === 'pendente' ? null : vote })} />
+            {choices > 0 && choices < 3 && <p className="text-ink-500">Preencha a pergunta e os dois planos.</p>}
+            {locked && <p className="text-ink-500">O episódio seguinte já usa este final.</p>}
+            <button type="button" className="btn btn-ghost justify-self-start" disabled={!changed || choices === 1 || choices === 2}
+              onClick={() => onSave(notes)}>Salvar detalhes do episódio</button>
+          </div>
+        </details>
+        {series ? series.latest && (
+          <div className="grid gap-2">
+            <label className="grid gap-1.5 text-sm font-semibold">
+              Ideia para o próximo episódio (opcional)
+              <textarea className="field min-h-16 resize-y font-normal" maxLength={1200} value={idea}
+                onChange={(e) => setIdea(e.target.value)} />
+            </label>
+            {!hasVote && <p className="text-xs text-ink-500">Registre o resultado da votação para continuar.</p>}
+            <button type="button" className="btn btn-ghost justify-self-start"
+              disabled={!approved || !hasVote || changed || (idea.trim().length > 0 && idea.trim().length < 4)}
+              onClick={() => onContinue(idea)}>Criar episódio seguinte</button>
+          </div>
+        ) : (
+          <div className="grid gap-2">
+            <label className="grid gap-1.5 text-sm font-semibold">
+              Nome da série
+              <input className="field font-normal" maxLength={100} value={title} onChange={(e) => setTitle(e.target.value)} />
+            </label>
+            <button type="button" className="btn btn-ghost justify-self-start" disabled={!approved || !title.trim() || changed}
+              onClick={() => onStart(title)}>Iniciar série com esta história</button>
+            {!approved && <p className="text-xs text-ink-500">Aprove o roteiro para usar este elenco na série.</p>}
+          </div>
+        )}
+      </fieldset>
+    </section>
+  )
+}
