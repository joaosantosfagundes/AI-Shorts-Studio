+def _wrap(text: str, font: ImageFont.FreeTypeFont, width: int) -> list[str]:
+    rows: list[str] = []
+    line = ""
+    for word in text.split():
+        proposal = f"{line} {word}".strip()
+        if font.getlength(proposal) <= width:
