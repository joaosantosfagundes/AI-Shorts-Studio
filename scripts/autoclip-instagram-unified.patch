+def authorization_status(account: sqlite3.Row | dict, config: MetaConfig, now: int) -> str:
+    if not account["connected"]:
+        return "disconnected"
+    if not matches_config(account, config) or account["auth_needed"]:
+        return "reconnect"
+    if account["token_expires_at"] is not None and account["token_expires_at"] <= now:
+        return "expired"
+    return "connected"
+
