@@ -0,0 +1,97 @@
+"""Generate a local-only TLS certificate for the Unified Login callback."""
+
+from __future__ import annotations
+
+import argparse
+import ipaddress
+import os
+import ssl
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from tempfile import NamedTemporaryFile
+
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import rsa
+from cryptography.x509.oid import ExtendedKeyUsageOID, NameOID
+
+SERVER_CERT = "localhost-server.pem"
+PUBLIC_CERT = "localhost.cer"
+
+
+def _replace_file(path: Path, content: bytes) -> None:
+    with NamedTemporaryFile(dir=path.parent, delete=False) as handle:
+        temporary = Path(handle.name)
+        try:
+            handle.write(content)
+            handle.close()
+            os.replace(temporary, path)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+
+def prepare_certificate(directory: Path, *, renew: bool = False) -> tuple[Path, str]:
+    directory.mkdir(parents=True, exist_ok=True)
+    bundle = directory / SERVER_CERT
+    now = datetime.now(UTC)
+    if bundle.exists() and not renew:
+        ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER).load_cert_chain(bundle)
+        certificate = x509.load_pem_x509_certificate(bundle.read_bytes())
+        if not certificate.not_valid_before_utc <= now < certificate.not_valid_after_utc:
+            raise ValueError("O certificado venceu. Execute a preparação com -Renovar.")
+    else:
+        key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+        identity = x509.Name(
+            [
+                x509.NameAttribute(NameOID.COMMON_NAME, "localhost"),
+                x509.NameAttribute(NameOID.ORGANIZATION_NAME, "AI Shorts Studio"),
+            ]
+        )
+        certificate = (
+            x509.CertificateBuilder()
+            .subject_name(identity)
+            .issuer_name(identity)
+            .public_key(key.public_key())
+            .serial_number(x509.random_serial_number())
+            .not_valid_before(now - timedelta(minutes=5))
+            .not_valid_after(now + timedelta(days=365))
+            .add_extension(x509.BasicConstraints(ca=False, path_length=None), critical=True)
+            .add_extension(x509.ExtendedKeyUsage([ExtendedKeyUsageOID.SERVER_AUTH]), critical=False)
+            .add_extension(
+                x509.SubjectAlternativeName(
+                    [
+                        x509.DNSName("localhost"),
+                        x509.IPAddress(ipaddress.ip_address("127.0.0.1")),
+                        x509.IPAddress(ipaddress.ip_address("::1")),
+                    ]
+                ),
+                critical=False,
+            )
+            .sign(key, hashes.SHA256())
+        )
+        private_pem = key.private_bytes(
+            serialization.Encoding.PEM,
+            serialization.PrivateFormat.PKCS8,
+            serialization.NoEncryption(),
+        )
+        _replace_file(bundle, certificate.public_bytes(serialization.Encoding.PEM) + private_pem)
+    public = directory / PUBLIC_CERT
+    _replace_file(public, certificate.public_bytes(serialization.Encoding.DER))
+    return public, certificate.fingerprint(hashes.SHA256()).hex().upper()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("directory", type=Path)
+    parser.add_argument("--renew", action="store_true")
+    args = parser.parse_args()
+    try:
+        public, fingerprint = prepare_certificate(args.directory, renew=args.renew)
+    except (OSError, ValueError) as error:
+        parser.exit(1, f"Falha ao preparar o certificado local: {error}\n")
+    print(f"Certificado público: {public}")
+    print(f"SHA-256: {fingerprint}")
+
+
+if __name__ == "__main__":
+    main()
