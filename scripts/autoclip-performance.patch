+@pytest.mark.slow
+@pytest.mark.skipif(not shutil.which("ffmpeg"), reason="FFmpeg is not installed")
+def test_fast_export_retries_nvenc_with_real_libx264(tmp_path, monkeypatch):
+    source = tmp_path / "origem.mp4"
+    ffmpeg.run(
+        [
+            "-f",
+            "lavfi",
+            "-i",
+            "color=size=320x180:rate=24",
+            "-f",
+            "lavfi",
+            "-i",
+            "sine=frequency=900:sample_rate=48000",
+            "-t",
+            "1.2",
+            "-c:v",
+            "libx264",
+            "-c:a",
+            "aac",
+            str(source),
+        ]
+    )
+    destination = tmp_path / "rápido.mp4"
+    settings = config.ExportSettings(resolution="720p", prefer_hardware_encoder=True)
+    monkeypatch.setattr(
+        export, "report", lambda: SimpleNamespace(ffmpeg=SimpleNamespace(nvenc_works=True))
+    )
+    run = ffmpeg.run
+    encoders = []
+
+    def fail_nvenc(args, **kwargs):
+        encoder = args[args.index("-c:v") + 1]
+        encoders.append(encoder)
+        if encoder == "h264_nvenc":
+            raise ffmpeg.FFmpegError("Failed", command=args, stderr="Cannot load NVENC")
+        return run(args, **kwargs)
+
+    monkeypatch.setattr(ffmpeg, "run", fail_nvenc)
+    request = export.ExportRequest(
+        source,
+        destination,
+        0,
+        1,
+        centre_crop(320, 180, 1),
+        [Word("Teste", 0.1, 0.8)],
+        export.captions_module.get_style("clean_lower"),
+    )
+    export.export_clip(request, work_dir=tmp_path / "render", settings=settings)
+    output = ffmpeg.probe(destination)
+    assert encoders == ["h264_nvenc", "libx264"]
+    assert (output.width, output.height, output.video_codec, output.audio_codec) == (
+        720,
+        1280,
+        "h264",
+        "aac",
+    )
+    assert not list(tmp_path.glob("*.part.mp4"))
