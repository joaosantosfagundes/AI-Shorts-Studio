+def for_job(snapshot: dict[str, Any]) -> Settings:
+    """Restore per-job choices while keeping credentials in the current secret store."""
+    current = load()
+    if not snapshot:
+        return current
+    payload = current.model_dump(mode="json")
+    for key, value in snapshot.items():
+        if key not in payload:
+            continue
+        previous = payload[key]
+        if isinstance(previous, dict) and isinstance(value, dict):
+            payload[key] = previous | value
+        else:
+            payload[key] = value
+    settings = Settings.model_validate(payload)
+    settings._fallback_secrets = current._fallback_secrets.copy()
     return settings
 
 
