+"""Regressions for stalled processes, checkpointing, and fast exports."""
+
+from __future__ import annotations
+
+import json
+import shutil
+import sys
+import time
+import wave
+from types import SimpleNamespace
+
+import pytest
+from autoclip import config, db
+from autoclip.db import store
+from autoclip.db.models import Job, Source
+from autoclip.db.schema import MIGRATIONS
+from autoclip.pipeline import Cancelled, Stage, export, ffmpeg, prepare, process, transcribe
+from autoclip.pipeline.reframe.croppath import centre_crop
+from autoclip.pipeline.runner import PipelineRunner
+from autoclip.pipeline.transcript import Segment, Transcript, Word
+
+
+def test_process_drains_stderr_and_stops_when_timestamp_repeats():
+    updates = []
+    child = (
+        "import sys, time; "
+        "print('diagnostic!' * 20000, file=sys.stderr, flush=True); "
+        "print('out_time_us=1000000', flush=True); "
+        "time.sleep(0.15); print('out_time_us=1000000', flush=True); time.sleep(60)"
+    )
+    result = process.run(
+        [sys.executable, "-c", child],
+        label="fixture",
+        parse=ffmpeg._parse_progress,
+        idle_timeout_s=0.8,
+        on_progress=updates.append,
+        kill_tree=True,
+    )
+    assert result.stalled
+    assert result.code != 0
+    assert result.progress.position == 1
+    assert updates == [process.Update(1)]
+    assert "diagnostic!" in result.stderr
+
+
+def test_cancel_interrupts_a_silent_process():
+    start = time.monotonic()
+    with pytest.raises(Cancelled):
+        process.run(
+            [sys.executable, "-c", "import time; time.sleep(60)"],
+            label="fixture",
+            parse=ffmpeg._parse_progress,
+            idle_timeout_s=30,
+            cancelled=lambda: time.monotonic() - start > 0.2,
+            kill_tree=True,
+        )
+    assert time.monotonic() - start < 5
+
+
+def test_old_jobs_survive_migration_and_store_stage_progress(autoclip_home):
+    conn = db.connect()
+    with conn:
+        MIGRATIONS[0](conn)
+        conn.execute("PRAGMA user_version = 1")
+        conn.execute(
+            "INSERT INTO sources(id, type, path, created_at) VALUES ('s','upload','old', '')"
+        )
+        conn.execute(
+            "INSERT INTO jobs (id,source_id,status,progress,settings_json,created_at,updated_at) "
+            "VALUES ('j','s','failed',0.05,?, '', '')",
+            (json.dumps({"clips": {"max_clips": 2}}),),
+        )
+    conn.close()
+    db.init()
+    original = store.get_job("j")
+    assert original and original.progress == 0.05 and original.stage_progress == 0
+    assert config.for_job(original.settings).clips.max_clips == 2
+    assert store.retry_job("j")
+    assert not store.retry_job("j")
+    assert store.claim_job("j")
+    store.update_job("j", stage_progress=0.5, progress_message="Bloco 1 de 2")
+    updated = store.get_job("j")
+    assert updated and updated.stage_progress == 0.5 and updated.progress_message == "Bloco 1 de 2"
+
+
+def test_prepare_reuses_intact_audio_and_skips_unused_thumbnails(monkeypatch, tmp_path):
+    db.init()
+    video = tmp_path / "Caminho com acento ç.mp4"
+    video.touch()
+    source = store.create_source(Source("src", "upload", str(video), duration_s=2.0))
+    job = store.create_job(Job("job", source.id, settings={"export": {"resolution": "720p"}}))
+    events = []
+    runner = PipelineRunner(job, source, on_progress=events.append)
+    runner.workspace.audio.write_bytes(b"RIFF0000WAVE")
+    assert prepare.audio_duration(runner.workspace.audio) is None
+
+    def extract(_source, output, *, on_progress, **_options):
+        _write_wav(output, 2)
+        on_progress(0.5)
+        on_progress(1.0)
+
+    monkeypatch.setattr(
+        ffmpeg, "probe", lambda _: SimpleNamespace(has_audio=True, audio_duration_s=2)
+    )
+    monkeypatch.setattr(prepare, "extract_audio", extract)
+    monkeypatch.setattr(prepare, "detect_silences", lambda *a, **kw: [prepare.Silence(0, 1)])
+    audio, silences = runner._stage_prepare()
+    assert prepare.audio_duration(audio) == 2
+    assert silences == [prepare.Silence(0, 1)]
+    assert not (runner.workspace.root / "thumbnails").exists()
+    assert all(evt.stage == Stage.PREPARE for evt in events)
+    assert events[-1].overall == 0.05
+    assert any("Extraindo" in evt.message for evt in events)
+    assert runner.settings.export.resolution == "720p"
+
+    def unexpected(*_args, **_kwargs):
+        pytest.fail("already completed work ran again")
+
+    monkeypatch.setattr(prepare, "extract_audio", unexpected)
+    monkeypatch.setattr(prepare, "detect_silences", unexpected)
+    restarted = PipelineRunner(job, source)
+    assert restarted._stage_prepare() == (audio, silences)
+
+
+def _write_wav(path, duration):
+    with wave.open(str(path), "wb") as wav:
+        wav.setparams((1, 2, 16000, 0, "NONE", "not compressed"))
+        wav.writeframes(bytes(duration * 16000 * 2))
+
+
+def test_whisper_resumes_from_completed_blocks_including_silence(tmp_path, monkeypatch):
+    monkeypatch.setattr(transcribe, "BLOCK_SECONDS", 4)
+    monkeypatch.setattr(transcribe, "OVERLAP_SECONDS", 1)
+    audio = tmp_path / "prepared.wav"
+    checkpoints = tmp_path / "blocks"
+    _write_wav(audio, 10)
+    settings = config.WhisperSettings(device="cpu", language="pt")
+
+    def transcribe_block(samples, language, offset, start, end, report):
+        assert language == "pt" and offset <= start < end
+        assert len(samples) <= 6 * 16000
+        if start == 4:
+            return Transcript(language="pt")
+        report(start + 0.4)
+        word = Word(f"{start:g}", start + 0.1, start + 0.4)
+        return Transcript(
+            language="pt", words=[word], segments=[Segment(word.text, word.start, word.end)]
+        )
+
+    def interrupted(samples, language, offset, start, end, report):
+        if start == 8:
+            raise Cancelled("interrupted")
+        return transcribe_block(samples, language, offset, start, end, report)
+
+    with pytest.raises(Cancelled):
+        transcribe._transcribe_wav(
+            audio, settings, "cpu", checkpoints, lambda *_: None, interrupted
+        )
+    assert len(list(checkpoints.rglob("*.json"))) == 2
+    starts = []
+
+    def resumed(samples, language, offset, start, end, report):
+        starts.append(start)
+        return transcribe_block(samples, language, offset, start, end, report)
+
+    result = transcribe._transcribe_wav(
+        audio, settings, "cpu", checkpoints, lambda *_: None, resumed
+    )
+    assert starts == [8]
+    assert [word.start for word in result.words] == [0.1, 8.1]
+    assert [segment.first_word for segment in result.segments] == [0, 1]
+
