+"""Monitor local media subprocesses without blocking on either output pipe."""
+
+from __future__ import annotations
+
+import logging
+import os
+import subprocess
+import threading
+import time
+from collections import deque
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import TextIO
+
+from . import Cancelled
+
+log = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class Update:
+    position: float
+    message: str = ""
+
+
+@dataclass(frozen=True)
+class Result:
+    code: int
+    stderr: str
+    progress: Update
+    stalled: bool
+
+
+def run(
+    command: Sequence[str],
+    *,
+    label: str,
+    parse: Callable[[str], Update | None],
+    idle_timeout_s: float,
+    on_progress: Callable[[Update], None] | None = None,
+    cancelled: Callable[[], bool] | None = None,
+    cwd: Path | None = None,
+    on_stderr: Callable[[str], None] | None = None,
+    kill_tree: bool = False,
+) -> Result:
+    if cancelled and cancelled():
+        raise Cancelled("Processamento cancelado.")
+
+    latest = Update(0)
+    tail: deque[str] = deque(maxlen=40)
+    reader_error: Exception | None = None
+
+    def read_stdout(lines: TextIO) -> None:
+        nonlocal latest, reader_error
+        for line in lines:
+            try:
+                update = parse(line)
+                if update is not None and update.position >= latest.position:
+                    latest = update
+            except Exception as exc:
+                reader_error = exc
+
+    def read_stderr(lines: TextIO) -> None:
+        nonlocal reader_error
+        for line in lines:
+            tail.append(line.rstrip()[-2000:])
+            if on_stderr and reader_error is None:
+                try:
+                    on_stderr(line)
+                except Exception as exc:
+                    reader_error = exc
+
+    started_at = time.monotonic()
+    with subprocess.Popen(
+        command,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        cwd=cwd,
+    ) as child:
+        log.info("%s PID %d: %s", label, child.pid, subprocess.list2cmdline(command))
+        assert child.stdout is not None and child.stderr is not None
+        readers = [
+            threading.Thread(target=read_stdout, args=(child.stdout,), daemon=True),
+            threading.Thread(target=read_stderr, args=(child.stderr,), daemon=True),
+        ]
+        reported = Update(0)
+        last_advance = started_at
+        stalled = False
+        try:
+            for reader in readers:
+                reader.start()
+            while child.poll() is None:
+                if cancelled and cancelled():
+                    raise Cancelled("Processamento cancelado.")
+                update = latest
+                now = time.monotonic()
+                if update != reported:
+                    reported = update
+                    last_advance = now
+                    if on_progress:
+                        on_progress(update)
+                if now - last_advance >= idle_timeout_s:
+                    stalled = True
+                    break
+                try:
+                    child.wait(timeout=0.2)
+                except subprocess.TimeoutExpired:
+                    continue
+        finally:
+            if child.poll() is None:
+                _stop(child, kill_tree=kill_tree)
+            code = child.wait()
+            for reader in readers:
+                if reader.ident is not None:
+                    reader.join()
+            log.info(
+                "%s PID %d terminou em %.1f s (código %d, posição %.3f).",
+                label,
+                child.pid,
+                time.monotonic() - started_at,
+                code,
+                latest.position,
+            )
+            if tail and (code != 0 or label == "Whisper"):
+                log.info("Saída de %s PID %d:\n%s", label, child.pid, "\n".join(tail))
+
+    if reader_error:
+        raise reader_error
+    if cancelled and cancelled():
+        raise Cancelled("Processamento cancelado.")
+    if not stalled and code == 0 and latest != reported and on_progress:
+        on_progress(latest)
+    return Result(code, "\n".join(tail), latest, stalled)
+
+
+def _stop(child: subprocess.Popen[str], *, kill_tree: bool) -> None:
+    if os.name == "nt" and kill_tree:
+        # Python's Windows venv redirector can leave its child holding our pipes.
+        try:
+            subprocess.run(
+                ["taskkill.exe", "/PID", str(child.pid), "/T", "/F"],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                timeout=5,
+                check=False,
+            )
+        except (OSError, subprocess.SubprocessError):
+            log.warning("Não foi possível encerrar a árvore do PID %d.", child.pid)
+    if child.poll() is None:
+        child.kill()
