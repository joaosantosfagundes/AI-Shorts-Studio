+def _safe_meta_message(error: dict, code: int | None, subcode: int | None, fallback: str) -> str:
+    # Meta may echo request parameters and identifiers in the error text.
+    # Classify the reason and emit only messages defined here.
+    raw = error.get("message")
+    message = raw[:2048].lower() if isinstance(raw, str) else ""
+    if "redirect_uri" in message and any(
+        word in message for word in ("same", "match", "identical", "missing", "required", "invalid")
+    ):
+        return "A Meta rejeitou a Redirect URI na validação do código."
+    if "verification code" in message or "authorization code" in message:
+        return "A Meta rejeitou o código de autorização. Inicie um novo login."
+    if "appsecret_proof" in message:
+        return "A Meta rejeitou a prova de autenticação do aplicativo."
+    if "client_secret" in message or "app secret" in message:
+        return "A Meta indicou um problema com o segredo do aplicativo."
+    if "input_token" in message:
+        return "A Meta rejeitou o token enviado para inspeção."
+    if code == 100 and (subcode == 33 or "unsupported get request" in message):
+        return "A Meta recusou a leitura do recurso. Confira o acesso concedido ao aplicativo."
+    if code == 100:
+        return "A Meta rejeitou um parâmetro da solicitação."
+    return fallback
+
+
+def _graph_error(status: int, error: object, private: tuple[str, ...]) -> MetaRequestError:
+    error = error if isinstance(error, dict) else {}
+    code = error.get("code")
+    code = code if type(code) is int else None
+    subcode = error.get("error_subcode", error.get("subcode"))
+    subcode = subcode if type(subcode) is int else None
+    trace = error.get("fbtrace_id")
+    detail = f" Código {code}." if code is not None else ""
+    diagnostic = [f"http={status}"]
+    if code is not None:
+        diagnostic.append(f"codigo={code}")
+    if subcode is not None:
+        diagnostic.append(f"subcodigo={subcode}")
+    if (
+        isinstance(trace, str)
+        and re.fullmatch(r"[A-Za-z0-9_-]{1,80}", trace)
+        and not any(value and value in trace for value in private)
+    ):
+        detail += f" Referência {trace}."
+        diagnostic.append(f"referencia={trace}")
+    auth = status == 401 or code in {102, 190}
+    retry = not auth and (
+        status == 429
+        or status >= 500
+        or error.get("is_transient") is True
+        or code in {1, 2, 4, 17, 32, 613, 80000}
+    )
+    if auth:
+        message = "O acesso à Meta expirou ou foi revogado."
+    elif retry:
+        message = "A Meta está indisponível ou limitou as requisições."
+    elif code in {10, 200} or status == 403:
+        message = "A Meta recusou as permissões. Confira a conta e o portfólio empresarial."
+    else:
+        message = "A Meta recusou a solicitação."
+    diagnostic.append(f"mensagem={_safe_meta_message(error, code, subcode, message)}")
+    return MetaRequestError(message + detail, " ".join(diagnostic), retry=retry, auth=auth)
+
+
+def _transport_error(error: Exception) -> MetaRequestError:
+    message = "Sem resposta da Meta. Verifique a conexão."
+    cause: BaseException | None = error
+    while cause is not None:
+        if isinstance(cause, OSError) and getattr(cause, "winerror", None) == 10054:
+            return MetaRequestError(
+                message, "transporte=WinError-10054 Conexão com a Meta encerrada.", retry=True
+            )
+        cause = cause.__cause__
+    if isinstance(error, (httpx.TimeoutException, TimeoutError)):
+        return MetaRequestError(
+            message, "transporte=timeout A Meta não respondeu a tempo.", retry=True
+        )
+    return MetaRequestError(
+        message, "transporte=sem-resposta Erro de conexão com a Meta.", retry=True
+    )
+
