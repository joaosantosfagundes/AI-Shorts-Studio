+
+    def create_draft(self, reel_id: str, export_id: str, title: str, sha256: str, now: int) -> None:
+        with self.connect(write=True) as conn:
+            conn.execute(
+                """INSERT INTO reels (id, export_id, title, sha256, created_at, updated_at)
+                   VALUES (?, ?, ?, ?, ?, ?)""",
+                (reel_id, export_id, title, sha256, now, now),
+            )
