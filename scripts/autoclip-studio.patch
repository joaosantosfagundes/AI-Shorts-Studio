+"""Facebook Login for Business and the Instagram Graph API."""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import os
+import re
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from urllib.parse import urlencode, urlsplit
+
+import httpx
+
+CALLBACK = "/api/instagram/oauth/callback"
+LOOPBACK_HOSTS = {"localhost", "127.0.0.1", "::1"}
+PERMISSIONS = {
+    "instagram_basic",
+    "instagram_content_publish",
+    "pages_show_list",
+    "pages_read_engagement",
+}
+
+
+class InstagramError(RuntimeError):
+    """Safe to display or persist. Never carries response bodies or credentials."""
+
+    def __init__(self, message: str, *, retry: bool = False, auth: bool = False) -> None:
+        super().__init__(message)
+        self.retry = retry
+        self.auth = auth
+
+
+@dataclass(frozen=True)
+class MetaConfig:
+    app_id: str
+    config_id: str
+    secret: str = field(repr=False)
+    redirect: str = "http://localhost:8000" + CALLBACK
+    version: str = "v27.0"
+    publishing: bool = False
+
+    @classmethod
+    def load(cls) -> MetaConfig:
+        prefix = "AI_SHORTS_META_"
+        return cls(
+            app_id=os.environ.get(prefix + "APP_ID", "").strip(),
+            config_id=os.environ.get(prefix + "CONFIG_ID", "").strip(),
+            secret=os.environ.get(prefix + "APP_SECRET", "").strip(),
+            redirect=os.environ.get(prefix + "REDIRECT_URI", "http://localhost:8000" + CALLBACK),
+            version=os.environ.get(prefix + "API_VERSION", "v27.0"),
+            publishing=os.environ.get("AI_SHORTS_INSTAGRAM_PUBLISH") == "1",
+        )
+
+    @property
+    def problem(self) -> str | None:
+        if not (meta_id(self.app_id) and meta_id(self.config_id) and self.secret):
+            return "Configure o ID do aplicativo, o ID da configuração e o segredo da Meta."
+        if not re.fullmatch(r"v[0-9]{1,2}\.0", self.version):
+            return "A versão da API Graph deve estar no formato v27.0."
+        try:
+            url = urlsplit(self.redirect)
+            port = url.port
+        except ValueError:
+            return "O endereço de retorno da Meta é inválido."
+        if (
+            url.scheme not in {"http", "https"}
+            or url.hostname not in LOOPBACK_HOSTS
+            or (port is not None and port <= 0)
+            or url.path != CALLBACK
+            or url.query
+            or url.fragment
+            or url.username
+        ):
+            return "Use um endereço local de retorno da Meta que termine em " + CALLBACK + "."
+        return None
+
+    @property
+    def origin(self) -> str:
+        url = urlsplit(self.redirect)
+        return f"{url.scheme}://{url.netloc}"
+
+    def login_url(self, state: str) -> str:
+        params = urlencode(
+            {
+                "client_id": self.app_id,
+                "config_id": self.config_id,
+                "redirect_uri": self.redirect,
+                "response_type": "code",
+                "state": state,
+            }
+        )
+        return f"https://www.facebook.com/{self.version}/dialog/oauth?{params}"
+
+
+@dataclass(frozen=True)
+class AccountGrant:
+    id: str
+    page_id: str
+    username: str
+    page_name: str
+    page_token: str = field(repr=False)
+
+
+@dataclass(frozen=True)
+class UserToken:
+    value: str = field(repr=False)
+    expires_at: int | None
+
+
+def meta_id(value: object) -> bool:
+    return isinstance(value, str) and bool(re.fullmatch(r"[0-9]{1,32}", value))
+
+
+class MetaClient:
+    def __init__(self, config: MetaConfig, http: httpx.Client) -> None:
+        self.config = config
+        self.http = http
+
+    def _request(self, method: str, url: str, **kwargs: object) -> dict:
+        try:
+            response = self.http.request(method, url, **kwargs)
+            body = response.json()
+        except (httpx.RequestError, TimeoutError):
+            raise InstagramError("Sem resposta da Meta. Verifique a conexão.", retry=True) from None
+        except ValueError:
+            raise InstagramError(
+                "A Meta retornou uma resposta inesperada.",
+                retry=response.status_code == 429 or response.status_code >= 500,
+            ) from None
+        if not isinstance(body, dict):
+            raise InstagramError("A Meta retornou um formato inesperado.")
+        if response.is_success and "error" not in body:
+            return body
+
+        error = body.get("error")
+        error = error if isinstance(error, dict) else {}
+        code = error.get("code")
+        code = code if isinstance(code, int) else None
+        trace = error.get("fbtrace_id")
+        detail = f" Código {code}." if code is not None else ""
+        if isinstance(trace, str) and re.fullmatch(r"[A-Za-z0-9_-]{1,80}", trace):
+            detail += f" Referência {trace}."
+        if response.status_code == 401 or code in {102, 190}:
+            raise InstagramError("O acesso à Meta expirou ou foi revogado." + detail, auth=True)
+        if (
+            response.status_code == 429
+            or response.status_code >= 500
+            or error.get("is_transient") is True
+            or code in {1, 2, 4, 17, 32, 613, 80000}
+        ):
+            raise InstagramError(
+                "A Meta está indisponível ou limitou as requisições." + detail, retry=True
+            )
+        if code in {10, 200} or response.status_code == 403:
+            raise InstagramError(
+                "A Meta recusou as permissões. Revise a conta e a Página." + detail
+            )
+        raise InstagramError("A Meta recusou a solicitação." + detail)
+
+    def _graph(
+        self,
+        method: str,
+        path: str,
+        token: str | None = None,
+        *,
+        params: dict | None = None,
+        data: dict | None = None,
+    ) -> dict:
+        headers = {"Authorization": f"Bearer {token}"} if token else {}
+        query = dict(params or {})
+        if token:
+            query["appsecret_proof"] = hmac.new(
+                self.config.secret.encode(), token.encode(), hashlib.sha256
+            ).hexdigest()
+        return self._request(
+            method,
+            f"https://graph.facebook.com/{self.config.version}/{path}",
+            headers=headers,
+            params=query,
+            data=data,
+        )
+
+    def exchange(self, code: str) -> UserToken:
+        app = {"client_id": self.config.app_id, "client_secret": self.config.secret}
+        first = self._graph(
+            "GET",
+            "oauth/access_token",
+            params={
+                **app,
+                "redirect_uri": self.config.redirect,
+                "code": code,
+            },
+        )
+        short_token = first.get("access_token")
+        if not isinstance(short_token, str) or not short_token:
+            raise InstagramError("A Meta não forneceu o token de usuário.")
+        long = self._graph(
+            "GET",
+            "oauth/access_token",
+            params={
+                **app,
+                "grant_type": "fb_exchange_token",
+                "fb_exchange_token": short_token,
+            },
+        )
+        token = long.get("access_token")
+        if not isinstance(token, str) or not token:
+            raise InstagramError("A Meta não forneceu o token de longa duração.")
+        lifetime = long.get("expires_in")
+        expiry = int(time.time()) + lifetime if isinstance(lifetime, int) and lifetime > 0 else None
+        return UserToken(token, expiry)
+
+    def grants(self, user_token: str) -> list[AccountGrant]:
+        permissions = self._graph("GET", "me/permissions", user_token).get("data", [])
+        granted = {item["permission"] for item in permissions if item.get("status") == "granted"}
+        if missing := PERMISSIONS - granted:
+            raise InstagramError("Autorize estas permissões na Meta: " + ", ".join(sorted(missing)))
+        params: dict = {
+            "fields": "id,name,tasks,access_token,instagram_business_account{id,username}",
+            "limit": 100,
+        }
+        accounts: dict[str, AccountGrant] = {}
+        while True:
+            response = self._graph("GET", "me/accounts", user_token, params=params)
+            for page in response.get("data", []):
+                ig = page.get("instagram_business_account") or {}
+                if (
+                    not meta_id(ig.get("id"))
+                    or not meta_id(page.get("id"))
+                    or not page.get("access_token")
+                    or not ig.get("username")
+                    or not {"MANAGE", "CREATE_CONTENT"}.intersection(page.get("tasks", []))
+                ):
+                    continue
+                accounts[ig["id"]] = AccountGrant(
+                    ig["id"], page["id"], ig["username"], page.get("name", ""), page["access_token"]
+                )
+            # Use the cursor with the fixed host. Pagination URLs can contain access tokens.
+            paging = response.get("paging", {})
+            after = paging.get("cursors", {}).get("after")
+            if not paging.get("next") or not after or after == params.get("after"):
+                return list(accounts.values())
+            params["after"] = after
+
+    @staticmethod
+    def _response_id(body: dict) -> str:
+        value = body.get("id")
+        if not meta_id(value):
+            raise InstagramError("A Meta não retornou um identificador válido.")
+        return value
+
+    def create_reel(self, account: str, token: str, caption: str) -> str:
+        limit = self._graph(
+            "GET",
+            f"{account}/content_publishing_limit",
+            token,
+            params={"fields": "quota_usage,config"},
+        ).get("data", [])
+        if limit:
+            usage = limit[0].get("quota_usage")
+            maximum = limit[0].get("config", {}).get("quota_total")
+            if isinstance(usage, int) and isinstance(maximum, int) and usage >= maximum:
+                raise InstagramError("A conta atingiu o limite de publicações da Meta.", retry=True)
+        return self._response_id(
+            self._graph(
+                "POST",
+                f"{account}/media",
+                token,
+                data={
+                    "media_type": "REELS",
+                    "upload_type": "resumable",
+                    "caption": caption,
+                },
+            )
+        )
+
+    def upload(self, container: str, token: str, path: Path) -> None:
+        deadline = time.monotonic() + 240
+        with path.open("rb") as handle:
+            size = str(os.fstat(handle.fileno()).st_size)
+
+            def blocks():
+                while chunk := handle.read(1024 * 1024):
+                    if time.monotonic() > deadline:
+                        raise TimeoutError
+                    yield chunk
+
+            body = self._request(
+                "POST",
+                f"https://rupload.facebook.com/ig-api-upload/{self.config.version}/{container}",
+                headers={
+                    "Authorization": f"OAuth {token}",
+                    "offset": "0",
+                    "file_size": size,
+                    "Content-Length": size,
+                    "Content-Type": "application/octet-stream",
+                },
+                content=blocks(),
+            )
+        if body.get("success") is not True:
+            raise InstagramError(
+                "A Meta não confirmou o envio do vídeo.",
+                retry=body.get("debug_info", {}).get("retriable") is True,
+            )
+
+    def status(self, container: str, token: str) -> str:
+        return self._graph("GET", container, token, params={"fields": "status_code"}).get(
+            "status_code", ""
+        )
+
+    def publish(self, account: str, container: str, token: str) -> str:
+        return self._response_id(
+            self._graph("POST", f"{account}/media_publish", token, data={"creation_id": container})
+        )
