+            raise StoreConflict("A execução desta publicação foi retomada por outra sessão.")
+
+    @staticmethod
+    def _event(conn: sqlite3.Connection, reel: str, now: int, status: str, detail: str) -> None:
+        conn.execute(
+            "INSERT INTO events (reel_id, at, status, detail) VALUES (?, ?, ?, ?)",
+            (reel, now, status, detail),
+        )
+
+    @staticmethod
+    def _write(conn: sqlite3.Connection, reel: str, **values: object) -> None:
+        assignments = ", ".join(f"{key}=?" for key in values)
+        conn.execute(f"UPDATE reels SET {assignments} WHERE id=?", (*values.values(), reel))
+
+    def _transition(
+        self,
+        conn: sqlite3.Connection,
+        reel: str,
+        now: int,
+        status: str,
+        detail: str,
+        **values: object,
+    ) -> None:
+        self._write(conn, reel, status=status, detail=detail, updated_at=now, **values)
+        self._event(conn, reel, now, status, detail)
+
+
