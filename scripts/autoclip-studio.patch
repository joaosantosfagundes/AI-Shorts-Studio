+                for row in conn.execute(
+                    "SELECT at, status, detail FROM events WHERE reel_id=? ORDER BY id DESC",
+                    (reel_id,),
+                )
+            ]
+
+    def save_draft(self, reel_id: str, now: int, values: dict, *, approve: bool = False) -> None:
+        with self.connect(write=True) as conn:
+            row = self._get(conn, "reels", reel_id)
+            if row["status"] != "draft":
+                raise StoreConflict("Somente rascunhos podem ser editados ou aprovados.")
+            if approve:
+                if (
+                    not values["account_id"]
+                    or values["scheduled_at"] is None
+                    or values["scheduled_at"] <= now
+                ):
+                    raise StoreConflict("Escolha a conta e um horário futuro para publicar.")
+                account = self._get(conn, "accounts", values["account_id"])
+                if not account["connected"] or account["auth_needed"]:
+                    raise StoreConflict("Conecte ou renove a conta de destino antes de aprovar.")
+                duplicate = conn.execute(
+                    """SELECT 1 FROM reels
+                       WHERE account_id=? AND (export_id=? OR sha256=?) AND id<>?
+                       AND status IN ('queued','sending','waiting','retry',
+                                      'published','uncertain')""",
+                    (account["id"], row["export_id"], row["sha256"], reel_id),
+                ).fetchone()
+                if duplicate:
+                    raise StoreConflict("Esse vídeo já tem uma publicação para esta conta.")
+                self._transition(
+                    conn,
+                    reel_id,
+                    now,
+                    "queued",
+                    "Prévia e direitos confirmados. Publicação autorizada.",
+                    approved_at=now,
+                    rights_confirmed=1,
+                    next_at=values["scheduled_at"],
+                    **values,
