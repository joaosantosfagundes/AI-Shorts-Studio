+"""Exercise the local OAuth and publication flow with synthetic media and a fake Meta API."""
+
+from __future__ import annotations
+
+import logging
+import time
+from contextlib import contextmanager
+from datetime import UTC, datetime
+from urllib.parse import parse_qs, urlsplit
+
+import httpx
+import pytest
+from autoclip import paths
+from autoclip.app import create_app
+from autoclip.db import store as clip_db
+from autoclip.db.models import Clip, Export, Job, Source, new_id
+from autoclip.instagram import api as routes
+from autoclip.instagram import worker
+from autoclip.instagram.media import sha256
+from autoclip.instagram.meta import (
+    PERMISSIONS,
+    AccountGrant,
+    InstagramError,
+    MetaClient,
+    MetaConfig,
+    UserToken,
+)
+from autoclip.instagram.store import Credentials, Store, StoreConflict, Vault, local_store
+from autoclip.pipeline import ffmpeg
+from fastapi.testclient import TestClient
+
+ORIGIN = "http://localhost:8000"
+PREFIX = "/api/instagram"
+HEADERS = {"Origin": ORIGIN, "X-Studio-Local": "1"}
+EPOCH = 1_700_000_000
+GRANTS = [
+    AccountGrant("101", "201", "canal_a", "Página A", "page-secret-a"),
+    AccountGrant("102", "202", "canal_b", "Página B", "page-secret-b"),
+    AccountGrant("103", "203", "canal_c", "Página C", "page-secret-c"),
+]
+USER = UserToken("long-user-secret", EPOCH + 600)
+
+
+def edits(account: str = "101", scheduled: int = EPOCH + 1) -> dict:
+    return {
+        "account_id": account,
+        "caption": "Um corte",
+        "hashtags": "#jogos",
+        "scheduled_at": scheduled,
+    }
+
+
+def draft(store: Store, export: str = "a" * 16) -> str:
+    reel = new_id()
+    media = store.media(reel)
+    media.parent.mkdir(parents=True, exist_ok=True)
+    media.write_bytes(b"local synthetic fixture " + export.encode())
+    store.create_draft(reel, export, "Trecho de teste", sha256(media), EPOCH)
+    return reel
+
+
+@pytest.fixture
+def vault(monkeypatch, fake_keyring) -> Vault:
+    monkeypatch.setattr(Vault, "backend", staticmethod(lambda: fake_keyring))
+    return Vault(paths.root(), "111")
+
+
+@pytest.fixture
+def client(monkeypatch, vault):
+    for key, value in {
+        "AI_SHORTS_META_APP_ID": "111",
+        "AI_SHORTS_META_CONFIG_ID": "222",
+        "AI_SHORTS_META_APP_SECRET": "application-secret",
+        "AI_SHORTS_META_API_VERSION": "v27.0",
+        "AI_SHORTS_META_REDIRECT_URI": ORIGIN + PREFIX + "/oauth/callback",
+        "AI_SHORTS_INSTAGRAM_PUBLISH": "1",
+        "AUTOCLIP_NO_WORKER": "1",
+    }.items():
+        monkeypatch.setenv(key, value)
+    with TestClient(
+        create_app(), base_url=ORIGIN, client=("127.0.0.1", 50000), follow_redirects=False
+    ) as test_client:
+        yield test_client
+
+
+def test_oauth_code_and_scopes_are_server_side(client, monkeypatch, vault, caplog):
+    calls = []
+
+    def response(request: httpx.Request) -> httpx.Response:
+        calls.append(request)
+        assert request.url.host == "graph.facebook.com"
+        endpoint = request.url.path
+        if endpoint.endswith("/oauth/access_token"):
+            assert request.url.params["client_secret"] == "application-secret"
+            if request.url.params.get("grant_type"):
+                assert request.url.params["fb_exchange_token"] == "short-user-secret"
+                return httpx.Response(200, json={"access_token": USER.value, "expires_in": 500})
+            assert request.url.params["code"] == "fake-callback-code"
+            assert request.url.params["redirect_uri"] == ORIGIN + PREFIX + "/oauth/callback"
+            return httpx.Response(200, json={"access_token": "short-user-secret"})
+        assert request.headers["authorization"] == f"Bearer {USER.value}"
+        assert request.url.params["appsecret_proof"]
+        if endpoint.endswith("/me/permissions"):
+            return httpx.Response(
+                200,
+                json={
+                    "data": [
+                        {"permission": permission, "status": "granted"}
+                        for permission in PERMISSIONS
+                    ]
+                },
+            )
+        assert endpoint.endswith("/me/accounts")
+        return httpx.Response(
+            200,
+            json={
+                "data": [
+                    {
+                        "id": account.page_id,
+                        "access_token": account.page_token,
+                        "name": account.page_name,
+                        "tasks": ["CREATE_CONTENT"],
+                        "instagram_business_account": {
+                            "id": account.id,
+                            "username": account.username,
+                        },
+                    }
+                    for account in GRANTS
+                ]
+            },
+        )
