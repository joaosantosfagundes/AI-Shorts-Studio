+def test_documented_resumable_upload_request(tmp_path):
+    path = tmp_path / "synthetic.mp4"
+    payload = b"short-file" * 200_000
+    path.write_bytes(payload)
+    processed = []
+    config = MetaConfig("111", "222", "app-secret")
+
+    def response(request: httpx.Request) -> httpx.Response:
+        route = request.url.path
+        processed.append((request.method, route))
+        if request.url.host == "rupload.facebook.com":
+            assert route == "/ig-api-upload/v27.0/301"
+            assert request.headers["authorization"] == "OAuth page-secret"
+            assert request.headers["offset"] == "0"
+            assert (
+                request.headers["file_size"]
+                == request.headers["content-length"]
+                == str(len(payload))
+            )
+            assert request.content == payload
+            return httpx.Response(200, json={"success": True})
+        assert request.url.host == "graph.facebook.com"
+        assert request.headers["authorization"] == "Bearer page-secret"
+        if route.endswith("/content_publishing_limit"):
+            return httpx.Response(
+                200, json={"data": [{"quota_usage": 2, "config": {"quota_total": 100}}]}
+            )
+        if route.endswith("/media"):
+            assert parse_qs(request.content.decode()) == {
+                "media_type": ["REELS"],
+                "upload_type": ["resumable"],
+                "caption": ["Teste #jogos"],
+            }
+            return httpx.Response(200, json={"id": "301"})
+        if route.endswith("/301"):
+            assert request.url.params["fields"] == "status_code"
+            return httpx.Response(200, json={"status_code": "FINISHED"})
+        assert route.endswith("/media_publish")
+        assert parse_qs(request.content.decode()) == {"creation_id": ["301"]}
+        return httpx.Response(200, json={"id": "401"})
+
+    with httpx.Client(transport=httpx.MockTransport(response)) as transport:
+        meta = MetaClient(config, transport)
+        container = meta.create_reel("101", "page-secret", "Teste #jogos")
+        meta.upload(container, "page-secret", path)
+        assert meta.status(container, "page-secret") == "FINISHED"
+        assert meta.publish("101", container, "page-secret") == "401"
+    assert [method for method, _ in processed] == ["GET", "POST", "POST", "GET", "POST"]
+
