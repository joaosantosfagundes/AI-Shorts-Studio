@@ -0,0 +1,159 @@
+"""Prepare a publication copy independently of the Clipador's exports."""
+
+from __future__ import annotations
+
+import hashlib
+import sqlite3
+from pathlib import Path
+
+from .. import db, paths
+from ..db.models import new_id
+from ..pipeline import ffmpeg
+from .meta import InstagramError
+from .store import Store
+
+MAX_BYTES = 300_000_000
+EXPORT_FIELDS = """
+    SELECT e.id, e.path, e.size_bytes, e.created_at, e.clip_id, c.title FROM exports AS e
+    JOIN clips AS c ON c.id = e.clip_id
+    WHERE e.ratio = '9:16' AND c.status <> 'discarded'
+"""
+
+
+def reel_exports(preferred: str | None = None) -> list[dict]:
+    with db.connection() as conn:
+        rows = conn.execute(
+            EXPORT_FIELDS + " ORDER BY e.id = ? DESC, e.created_at DESC LIMIT 100", (preferred,)
+        )
+        return [
+            {key: row[key] for key in ("id", "title", "created_at", "size_bytes")}
+            for row in rows
+            if available_export(row["path"])
+        ]
+
+
+def available_export(filename: str) -> Path | None:
+    file = Path(filename).resolve()
+    if (
+        file.is_relative_to(paths.exports_dir().resolve())
+        and file.suffix.lower() == ".mp4"
+        and file.is_file()
+    ):
+        return file
+    return None
+
+
+def sha256(path: Path) -> str:
+    with path.open("rb") as handle:
+        return hashlib.file_digest(handle, "sha256").hexdigest()
+
+
+def verify_media(path: Path, row: sqlite3.Row) -> None:
+    if not path.is_file() or sha256(path) != row["sha256"]:
+        raise InstagramError("O MP4 da prévia mudou. Prepare e aprove uma nova cópia.")
+
+
+def prepare_draft(store: Store, export_id: str, now: int) -> str:
+    with db.connection() as conn:
+        export = conn.execute(EXPORT_FIELDS + " AND e.id = ?", (export_id,)).fetchone()
+    source = available_export(export["path"]) if export else None
+    if source is None:
+        raise InstagramError("Exporte um corte vertical 9:16 disponível para preparar o Reel.")
+    reel = new_id()
+    target = store.media(reel)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    partial = target.with_suffix(".tmp.mp4")
+    saved = False
+    try:
+        build_snapshot(source, partial)
+        digest = sha256(partial)
+        partial.replace(target)
+        store.create_draft(reel, export_id, export["title"] or "Corte sem título", digest, now)
+        saved = True
+    finally:
+        partial.unlink(missing_ok=True)
+        if not saved:
+            target.unlink(missing_ok=True)
+    return reel
+
+
+def build_snapshot(source: Path, destination: Path) -> None:
+    try:
+        source_stat = source.stat()
+        info = ffmpeg.probe(source)
+        if (
+            not info.is_vertical
+            or not info.fps
+            or not 3 <= info.duration_s <= 900
+            or source_stat.st_size > MAX_BYTES
+        ):
+            raise InstagramError("Escolha um MP4 vertical de 3 segundos a 15 minutos e até 300 MB.")
+        # Keep video lossless for ordinary Clipador exports. Re-encode only if
+        # necessary for frame rate or to cap the bitrate of an unusually large cut.
+        avg_bitrate = 8 * source_stat.st_size / info.duration_s
+        compatible = (
+            info.video_codec in {"h264", "hevc"}
+            and 23 <= info.fps <= 60
+            and avg_bitrate < 24_000_000
+            and info.width <= 1920
+        )
+        video = (
+            ["-c:v", "copy"]
+            if compatible
+            else [
+                "-vf",
+                "scale='min(iw,1920)':-2,fps=30",
+                "-c:v",
+                "libx264",
+                "-preset",
+                "fast",
+                "-pix_fmt",
+                "yuv420p",
+                "-crf",
+                "21",
+                "-maxrate",
+                "24M",
+                "-bufsize",
+                "24M",
+            ]
+        )
+        ffmpeg.run(
+            [
+                "-i",
+                str(source),
+                "-map",
+                "0:v:0",
+                "-map",
+                "0:a:0?",
+                "-map_metadata",
+                "-1",
+                "-map_chapters",
+                "-1",
+                *video,
+                "-c:a",
+                "aac",
+                "-b:a",
+                "128k",
+                "-ar",
+                "48000",
+                "-ac",
+                "2",
+                "-use_editlist",
+                "0",
+                "-movflags",
+                "+faststart",
+                str(destination),
+            ]
+        )
+        final_stat = source.stat()
+        if (source_stat.st_size, source_stat.st_mtime_ns) != (
+            final_stat.st_size,
+            final_stat.st_mtime_ns,
+        ):
+            raise InstagramError("A exportação mudou durante a cópia. Tente novamente.")
+        if not 0 < destination.stat().st_size <= MAX_BYTES:
+            raise InstagramError("A cópia excedeu 300 MB. Exporte um corte menor ou em 720p.")
+    except (OSError, ffmpeg.FFmpegError):
+        raise InstagramError(
+            "Não foi possível preparar o MP4. Verifique a exportação, o FFmpeg e o espaço em disco."
+        ) from None
