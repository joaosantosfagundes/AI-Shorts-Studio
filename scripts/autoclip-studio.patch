+            self._transition(
+                conn,
+                reel_id,
+                now,
+                "draft",
+                "Reaberto para nova aprovação.",
+                approved_at=None,
+                rights_confirmed=0,
+                next_at=None,
+                container_id=None,
+                uploaded=0,
+                polls=0,
+                failures=0,
+                refreshed=0,
+            )
+
+    def cancel(self, reel_id: str, now: int) -> None:
+        with self.connect(write=True) as conn:
+            row = self._get(conn, "reels", reel_id)
+            if row["status"] not in {"queued", "waiting", "retry"} or row["publish_started"]:
+                raise StoreConflict("A publicação já está em envio ou encerrada.")
+            self._transition(conn, reel_id, now, "cancelled", "Cancelado no estúdio.", next_at=None)
