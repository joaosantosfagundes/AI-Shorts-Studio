@@ -0,0 +1,238 @@
+"""Run approved Reels through the local queue, one file at a time."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+import sqlite3
+import time
+from collections.abc import AsyncIterator, Callable
+from contextlib import asynccontextmanager
+
+import httpx
+
+from .media import verify_media
+from .meta import InstagramError, MetaClient, MetaConfig
+from .store import Credentials, Store, StoreConflict, Vault, local_store
+
+log = logging.getLogger(__name__)
+
+GRACE_SECONDS = 30 * 60
+POLL_SECONDS = 60
+MAX_POLLS = 5
+MAX_RETRIES = 5
+
+
+def http_client() -> httpx.Client:
+    return httpx.Client(timeout=httpx.Timeout(30.0, connect=10.0), follow_redirects=False)
+
+
+def refresh_credentials(
+    store: Store, vault: Vault, client: MetaClient, account: str, now: int
+) -> Credentials:
+    # Capture the token used, then compare before writing across a reconnect
+    # (which can supply a different Facebook account for the same Page).
+    with store.connect() as conn:
+        row = store._get(conn, "accounts", account)
+        original = vault.get(account) if row["connected"] else None
+    if not original or (row["user_expires_at"] is not None and row["user_expires_at"] <= now):
+        raise InstagramError("Reconecte esta conta pelo login da Meta.", auth=True)
+    grant = next((grant for grant in client.grants(original.user) if grant.id == account), None)
+    if not grant or grant.page_id != row["page_id"]:
+        raise InstagramError("A conta ou Página perdeu a autorização na Meta.", auth=True)
+    credentials = Credentials(grant.page_token, original.user)
+    with store.connect(write=True) as conn:
+        current = store._get(conn, "accounts", account)
+        if not current["connected"] or vault.get(account) != original:
+            raise StoreConflict("A conexão mudou. Atualize a página e tente novamente.")
+        vault.put(account, credentials)
+        conn.execute("UPDATE accounts SET auth_needed=0 WHERE id=?", (account,))
+    return credentials
+
+
+def _retry(store: Store, row: sqlite3.Row, now: int, error: InstagramError) -> None:
+    attempts = row["failures"] + 1
+    if error.retry and attempts <= MAX_RETRIES:
+        store.finish(
+            row, now, "retry", str(error), failures=attempts, next_at=now + 60 * 2 ** (attempts - 1)
+        )
+        return
+    state = "uncertain" if row["publish_started"] else "failed"
+    detail = str(error)
+    if state == "uncertain":
+        detail += " Consulte o status antes de uma nova publicação."
+    store.finish(row, now, state, detail, next_at=None)
+
+
+def dispatch_one(
+    store: Store,
+    vault: Vault,
+    client: MetaClient,
+    clock: Callable[[], float] = time.time,
+) -> bool:
+    now = int(clock())
+    row = store.claim(now)
+    if row is None:
+        return False
+    account = row["account_id"]
+    try:
+        if not row["publish_started"] and now > row["scheduled_at"] + GRACE_SECONDS:
+            store.finish(
+                row, now, "late", "Horário perdido. Reagende e aprove novamente.", next_at=None
+            )
+            return True
+        current = store.account(account)
+        credentials = vault.get(account) if current["connected"] else None
+        if not credentials or current["auth_needed"]:
+            raise InstagramError("Reconecte a conta de destino na página do Instagram.")
+        token = credentials.page
+
+        if not row["container_id"]:
+            path = store.media(row["id"])
+            verify_media(path, row)
+            caption = "\n\n".join(text for text in (row["caption"], row["hashtags"]) if text)
+            container = client.create_reel(account, token, caption)
+            # A lost upload leaves only an unpublished container. A retry can
+            # create a fresh container without publishing anything twice.
+            client.upload(container, token, path)
+            now = int(clock())
+            store.finish(
+                row,
+                now,
+                "waiting",
+                "MP4 enviado. Aguardando processamento da Meta.",
+                container_id=container,
+                uploaded=1,
+                failures=0,
+                next_at=now + POLL_SECONDS,
+            )
+            return True
+
+        state = client.status(row["container_id"], token)
+        now = int(clock())
+        if state == "PUBLISHED":
+            store.finish(row, now, "published", "O Instagram confirmou a publicação.", next_at=None)
+        elif state in {"ERROR", "EXPIRED"}:
+            store.finish(
+                row,
+                now,
+                "failed",
+                "A Meta descartou ou expirou o envio.",
+                publish_started=0,
+                next_at=None,
+            )
+        elif row["publish_started"] or state != "FINISHED":
+            count = row["polls"] + 1
+            if count >= MAX_POLLS:
+                raise InstagramError("A Meta não confirmou o resultado dentro do prazo.")
+            store.finish(
+                row,
+                now,
+                "waiting",
+                "Aguardando confirmação da Meta.",
+                polls=count,
+                failures=0,
+                next_at=now + POLL_SECONDS,
+            )
+        elif now > row["scheduled_at"] + GRACE_SECONDS:
+            store.finish(
+                row, now, "late", "Horário perdido. Reagende e aprove novamente.", next_at=None
+            )
+        else:
+            # This transaction must commit before the only non-idempotent call.
+            row = store.checkpoint(row, now, publish_started=1, polls=0, failures=0)
+            published = client.publish(account, row["container_id"], token)
+            store.finish(
+                row,
+                int(clock()),
+                "published",
+                "Reel publicado no Instagram.",
+                media_id=published,
+                next_at=None,
+            )
+    except InstagramError as error:
+        now = int(clock())
+        if error.auth and not row["refreshed"]:
+            row = store.checkpoint(row, now, refreshed=1)
+            try:
+                refresh_credentials(store, vault, client, account, now)
+                store.finish(
+                    row, now, "retry", "Acesso à Página renovado.", next_at=now + POLL_SECONDS
+                )
+                return True
+            except InstagramError as refresh_error:
+                if refresh_error.retry:
+                    store.checkpoint(row, now, refreshed=0)
+                error = refresh_error
+        if error.auth:
+            store.auth_needed(account)
+        # Ambiguous publish failures get a status check before manual review.
+        if (
+            row["publish_started"]
+            and not error.retry
+            and row["failures"] == 0
+            and row["polls"] == 0
+        ):
+            store.finish(
+                row,
+                now,
+                "retry",
+                "Verificando se a Meta recebeu a publicação.",
+                failures=1,
+                next_at=now + POLL_SECONDS,
+            )
+            return True
+        _retry(store, row, now, error)
+    except OSError:
+        _retry(store, row, int(clock()), InstagramError("Não foi possível ler o MP4 aprovado."))
+    return True
+
+
+async def _serve(config: MetaConfig, stop: asyncio.Event) -> None:
+    with http_client() as http:
+        client = MetaClient(config, http)
+        while not stop.is_set():
+            try:
+                store = await asyncio.to_thread(local_store)
+                vault = Vault(store.home, config.app_id)
+                if await asyncio.to_thread(dispatch_one, store, vault, client):
+                    continue
+            except (StoreConflict, sqlite3.Error, OSError):
+                log.exception("Falha ao acessar a fila local do Instagram.")
+            except Exception:
+                # Never log a raw HTTP exception that may include credentials.
+                log.error(
+                    "Falha inesperada na fila do Instagram. Uma tentativa pendente será retomada."
+                )
+            try:
+                await asyncio.wait_for(stop.wait(), timeout=5)
+            except TimeoutError:
+                continue
+
+
+@asynccontextmanager
+async def publisher(worker_enabled: bool) -> AsyncIterator[None]:
+    config = MetaConfig.load()
+    if (
+        not worker_enabled
+        or config.problem
+        or not config.publishing
+        or os.environ.get("AUTOCLIP_NO_WORKER") == "1"
+    ):
+        yield
+        return
+    try:
+        Vault.backend()
+    except InstagramError:
+        log.warning("Fila do Instagram pausada. O cofre do Windows está indisponível.")
+        yield
+        return
+
+    stop = asyncio.Event()
+    task = asyncio.create_task(_serve(config, stop))
+    try:
+        yield
+    finally:
+        stop.set()
+        await task
