+class FakeMeta:
+    def __init__(self) -> None:
+        self.created = []
+        self.sent = []
+        self.published = []
+        self.upload_error = None
+        self.publish_error = None
+        self.state = "FINISHED"
+
+    def create_reel(self, account, token, caption):
+        self.created.append((account, token, caption))
+        return "301"
+
+    def upload(self, container, token, path):
+        self.sent.append(path.read_bytes())
+        if self.upload_error:
+            raise self.upload_error
+
+    def status(self, container, token):
+        return self.state
+
+    def publish(self, account, container, token):
+        self.published.append((account, container, token))
+        if self.publish_error:
+            raise self.publish_error
+        return "401"
+
+    def grants(self, user):
+        assert user == USER.value
+        return [AccountGrant("101", "201", "canal_a", "Página A", "new-page-secret")]
