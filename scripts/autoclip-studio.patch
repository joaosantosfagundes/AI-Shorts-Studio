+  const [exportId, setExportId] = useState('')
+  const [drafts, setDrafts] = useState<Reel[]>([])
+  const [active, setActive] = useState<Reel[]>([])
+  const [history, setHistory] = useState<Reel[]>([])
+  const [offsets, setOffsets] = useState({ drafts: 0, queue: 0, history: 0 })
+  const [editor, setEditor] = useState<Reel | null>(null)
+  const [details, setDetails] = useState<{ reel: Reel; events: ReelEvent[] } | null>(null)
+  const [filter, setFilter] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<Error | null>(null)
+  const [notice, setNotice] = useState('')
+
+  const refresh = useCallback(async (valid: () => boolean = () => true) => {
+    const [configuration, linked, saved, queue, records] = await Promise.all([
+      instagram.status(), instagram.accounts(),
+      instagram.reels('drafts', offsets.drafts), instagram.reels('queue', offsets.queue, filter),
+      instagram.reels('history', offsets.history, filter),
+    ])
+    if (!valid()) return
+    setStatus(configuration)
+    setAccounts(linked)
+    setDrafts(saved)
+    setActive(queue)
+    setHistory(records)
+  }, [filter, offsets])
+
+  useEffect(() => {
+    let disposed = false
+    function reload() {
+      if (!disposed) void refresh(() => !disposed).catch((err) => { if (!disposed) setError(err as Error) })
+    }
+    reload()
+    const timer = window.setInterval(reload, 10_000)
+    return () => {
+      disposed = true
+      window.clearInterval(timer)
+    }
+  }, [refresh])
+
+  useEffect(() => {
+    instagram.exports(preferred).then((items) => {
+      setExports(items)
+      if (items.some((item) => item.id === preferred)) setExportId(preferred)
+    }).catch((err) => setError(err as Error))
+  }, [preferred])
+
+  useEffect(() => {
