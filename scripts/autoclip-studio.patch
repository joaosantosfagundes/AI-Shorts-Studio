+@pytest.mark.parametrize("published_on_meta", [True, False])
+def test_publish_is_never_repeated_after_a_lost_response(approved, vault, published_on_meta):
+    store, reel, meta = approved
+    assert worker.dispatch_one(store, vault, meta, lambda: EPOCH + 1)
+    meta.publish_error = InstagramError("Resposta perdida.", retry=True)
+    assert worker.dispatch_one(store, vault, meta, lambda: store.reel(reel)["next_at"])
+    assert store.reel(reel)["publish_started"] == 1
+    assert len(meta.published) == 1
+    restarted = Store(store.home)
+    if published_on_meta:
+        meta.state = "PUBLISHED"
+        assert worker.dispatch_one(restarted, vault, meta, lambda: restarted.reel(reel)["next_at"])
+        assert restarted.reel(reel)["status"] == "published"
+    else:
+        # The container is still ready, which cannot prove whether a publish was received.
+        for _ in range(worker.MAX_POLLS):
+            assert worker.dispatch_one(
+                restarted, vault, meta, lambda: restarted.reel(reel)["next_at"]
+            )
+        assert restarted.reel(reel)["status"] == "uncertain"
+        with pytest.raises(StoreConflict):
+            restarted.reopen(reel, EPOCH + 800)
+        assert restarted.mark_reconciled(reel, EPOCH + 801, published=True)
+    assert len(meta.published) == 1
