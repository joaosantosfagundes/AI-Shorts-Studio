@@ -0,0 +1,525 @@
+"""Same-origin local API for accounts, reviewed Reels and their schedules."""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import logging
+import os
+import re
+import secrets
+import threading
+import time
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Annotated, Literal
+from urllib.parse import urlsplit
+
+from fastapi import APIRouter, Depends, HTTPException, Query, Request, Response
+from fastapi.responses import FileResponse, RedirectResponse
+from pydantic import BaseModel, Field, StrictBool, field_validator, model_validator
+
+from .media import prepare_draft, reel_exports, verify_media
+from .meta import (
+    CALLBACK,
+    LOOPBACK_HOSTS,
+    AccountGrant,
+    InstagramError,
+    MetaClient,
+    MetaConfig,
+    UserToken,
+)
+from .store import StoreConflict, Vault, local_store
+from .worker import http_client, refresh_credentials
+
+PREFIX = "/api/instagram"
+STATE_COOKIE = "studio_meta_oauth"
+GRANTS_COOKIE = "studio_meta_grants"
+COOKIE_LIFETIME = 600
+PRIVATE = {
+    "Cache-Control": "no-store",
+    "Referrer-Policy": "no-referrer",
+    "Cross-Origin-Resource-Policy": "same-origin",
+}
+ID = re.compile(r"[0-9a-f]{16}")
+
+
+class SensitiveRequests(logging.Filter):
+    def filter(self, record: logging.LogRecord) -> bool:
+        return not any(value in record.getMessage() for value in (CALLBACK, "/oauth/access_token"))
+
+
+def protect_oauth_logs() -> None:
+    for name in ("uvicorn.access", "httpx"):
+        logger = logging.getLogger(name)
+        if not any(isinstance(f, SensitiveRequests) for f in logger.filters):
+            logger.addFilter(SensitiveRequests())
+
+
+def only_local(request: Request) -> None:
+    # The desktop app is single-user and has no login of its own.
+    host = request.headers.get("host", "")
+    try:
+        parsed = urlsplit("//" + host)
+        valid = parsed.netloc == host and parsed.hostname in LOOPBACK_HOSTS and not parsed.username
+    except ValueError:
+        valid = False
+    if not valid or not request.client or request.client.host not in LOOPBACK_HOSTS:
+        raise HTTPException(403, "Abra o AI Shorts Studio pelo endereço local.")
+    if request.method not in {"GET", "HEAD"}:
+        allowed = {f"{request.url.scheme}://{host}"}
+        config = MetaConfig.load()
+        if not config.problem and urlsplit(config.redirect).netloc == host:
+            allowed.add(config.origin)
+        if (
+            request.headers.get("x-studio-local") != "1"
+            or request.headers.get("origin") not in allowed
+        ):
+            raise HTTPException(403, "A solicitação deve partir do painel local.")
+
+
+router = APIRouter(prefix=PREFIX, dependencies=[Depends(only_local)])
+
+
+def _problem(error: Exception) -> HTTPException:
+    if isinstance(error, KeyError):
+        return HTTPException(404, "Conta ou Reel não encontrado.")
+    if isinstance(error, StoreConflict):
+        return HTTPException(409, str(error))
+    if isinstance(error, InstagramError):
+        return HTTPException(503 if error.retry else 422, str(error))
+    return HTTPException(503, "Não foi possível acessar o armazenamento local.")
+
+
+def _config() -> MetaConfig:
+    config = MetaConfig.load()
+    if config.problem:
+        raise HTTPException(503, config.problem)
+    return config
+
+
+def _valid_reel(reel_id: str) -> None:
+    if not ID.fullmatch(reel_id):
+        raise HTTPException(404, "Reel não encontrado.")
+
+
+def _digest(state: str) -> str:
+    return hashlib.sha256(state.encode()).hexdigest()
+
+
+@dataclass
+class PendingGrant:
+    app_id: str
+    accounts: list[AccountGrant]
+    user: UserToken
+    expires: int
+
+
+_pending: dict[str, PendingGrant] = {}
+_pending_lock = threading.Lock()
+
+
+def _prune_grants(now: int) -> None:
+    for key in [key for key, entry in _pending.items() if entry.expires <= now]:
+        del _pending[key]
+
+
+def _pending_grant(request: Request) -> tuple[str, PendingGrant | None]:
+    key = _digest(request.cookies.get(GRANTS_COOKIE, ""))
+    with _pending_lock:
+        _prune_grants(int(time.time()))
+        return key, _pending.get(key)
+
+
+def _oauth_result(status: str) -> RedirectResponse:
+    response = RedirectResponse(f"/instagram?conexao={status}", status_code=303, headers=PRIVATE)
+    response.delete_cookie(STATE_COOKIE, path=CALLBACK)
+    return response
+
+
+@router.get("/status")
+def status(response: Response) -> dict:
+    response.headers.update(PRIVATE)
+    config = MetaConfig.load()
+    problem = config.problem
+    if not problem:
+        try:
+            Vault.backend()
+        except InstagramError as error:
+            problem = str(error)
+    return {
+        "configured": not problem,
+        "problem": problem,
+        "publishing_enabled": not problem
+        and config.publishing
+        and os.environ.get("AUTOCLIP_NO_WORKER") != "1",
+        "login_origin": config.origin if not config.problem else None,
+    }
+
+
+@router.get("/accounts")
+def accounts(response: Response) -> list[dict]:
+    response.headers.update(PRIVATE)
+    return local_store().accounts()
+
+
+@router.post("/oauth/start")
+def start_oauth(request: Request, response: Response) -> dict:
+    config = _config()
+    try:
+        Vault.backend()
+    except InstagramError as error:
+        raise _problem(error) from None
+    host = request.headers.get("host")
+    if host != urlsplit(config.redirect).netloc or request.headers.get("origin") != config.origin:
+        raise HTTPException(409, f"Abra {config.origin}/instagram para conectar uma conta.")
+    key, _ = _pending_grant(request)
+    with _pending_lock:
+        _pending.pop(key, None)
+    state = secrets.token_urlsafe(32)
+    local_store().start_oauth(_digest(state), int(time.time()))
+    response.headers.update(PRIVATE)
+    response.set_cookie(
+        STATE_COOKIE,
+        state,
+        max_age=COOKIE_LIFETIME,
+        httponly=True,
+        samesite="lax",
+        secure=config.redirect.startswith("https:"),
+        path=CALLBACK,
+    )
+    return {"url": config.login_url(state)}
+
+
+@router.get("/oauth/callback", include_in_schema=False)
+def oauth_callback(request: Request) -> RedirectResponse:
+    config = MetaConfig.load()
+    state = request.query_params.get("state", "")
+    stored = request.cookies.get(STATE_COOKIE, "")
+    if (
+        config.problem
+        or request.headers.get("host") != urlsplit(config.redirect).netloc
+        or not re.fullmatch(r"[A-Za-z0-9_-]{43}", state)
+        or not re.fullmatch(r"[A-Za-z0-9_-]{43}", stored)
+        or not hmac.compare_digest(state, stored)
+    ):
+        return _oauth_result("sessao")
+    if not local_store().consume_oauth(_digest(state), int(time.time())):
+        return _oauth_result("sessao")
+    code = request.query_params.get("code", "")
+    if request.query_params.get("error") or not 1 <= len(code) <= 4096:
+        return _oauth_result("cancelada")
+    try:
+        with http_client() as http:
+            meta = MetaClient(config, http)
+            user = meta.exchange(code)
+            grants = meta.grants(user.value)
+    except InstagramError as error:
+        if error.retry:
+            return _oauth_result("rede")
+        if error.auth:
+            return _oauth_result("acesso")
+        logging.getLogger(__name__).warning("Retorno da Meta: %s", error)
+        return _oauth_result("permissoes")
+    if not grants:
+        return _oauth_result("sem-contas")
+    now = int(time.time())
+    key = secrets.token_urlsafe(32)
+    with _pending_lock:
+        _prune_grants(now)
+        _pending[_digest(key)] = PendingGrant(config.app_id, grants, user, now + COOKIE_LIFETIME)
+    response = _oauth_result("selecionar")
+    response.set_cookie(
+        GRANTS_COOKIE,
+        key,
+        max_age=COOKIE_LIFETIME,
+        httponly=True,
+        samesite="strict",
+        secure=config.redirect.startswith("https:"),
+        path=PREFIX,
+    )
+    return response
+
+
+@router.get("/oauth/accounts")
+def oauth_accounts(request: Request, response: Response) -> list[dict]:
+    response.headers.update(PRIVATE)
+    _, entry = _pending_grant(request)
+    if not entry or entry.app_id != MetaConfig.load().app_id:
+        return []
+    return [
+        {"id": grant.id, "username": grant.username, "page_name": grant.page_name}
+        for grant in entry.accounts
+    ]
+
+
+class AccountSelection(BaseModel):
+    ids: list[str] = Field(min_length=1, max_length=2)
+
+
+@router.post("/oauth/accounts", status_code=204)
+def select_accounts(selection: AccountSelection, request: Request) -> Response:
+    config = _config()
+    key, entry = _pending_grant(request)
+    if not entry or entry.app_id != config.app_id:
+        raise HTTPException(409, "A seleção expirou. Abra o login da Meta novamente.")
+    ids = set(selection.ids)
+    grants = [grant for grant in entry.accounts if grant.id in ids]
+    if len(grants) != len(ids):
+        raise HTTPException(422, "Selecione somente contas autorizadas no login da Meta.")
+    store = local_store()
+    try:
+        store.connect_accounts(grants, entry.user, Vault(store.home, config.app_id))
+    except (InstagramError, StoreConflict, OSError) as error:
+        raise _problem(error) from None
+    with _pending_lock:
+        _pending.pop(key, None)
+    response = Response(status_code=204, headers=PRIVATE)
+    response.delete_cookie(GRANTS_COOKIE, path=PREFIX)
+    return response
+
+
+@router.post("/accounts/{account_id}/renew", status_code=204)
+def renew_account(account_id: str) -> Response:
+    config = _config()
+    store = local_store()
+    try:
+        with http_client() as http:
+            refresh_credentials(
+                store,
+                Vault(store.home, config.app_id),
+                MetaClient(config, http),
+                account_id,
+                int(time.time()),
+            )
+    except (InstagramError, StoreConflict, KeyError) as error:
+        if isinstance(error, InstagramError) and error.auth:
+            store.auth_needed(account_id)
+        raise _problem(error) from None
+    return Response(status_code=204, headers=PRIVATE)
+
+
+@router.delete("/accounts/{account_id}", status_code=204)
+def disconnect_account(account_id: str) -> Response:
+    config = _config()
+    store = local_store()
+    try:
+        store.disconnect(account_id, Vault(store.home, config.app_id), int(time.time()))
+    except (InstagramError, StoreConflict, KeyError) as error:
+        raise _problem(error) from None
+    return Response(status_code=204, headers=PRIVATE)
+
+
+class DraftStart(BaseModel):
+    export_id: str = Field(pattern=r"^[0-9a-f]{16}$")
+
+
+class DraftEdit(BaseModel):
+    account_id: str | None = Field(default=None, pattern=r"^[0-9]{1,32}$")
+    caption: str = Field(default="", max_length=2200)
+    hashtags: str = Field(default="", max_length=2200)
+    scheduled_at: datetime | None = None
+
+    @field_validator("scheduled_at")
+    @classmethod
+    def require_timezone(cls, value: datetime | None) -> datetime | None:
+        if value is not None and value.utcoffset() is None:
+            raise ValueError("Informe um horário com fuso.")
+        return value
+
+    @model_validator(mode="after")
+    def validate_caption(self) -> DraftEdit:
+        self.caption = self.caption.strip()
+        tags = self.hashtags.replace(",", " ").split()
+        if any(not re.fullmatch(r"#?\w+", tag) for tag in tags):
+            raise ValueError("Use somente letras, números e _ nas hashtags.")
+        self.hashtags = " ".join(f"#{tag.lstrip('#')}" for tag in tags)
+        caption = "\n\n".join(text for text in (self.caption, self.hashtags) if text)
+        if len(caption) > 2200 or len(re.findall(r"#\w+", caption)) > 30:
+            raise ValueError("Use até 2.200 caracteres e 30 hashtags na legenda completa.")
+        if len(re.findall(r"@[\w.]+", caption)) > 20:
+            raise ValueError("Use até 20 menções na legenda.")
+        return self
+
+    def values(self) -> dict:
+        return {
+            "account_id": self.account_id,
+            "caption": self.caption,
+            "hashtags": self.hashtags,
+            "scheduled_at": int(self.scheduled_at.timestamp()) if self.scheduled_at else None,
+        }
+
+
+class Approval(DraftEdit):
+    reviewed: StrictBool
+    rights_confirmed: StrictBool
+    authorize_publication: StrictBool
+
+
+def _public_reel(row) -> dict:
+    reel = {
+        key: row[key]
+        for key in (
+            "id",
+            "export_id",
+            "title",
+            "account_id",
+            "caption",
+            "hashtags",
+            "scheduled_at",
+            "approved_at",
+            "status",
+            "created_at",
+            "updated_at",
+            "next_at",
+            "media_id",
+            "detail",
+        )
+    }
+    reel["can_cancel"] = not row["publish_started"] and row["status"] in {
+        "queued",
+        "waiting",
+        "retry",
+    }
+    return reel
+
+
+@router.get("/exports")
+def exports(response: Response, preferred: str | None = None) -> list[dict]:
+    response.headers.update(PRIVATE)
+    return reel_exports(preferred)
+
+
+@router.get("/reels")
+def reels(
+    response: Response,
+    view: Literal["drafts", "queue", "history"] = "queue",
+    account: Annotated[str | None, Query(pattern=r"^[0-9]{1,32}$")] = None,
+    offset: Annotated[int, Query(ge=0)] = 0,
+) -> list[dict]:
+    response.headers.update(PRIVATE)
+    return [
+        _public_reel(row)
+        for row in local_store().list_reels(view=view, account=account, offset=offset)
+    ]
+
+
+@router.post("/reels", status_code=201)
+def create_reel(body: DraftStart, response: Response) -> dict:
+    response.headers.update(PRIVATE)
+    store = local_store()
+    try:
+        reel_id = prepare_draft(store, body.export_id, int(time.time()))
+        return _public_reel(store.reel(reel_id))
+    except (InstagramError, OSError) as error:
+        raise _problem(error) from None
+
+
+@router.put("/reels/{reel_id}")
+def edit_reel(reel_id: str, body: DraftEdit, response: Response) -> dict:
+    _valid_reel(reel_id)
+    response.headers.update(PRIVATE)
+    store = local_store()
+    try:
+        if body.account_id:
+            store.account(body.account_id)
+        store.save_draft(reel_id, int(time.time()), body.values())
+        return _public_reel(store.reel(reel_id))
+    except (StoreConflict, KeyError) as error:
+        raise _problem(error) from None
+
+
+@router.post("/reels/{reel_id}/approve")
+def approve_reel(reel_id: str, body: Approval, response: Response) -> dict:
+    _valid_reel(reel_id)
+    config = _config()
+    response.headers.update(PRIVATE)
+    if not (body.reviewed and body.rights_confirmed and body.authorize_publication):
+        raise HTTPException(422, "Revise a prévia e confirme os direitos e a publicação.")
+    store = local_store()
+    try:
+        row = store.reel(reel_id)
+        if not body.account_id or not Vault(store.home, config.app_id).get(body.account_id):
+            raise StoreConflict("Reconecte a conta de destino para aprovar este Reel.")
+        verify_media(store.media(reel_id), row)
+        store.save_draft(reel_id, int(time.time()), body.values(), approve=True)
+        return _public_reel(store.reel(reel_id))
+    except (InstagramError, StoreConflict, KeyError, OSError) as error:
+        raise _problem(error) from None
+
+
+@router.get("/reels/{reel_id}/preview", response_class=FileResponse)
+def preview(reel_id: str) -> FileResponse:
+    _valid_reel(reel_id)
+    store = local_store()
+    try:
+        store.reel(reel_id)
+    except KeyError as error:
+        raise _problem(error) from None
+    path = store.media(reel_id)
+    if not path.is_file():
+        raise HTTPException(410, "O arquivo da prévia não está mais disponível.")
+    return FileResponse(path, media_type="video/mp4", headers=PRIVATE)
+
+
+@router.get("/reels/{reel_id}/events")
+def events(reel_id: str, response: Response) -> list[dict]:
+    _valid_reel(reel_id)
+    response.headers.update(PRIVATE)
+    try:
+        return local_store().events(reel_id)
+    except KeyError as error:
+        raise _problem(error) from None
+
+
+@router.post("/reels/{reel_id}/cancel", status_code=204)
+def cancel(reel_id: str) -> Response:
+    _valid_reel(reel_id)
+    try:
+        local_store().cancel(reel_id, int(time.time()))
+    except (StoreConflict, KeyError) as error:
+        raise _problem(error) from None
+    return Response(status_code=204, headers=PRIVATE)
+
+
+@router.post("/reels/{reel_id}/reopen", status_code=204)
+def reopen(reel_id: str) -> Response:
+    _valid_reel(reel_id)
+    try:
+        local_store().reopen(reel_id, int(time.time()))
+    except (StoreConflict, KeyError) as error:
+        raise _problem(error) from None
+    return Response(status_code=204, headers=PRIVATE)
+
+
+@router.delete("/reels/{reel_id}", status_code=204)
+def delete_draft(reel_id: str) -> Response:
+    _valid_reel(reel_id)
+    try:
+        local_store().delete_draft(reel_id)
+    except (StoreConflict, KeyError, OSError) as error:
+        raise _problem(error) from None
+    return Response(status_code=204, headers=PRIVATE)
+
+
+@router.post("/reels/{reel_id}/check")
+def check_publication(reel_id: str, response: Response) -> dict:
+    _valid_reel(reel_id)
+    config = _config()
+    response.headers.update(PRIVATE)
+    store = local_store()
+    try:
+        row = store.reel(reel_id)
+        if row["status"] != "uncertain" or not row["container_id"]:
+            raise StoreConflict("Este Reel não precisa de verificação.")
+        account = store.account(row["account_id"])
+        credentials = Vault(store.home, config.app_id).get(account["id"])
+        if not account["connected"] or not credentials:
+            raise StoreConflict("Reconecte a conta para verificar o Reel.")
+        with http_client() as http:
+            state = MetaClient(config, http).status(row["container_id"], credentials.page)
+        if state in {"PUBLISHED", "EXPIRED", "ERROR"}:
+            store.mark_reconciled(reel_id, int(time.time()), published=state == "PUBLISHED")
+        return _public_reel(store.reel(reel_id))
+    except (InstagramError, StoreConflict, KeyError) as error:
+        raise _problem(error) from None
