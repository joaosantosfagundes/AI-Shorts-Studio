new file mode 100644
--- /dev/null
+++ b/frontend/src/instagram.ts
@@ -0,0 +1,104 @@
+import { request } from './api'
+
+export interface InstagramStatus {
+  configured: boolean
+  problem: string | null
+  publishing_enabled: boolean
+  login_origin: string | null
+}
+
+export interface AccountOption {
+  id: string
+  username: string
+  page_name: string
+}
+
+export interface InstagramAccount extends AccountOption {
+  connected: number
+  auth_needed: number
+  user_expires_at: number | null
+}
+
+export interface ReelExport {
+  id: string
+  title: string
+  size_bytes: number
+  created_at: string
+}
+
+export const REEL_STATUS = {
+  draft: 'Rascunho',
+  queued: 'Agendado',
+  sending: 'Enviando',
+  waiting: 'Processando na Meta',
+  retry: 'Nova tentativa',
+  published: 'Publicado',
+  failed: 'Falhou',
+  late: 'Horário perdido',
+  uncertain: 'Verificar na Meta',
+  cancelled: 'Cancelado',
+}
+
+type ReelStatus = keyof typeof REEL_STATUS
+
+export interface Reel {
+  id: string
+  export_id: string
+  title: string
+  account_id: string | null
+  caption: string
+  hashtags: string
+  scheduled_at: number | null
+  approved_at: number | null
+  status: ReelStatus
+  next_at: number | null
+  media_id: string | null
+  detail: string
+  can_cancel: boolean
+}
+
+interface ReelEdit {
+  account_id: string | null
+  caption: string
+  hashtags: string
+  scheduled_at: string | null
+}
+
+export interface ReelEvent {
+  at: number
+  status: ReelStatus
+  detail: string
+}
+
+const prefix = '/api/instagram'
+const read = <T>(path: string) => request<T>(prefix + path)
+const write = <T>(path: string, method: string, data?: unknown) =>
+  request<T>(prefix + path, {
+    method,
+    headers: { 'X-Studio-Local': '1' },
+    body: data === undefined ? undefined : JSON.stringify(data),
+  })
+
+export const instagram = {
+  status: () => read<InstagramStatus>('/status'),
+  accounts: () => read<InstagramAccount[]>('/accounts'),
+  exports: (preferred: string) => read<ReelExport[]>(`/exports?preferred=${encodeURIComponent(preferred)}`),
+  startLogin: () => write<{ url: string }>('/oauth/start', 'POST'),
+  loginAccounts: () => read<AccountOption[]>('/oauth/accounts'),
+  linkAccounts: (ids: string[]) => write<void>('/oauth/accounts', 'POST', { ids }),
+  renew: (id: string) => write<void>(`/accounts/${id}/renew`, 'POST'),
+  disconnect: (id: string) => write<void>(`/accounts/${id}`, 'DELETE'),
+  reels: (view: 'drafts' | 'queue' | 'history', offset: number, account = '') =>
+    read<Reel[]>(`/reels?view=${view}&offset=${offset}${account ? `&account=${encodeURIComponent(account)}` : ''}`),
+  draft: (exportId: string) => write<Reel>('/reels', 'POST', { export_id: exportId }),
+  save: (id: string, data: ReelEdit) => write<Reel>(`/reels/${id}`, 'PUT', data),
+  approve: (id: string, data: ReelEdit, checks: {
+    reviewed: boolean
+    rights_confirmed: boolean
+    authorize_publication: boolean
+  }) => write<Reel>(`/reels/${id}/approve`, 'POST', { ...data, ...checks }),
+  action: (id: string, action: 'cancel' | 'check' | 'reopen') => write<void>(`/reels/${id}/${action}`, 'POST'),
+  deleteDraft: (id: string) => write<void>(`/reels/${id}`, 'DELETE'),
+  preview: (id: string) => `${prefix}/reels/${id}/preview`,
+  events: (id: string) => read<ReelEvent[]>(`/reels/${id}/events`),
+}
