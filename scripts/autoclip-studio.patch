+
+    def mark_reconciled(self, reel_id: str, now: int, *, published: bool) -> bool:
+        with self.connect(write=True) as conn:
+            row = self._get(conn, "reels", reel_id)
+            if row["status"] != "uncertain":
+                return False
+            status = "published" if published else "failed"
+            detail = (
+                "Publicação confirmada na Meta."
+                if published
+                else "A Meta confirmou que este envio não foi publicado."
+            )
+            self._transition(conn, reel_id, now, status, detail, publish_started=int(published))
+            return True
+
+    def claim(self, now: int) -> sqlite3.Row | None:
+        with self.connect(write=True) as conn:
+            row = conn.execute(
+                """SELECT id FROM reels WHERE approved_at IS NOT NULL AND rights_confirmed=1
+                   AND ((status IN ('queued','waiting','retry') AND next_at<=?)
+                        OR (status='sending' AND lease_until<=?))
+                   AND NOT EXISTS (
+                       SELECT 1 FROM reels AS running
+                       WHERE running.status='sending' AND running.lease_until>?
+                   )
+                   ORDER BY next_at, created_at LIMIT 1""",
+                (now, now, now),
+            ).fetchone()
+            if row is None:
+                return None
+            self._write(
+                conn,
+                row["id"],
+                status="sending",
+                updated_at=now,
+                lease_token=new_id(),
+                lease_until=now + 900,
+            )
+            return self._get(conn, "reels", row["id"])
+
+    def checkpoint(self, row: sqlite3.Row, now: int, **values: object) -> sqlite3.Row:
+        with self.connect(write=True) as conn:
+            self._assert_claim(conn, row)
+            self._write(conn, row["id"], updated_at=now, **values)
+            return self._get(conn, "reels", row["id"])
+
+    def finish(
+        self, row: sqlite3.Row, now: int, status: str, detail: str, **values: object
+    ) -> None:
+        with self.connect(write=True) as conn:
+            self._assert_claim(conn, row)
