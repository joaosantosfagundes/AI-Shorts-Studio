@@ -0,0 +1,444 @@
+"""Durable local publication queue. Tokens belong only in the Windows vault."""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import sqlite3
+from collections.abc import Iterator
+from contextlib import closing, contextmanager
+from dataclasses import dataclass, field
+from functools import lru_cache
+from pathlib import Path
+
+from .. import db, paths
+from ..db.models import new_id
+from .meta import AccountGrant, InstagramError, UserToken
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS accounts (
+    id TEXT PRIMARY KEY, page_id TEXT NOT NULL, username TEXT NOT NULL, page_name TEXT NOT NULL,
+    connected INTEGER NOT NULL, auth_needed INTEGER NOT NULL DEFAULT 0,
+    user_expires_at INTEGER
+);
+CREATE TABLE IF NOT EXISTS oauth_states (digest TEXT PRIMARY KEY, expires INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS reels (
+    id TEXT PRIMARY KEY,
+    export_id TEXT NOT NULL, title TEXT NOT NULL, sha256 TEXT NOT NULL,
+    account_id TEXT REFERENCES accounts(id), caption TEXT NOT NULL DEFAULT '',
+    hashtags TEXT NOT NULL DEFAULT '', scheduled_at INTEGER,
+    approved_at INTEGER, rights_confirmed INTEGER NOT NULL DEFAULT 0,
+    status TEXT NOT NULL DEFAULT 'draft',
+    created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
+    next_at INTEGER, lease_until INTEGER, lease_token TEXT,
+    container_id TEXT, uploaded INTEGER NOT NULL DEFAULT 0,
+    polls INTEGER NOT NULL DEFAULT 0, failures INTEGER NOT NULL DEFAULT 0,
+    refreshed INTEGER NOT NULL DEFAULT 0, publish_started INTEGER NOT NULL DEFAULT 0,
+    media_id TEXT, detail TEXT NOT NULL DEFAULT '',
+    CHECK (status IN ('draft', 'queued', 'sending', 'waiting', 'retry', 'published',
+                      'failed', 'late', 'uncertain', 'cancelled')),
+    CHECK (status = 'draft' OR (approved_at IS NOT NULL AND rights_confirmed = 1
+                                  AND account_id IS NOT NULL AND scheduled_at IS NOT NULL))
+);
+CREATE INDEX IF NOT EXISTS reels_due ON reels(status, next_at);
+CREATE TABLE IF NOT EXISTS events (
+    id INTEGER PRIMARY KEY, reel_id TEXT NOT NULL REFERENCES reels(id) ON DELETE CASCADE,
+    at INTEGER NOT NULL, status TEXT NOT NULL, detail TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS events_by_reel ON events(reel_id, id);
+"""
+
+log = logging.getLogger(__name__)
+
+
+class StoreConflict(RuntimeError):
+    pass
+
+
+@dataclass(frozen=True)
+class Credentials:
+    page: str = field(repr=False)
+    user: str = field(repr=False)
+
+
+class Vault:
+    """Only Credential Manager is supported. There is no plaintext backend."""
+
+    def __init__(self, home: Path, app_id: str) -> None:
+        self.service = (
+            "AI Shorts Studio Instagram "
+            + app_id
+            + " "
+            + hashlib.sha256(str(home.resolve()).casefold().encode()).hexdigest()[:20]
+        )
+
+    @staticmethod
+    def backend():
+        try:
+            from keyring.backends.Windows import WinVaultKeyring
+
+            if WinVaultKeyring.priority > 0:
+                backend = WinVaultKeyring()
+                backend.persist = "local machine"
+                return backend
+        except (ImportError, RuntimeError):
+            pass
+        raise InstagramError("O Gerenciador de Credenciais do Windows está indisponível.")
+
+    def get(self, account: str) -> Credentials | None:
+        try:
+            backend = self.backend()
+            page = backend.get_password(f"{self.service} {account} página", account)
+            user = backend.get_password(f"{self.service} {account} usuário", account)
+            return Credentials(page, user) if page and user else None
+        except Exception:
+            raise InstagramError(
+                "Não foi possível ler o cofre de credenciais do Windows."
+            ) from None
+
+    def put(self, account: str, credentials: Credentials) -> None:
+        try:
+            backend = self.backend()
+            backend.set_password(f"{self.service} {account} página", account, credentials.page)
+            backend.set_password(f"{self.service} {account} usuário", account, credentials.user)
+        except Exception:
+            raise InstagramError(
+                "Não foi possível gravar no cofre de credenciais do Windows."
+            ) from None
+
+    def delete(self, account: str) -> None:
+        try:
+            backend = self.backend()
+            for suffix in ("página", "usuário"):
+                target = f"{self.service} {account} {suffix}"
+                if backend.get_password(target, account) is not None:
+                    backend.delete_password(target, account)
+        except Exception:
+            raise InstagramError(
+                "Não foi possível remover os tokens do cofre do Windows."
+            ) from None
+
+
+class Store:
+    def __init__(self, home: Path) -> None:
+        self.home = home
+        self.filename = home / "publicacoes.sqlite3"
+        with self.connect() as conn:
+            conn.executescript(SCHEMA)
+
+    @contextmanager
+    def connect(self, *, write: bool = False) -> Iterator[sqlite3.Connection]:
+        with closing(db.connect(self.filename)) as conn, conn:
+            # The pre-publish marker must survive sudden shutdown.
+            conn.execute("PRAGMA synchronous = FULL")
+            if write:
+                conn.execute("BEGIN IMMEDIATE")
+            yield conn
+
+    def media(self, reel_id: str) -> Path:
+        return self.home / "instagram" / "media" / f"{reel_id}.mp4"
+
+    def start_oauth(self, digest: str, now: int) -> None:
+        with self.connect(write=True) as conn:
+            conn.execute("DELETE FROM oauth_states WHERE expires <= ?", (now,))
+            conn.execute("INSERT INTO oauth_states VALUES (?, ?)", (digest, now + 600))
+
+    def consume_oauth(self, digest: str, now: int) -> bool:
+        with self.connect(write=True) as conn:
+            return (
+                conn.execute(
+                    "DELETE FROM oauth_states WHERE digest = ? AND expires > ?", (digest, now)
+                ).rowcount
+                == 1
+            )
+
+    def accounts(self) -> list[dict]:
+        with self.connect() as conn:
+            return [
+                dict(row)
+                for row in conn.execute("SELECT * FROM accounts ORDER BY connected DESC, username")
+            ]
+
+    def account(self, account: str) -> sqlite3.Row:
+        with self.connect() as conn:
+            return self._get(conn, "accounts", account)
+
+    def connect_accounts(self, grants: list[AccountGrant], user: UserToken, vault: Vault) -> None:
+        replaced: dict[str, Credentials | None] = {}
+        try:
+            with self.connect(write=True) as conn:
+                active = {
+                    row[0] for row in conn.execute("SELECT id FROM accounts WHERE connected = 1")
+                }
+                if len(active.union(grant.id for grant in grants)) > 2:
+                    raise StoreConflict(
+                        "O estúdio comporta duas contas. Selecione até duas Páginas na Meta."
+                    )
+                for grant in grants:
+                    replaced[grant.id] = vault.get(grant.id)
+                    vault.put(grant.id, Credentials(grant.page_token, user.value))
+                    conn.execute(
+                        """INSERT INTO accounts VALUES (?, ?, ?, ?, 1, 0, ?)
+                           ON CONFLICT(id) DO UPDATE SET page_id=excluded.page_id,
+                           username=excluded.username, page_name=excluded.page_name,
+                           connected=1, auth_needed=0, user_expires_at=excluded.user_expires_at""",
+                        (grant.id, grant.page_id, grant.username, grant.page_name, user.expires_at),
+                    )
+        except Exception:
+            for account, previous in replaced.items():
+                try:
+                    if previous is None:
+                        vault.delete(account)
+                    else:
+                        vault.put(account, previous)
+                except InstagramError:
+                    log.warning("Foi necessário interromper a atualização do cofre do Instagram.")
+            raise
+
+    def auth_needed(self, account: str) -> None:
+        with self.connect(write=True) as conn:
+            conn.execute("UPDATE accounts SET auth_needed = 1 WHERE id = ?", (account,))
+
+    def disconnect(self, account: str, vault: Vault, now: int) -> None:
+        with self.connect(write=True) as conn:
+            self._get(conn, "accounts", account)
+            sending = conn.execute(
+                "SELECT 1 FROM reels WHERE account_id=? AND status='sending' AND lease_until>?",
+                (account, now),
+            ).fetchone()
+            if sending:
+                raise StoreConflict("Aguarde a tentativa em andamento para desconectar a conta.")
+            conn.execute("UPDATE accounts SET connected=0, auth_needed=0 WHERE id=?", (account,))
+            rows = conn.execute(
+                """SELECT id, publish_started FROM reels
+                   WHERE account_id=? AND status IN ('queued','sending','waiting','retry')""",
+                (account,),
+            )
+            for row in rows:
+                self._transition(
+                    conn,
+                    row["id"],
+                    now,
