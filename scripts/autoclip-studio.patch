+                      void perform(async () => {
+                        await instagram.deleteDraft(reel.id)
+                        if (editor?.id === reel.id) setEditor(null)
+                      }, 'Rascunho excluído.')
+                    }
+                  }}>Excluir</button>
+                </>
+              )}
+            />
+            {page('drafts', drafts.length)}
+          </div>
+        </section>
+
+        <section className="panel p-4 sm:p-6">
+          <h2 className="panel-title">Filas de publicação</h2>
+          <p className="mt-2 text-sm text-ink-500">Horários no fuso deste navegador. Agendamentos com mais de 30 minutos de atraso exigem nova aprovação.</p>
+          <label className="mt-4 block max-w-sm text-sm font-semibold">
+            Filtrar por conta
+            <select className="field mt-1" value={filter} onChange={(e) => {
+              setFilter(e.target.value)
+              setOffsets((old) => ({ ...old, queue: 0, history: 0 }))
+            }}>
+              <option value="">Todas as contas</option>
+              {accounts.map((account) => <option key={account.id} value={account.id}>@{account.username}</option>)}
+            </select>
+          </label>
+          <div className="mt-4">
+            <ReelRows reels={active}
+              accountName={accountName} empty="Nenhum Reel nesta fila." onDetails={openDetails} busy={busy}
+              renderActions={(reel) => reel.can_cancel ? (
+                <button className="btn btn-quiet" disabled={busy} onClick={() => void runAction(reel, 'cancel')}>Cancelar</button>
+              ) : null}
+            />
+            {page('queue', active.length)}
+          </div>
+        </section>
+
+        <section className="panel p-4 sm:p-6">
+          <h2 className="panel-title">Histórico de publicações</h2>
+          <div className="mt-4">
+            <ReelRows reels={history}
+              accountName={accountName} empty="Ainda não há publicações no histórico." onDetails={openDetails} busy={busy}
+              renderActions={(reel) => reel.status === 'uncertain' ? (
+                <button className="btn btn-ghost" disabled={busy || !status?.configured} onClick={() => void runAction(reel, 'check')}>Verificar na Meta</button>
+              ) : ['failed', 'late', 'cancelled'].includes(reel.status) ? (
+                <button className="btn btn-ghost" disabled={busy} onClick={() => void runAction(reel, 'reopen')}>Reabrir rascunho</button>
+              ) : null}
+            />
+            {page('history', history.length)}
+          </div>
+        </section>
+
+        {details && (
+          <section className="panel p-4 sm:p-6" aria-label="Detalhes da publicação">
+            <div className="flex flex-wrap items-center justify-between gap-3">
+              <h2 className="panel-title">{details.reel.title}</h2>
+              <button className="btn btn-quiet" onClick={() => setDetails(null)}>Fechar detalhes</button>
+            </div>
+            <p className="mt-2 break-words text-sm text-ink-500">{details.reel.caption} {details.reel.hashtags}</p>
+            {details.reel.media_id && <p className="mt-2 text-sm">ID no Instagram · {details.reel.media_id}</p>}
+            <ol className="mt-4 space-y-2">
+              {details.events.map((event, index) => (
+                <li key={index} className="border-b border-ink-800 py-2 text-sm">
+                  <span className="font-semibold">{REEL_STATUS[event.status]}</span>
+                  <span className="ml-2 text-xs text-ink-500">{date(event.at)}</span>
+                  <p className="mt-1 text-ink-500">{event.detail}</p>
+                </li>
+              ))}
+            </ol>
+          </section>
+        )}
+      </div>
+    </div>
+  )
+}
+
+function AccountPicker({ choices, linked, busy, onConfirm }: {
+  choices: AccountOption[]; linked: InstagramAccount[]; busy: boolean; onConfirm: (ids: string[]) => void
+}) {
+  const [selected, setSelected] = useState<string[]>([])
+  const capacity = new Set([...linked.map(({ id }) => id), ...selected]).size
+  if (!choices.length) return null
+  return (
+    <fieldset className="mt-4 rounded-lg border border-ink-800 p-4">
+      <legend className="px-2 text-sm font-semibold">Escolha as contas autorizadas na Meta</legend>
+      <ul className="space-y-2">
+        {choices.map((choice) => {
+          const on = selected.includes(choice.id)
+          return (
+            <li key={choice.id}>
+              <label className="flex items-center gap-2 text-sm">
+                <input type="checkbox" className="accent-sodium-500" checked={on} disabled={busy || (!on && capacity >= 2 && !linked.some((item) => item.id === choice.id))}
+                  onChange={(e) => setSelected(e.target.checked ? [...selected, choice.id] : selected.filter((id) => id !== choice.id))} />
+                <span>@{choice.username} <span className="text-ink-500">· {choice.page_name}</span></span>
+              </label>
+            </li>
+          )
+        })}
+      </ul>
+      <button className="btn btn-primary mt-4" disabled={busy || !selected.length} onClick={() => onConfirm(selected)}>Conectar contas selecionadas</button>
+    </fieldset>
+  )
+}
+
+type Edit = Parameters<typeof instagram.save>[1]
+type Checks = Parameters<typeof instagram.approve>[2]
+
+function DraftEditor({ draft, accounts, configured, busy, onClose, onSave }: {
+  draft: Reel; accounts: InstagramAccount[]; configured: boolean; busy: boolean
+  onClose: () => void; onSave: (data: Edit, checks?: Checks) => void
+}) {
+  const [account, setAccount] = useState(draft.account_id ?? '')
+  const [caption, setCaption] = useState(draft.caption)
+  const [hashtags, setHashtags] = useState(draft.hashtags)
+  const [scheduled, setScheduled] = useState(toInputDate(draft.scheduled_at))
+  const [reviewed, setReviewed] = useState(false)
+  const [rights, setRights] = useState(false)
+  const [authorized, setAuthorized] = useState(false)
+  const [previewReady, setPreviewReady] = useState(false)
+  const [incompatible, setIncompatible] = useState(false)
+  const canApprove = configured && accounts.some((item) => item.id === account)
+    && !!scheduled && new Date(scheduled).getTime() > Date.now() && previewReady
+    && reviewed && rights && authorized && !incompatible
+  function data(): Edit {
+    return { account_id: account || null, caption, hashtags, scheduled_at: scheduled ? new Date(scheduled).toISOString() : null }
+  }
+  return (
+    <section className="panel p-4 sm:p-6" aria-labelledby="revisar-reel">
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <h2 id="revisar-reel" className="panel-title">Revisar Reel</h2>
+        <button className="btn btn-quiet" onClick={onClose}>Fechar prévia</button>
+      </div>
+      <div className="mt-4 grid items-start gap-5 md:grid-cols-[minmax(0,17rem)_minmax(0,1fr)]">
+        <div>
+          <video className="preview-stage aspect-[9/16] max-h-[32rem] w-full rounded-lg object-contain" aria-label={`Prévia de ${draft.title}`}
+            onLoadedMetadata={() => setPreviewReady(true)} onError={() => setIncompatible(true)}
+            src={instagram.preview(draft.id)} controls playsInline preload="metadata" />
+          <p className="mt-2 text-sm font-semibold">{draft.title}</p>
+          {incompatible && <p className="mt-2 text-sm text-signal-bad">A prévia não pôde ser reproduzida. Prepare o Reel novamente.</p>}
+        </div>
+        <form className="grid gap-4" onSubmit={(event) => {
+          event.preventDefault()
+          if (canApprove) onSave(data(), { reviewed, rights_confirmed: rights, authorize_publication: authorized })
+        }}>
+          <label className="text-sm font-semibold">
+            Conta de destino
+            <select className="field mt-1" value={account} onChange={(e) => { setAccount(e.target.value); setAuthorized(false) }}>
+              <option value="">Selecione uma conta</option>
+              {!!account && !accounts.some((item) => item.id === account) && <option value={account} disabled>Conta indisponível</option>}
+              {accounts.map((item) => <option key={item.id} value={item.id}>@{item.username}</option>)}
+            </select>
+          </label>
+          <label className="text-sm font-semibold">
+            Legenda
+            <textarea className="field mt-1 min-h-24" maxLength={2200} value={caption}
+              onChange={(e) => { setCaption(e.target.value); setAuthorized(false) }} />
+          </label>
+          <label className="text-sm font-semibold">
+            Hashtags
+            <input className="field mt-1" placeholder="#games #melhoresmomentos" maxLength={2200} value={hashtags}
+              onChange={(e) => { setHashtags(e.target.value); setAuthorized(false) }} />
+          </label>
+          <label className="text-sm font-semibold">
+            Data e hora local
+            <input className="field mt-1" type="datetime-local" value={scheduled}
+              onChange={(e) => { setScheduled(e.target.value); setAuthorized(false) }} />
+          </label>
+          <fieldset className="space-y-3 border-t border-ink-800 pt-4 text-sm">
+            <legend className="sr-only">Confirmações obrigatórias da publicação</legend>
+            <label className="flex items-start gap-2"><input type="checkbox" className="mt-1 accent-sodium-500" checked={reviewed} disabled={!previewReady || incompatible} onChange={(e) => setReviewed(e.target.checked)} /> Revisei a prévia do Reel.</label>
+            <label className="flex items-start gap-2"><input type="checkbox" className="mt-1 accent-sodium-500" checked={rights} onChange={(e) => setRights(e.target.checked)} /> Tenho os direitos ou a autorização necessária para publicar o vídeo e o áudio nesta conta.</label>
+            <label className="flex items-start gap-2"><input type="checkbox" className="mt-1 accent-sodium-500" checked={authorized} onChange={(e) => setAuthorized(e.target.checked)} /> Autorizo a publicação deste Reel na conta e no horário escolhidos.</label>
+          </fieldset>
+          <div className="flex flex-wrap gap-2">
+            <button className="btn btn-ghost" disabled={busy} type="button" onClick={() => onSave(data())}>Salvar rascunho</button>
+            <button className="btn btn-primary" disabled={busy || !canApprove} type="submit">Aprovar e agendar</button>
+          </div>
+        </form>
+      </div>
+    </section>
+  )
+}
+
+function ReelRows({ reels, accountName, empty, busy, onDetails, renderActions }: {
+  reels: Reel[]; accountName: (id: string | null) => string; empty: string; busy: boolean
+  onDetails: (reel: Reel) => void; renderActions: (reel: Reel) => React.ReactNode
+}) {
+  if (!reels.length) return <p className="text-sm text-ink-500">{empty}</p>
+  return (
+    <ul className="space-y-2">
+      {reels.map((reel) => (
+        <li key={reel.id} className="flex flex-wrap items-start justify-between gap-3 rounded-lg border border-ink-800 p-3">
+          <div className="min-w-0">
+            <span className="status-pill">{REEL_STATUS[reel.status]}</span>
+            <p className="mt-1 break-words text-sm font-semibold">{reel.title}</p>
+            <p className="mt-1 text-xs text-ink-500">{accountName(reel.account_id)} · {date(reel.scheduled_at)}</p>
+            {reel.detail && <p className="mt-1 max-w-lg text-xs text-ink-500">{reel.detail}</p>}
+          </div>
+          <div className="flex flex-wrap items-center gap-1">
+            {reel.status !== 'draft' && <button className="btn btn-quiet" disabled={busy} onClick={() => onDetails(reel)}>Detalhes</button>}
+            {renderActions(reel)}
+          </div>
+        </li>
+      ))}
+    </ul>
+  )
+}
